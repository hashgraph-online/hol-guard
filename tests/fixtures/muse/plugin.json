{
  "schemaVersion": 1,
  "name": "example-plugin",
  "displayName": "Example Plugin",
  "version": "0.1.0",
  "description": "Example Muse plugin.",
  "compat": {"source": "native", "manifestDir": ".muse-plugin"},
  "capabilities": {
    "skills": [],
    "commands": [],
