        "deprecated": false,
        "description": "Identifies `batterycontrol limit set`, which installs a daemon-owned charge-limit policy that changes when the battery charges and pauses until it is removed.",
        "example_command": "batterycontrol limit set 80",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
        "introduced_version": "3.6.1",
        "label": "Charge limit change",
        "permission_id": "command.batterycontrol.permission.limit-set",
        "replacement_permission_id": null,
        "risk_tier": "medium",
        "safer_guidance": [
          "Run `batterycontrol status` and `batterycontrol limit status` to inspect the current policy before changing it.",
          "Confirm the limit and resume values are intentional before approving; the daemon re-applies the policy across reboots and wake."
        ],
        "typed_capabilities": []
      },
      {
        "action_classes": [
          "batterycontrol charging policy command"
        ],
        "baseline_floor": "review",
        "configurable": true,
