{
  "schemaVersion": "guard.mcp-server-contribution.v1",
  "id": "mcp.krusch-stack",
  "version": "1.3.1",
  "name": "KruschStack Unified Control Plane MCP",
  "description": "Unified local SQLite control plane MCP server (kruschdev/krusch-stack v1.3.1) for memory, Git AST graphs, OS page trees, UI templates, Turn-0 grounding, sealed bricks, and 2PC diff staging. Read-only inspections (including krusch_context_health: read-only SELECT and file-hash checks, zero DB writes) inherit policy; krusch_tool_call is blocked so deferred calls cannot bypass per-tool rules; writes, embeddings (krusch_context_retrieve), sandboxes, and 2PC require review. Off until you turn it on.",
  "trustClass": "external",
  "activation": "opt-in",
  "publisher": {
    "id": "io.github.kruschdev",
    "displayName": "Krusch (@kruschdev)",
    "url": "https://github.com/kruschdev/krusch-stack"
