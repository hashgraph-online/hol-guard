        "safe_variants": [
          {
            "variant_id": "dry-run",
            "title": "AgentBurp project preview",
            "matcher": {
              "op": "executable-path-set.v1",
              "config": {
                "executables": [
                  "agentburp",
                  "agentburp.cmd",
                  "agentburp.exe"
                ],
                "interspersed_options_with_values": [
                  "--project",
                  "-p"
