            "facts": {
              "class": "update",
              "object": {
                "state": "known",
                "value": "record"
              },
              "scope": {
                "state": "known",
                "value": "single"
              },
              "reversibility": {
                "state": "known",
                "value": "reversible"
              },
              "record_count": {
                "state": "known",
                "value": 1
              }
            },
            "decisions": {
              "balanced": "allow",
              "relaxed": "allow",
              "strict": "review"
            }
          }
        },
        {
