{
  "build": {
    "base": "packaged",
    "mcp_sources": [],
    "schema": "guard.command-extension-build.v1",
    "sources": [
      {
        "extension": {
          "action_classes": [
            "x402shield live payment execution command",
            "x402shield external signer service command",
            "x402shield authorization issuer service command",
            "x402shield gateway database migration command"
          ],
          "aliases": [],
          "conflicts": [],
          "dependencies": [],
          "description": "Reviews x402Shield commands that can directly affect authorization, signing, migration, or live payment execution. Payment-intent binding stays enforced by x402Shield itself; this descriptor only classifies each invocation.",
          "ecosystem_ids": [],
          "executables": [
            "x402shield-e2e-buyer-runner",
            "x402shield-external-signer",
            "x402shield-authorization-issuer",
            "x402shield-gateway"
          ],
          "extension_id": "command.x402shield",
          "name": "x402Shield command protection",
          "permissions": [
            {
              "action_classes": [
                "x402shield live payment execution command"
              ],
              "baseline_floor": "review",
              "configurable": true,
              "conflicts": [],
              "default_enabled": true,
              "dependencies": [],
              "deprecated": false,
              "description": "Identifies `x402shield-e2e-buyer-runner` live-run, live, a2a-x402-live, and a2a-live, which sign and submit real test-network payments from configured wallet credentials.",
              "example_command": "x402shield-e2e-buyer-runner live-run",
              "implementation_version": "1.0.0",
              "implied_permissions": [],
              "introduced_version": "1.0.0",
              "label": "x402Shield live payment execution",
              "permission_id": "command.x402shield.permission.live-payment",
              "risk_tier": "critical",
              "safer_guidance": [
                "Run config-check, dry-run, or preflight first; they do not submit a payment.",
                "Confirm the configured network, recipient, and funding wallet before a live run."
              ],
              "typed_capabilities": []
            },
            {
              "action_classes": [
                "x402shield external signer service command"
              ],
              "baseline_floor": "review",
              "configurable": true,
              "conflicts": [],
              "default_enabled": true,
              "dependencies": [],
              "deprecated": false,
              "description": "Identifies any invocation of `x402shield-external-signer`, the service that verifies permits and signs payments. The command model cannot distinguish its diagnostic flags, so every invocation is reviewed.",
              "example_command": "x402shield-external-signer",
              "implementation_version": "1.0.0",
              "implied_permissions": [],
              "introduced_version": "1.0.0",
              "label": "x402Shield external signer service",
              "permission_id": "command.x402shield.permission.external-signer",
              "risk_tier": "critical",
              "safer_guidance": [
                "Confirm the trusted permit issuers and signer scope in the environment before starting the signer.",
                "Start the signer only in the environment that is meant to hold signing authority."
              ],
              "typed_capabilities": []
            },
            {
              "action_classes": [
                "x402shield authorization issuer service command"
              ],
              "baseline_floor": "review",
              "configurable": true,
              "conflicts": [],
              "default_enabled": true,
              "dependencies": [],
              "deprecated": false,
              "description": "Identifies any invocation of `x402shield-authorization-issuer`, the service that issues signed payment permits. The command model cannot distinguish its diagnostic flags, so every invocation is reviewed.",
              "example_command": "x402shield-authorization-issuer",
              "implementation_version": "1.0.0",
              "implied_permissions": [],
              "introduced_version": "1.0.0",
              "label": "x402Shield authorization issuer service",
              "permission_id": "command.x402shield.permission.authorization-issuer",
              "risk_tier": "critical",
              "safer_guidance": [
                "Confirm the issuer policy version and maximum permit lifetime in the environment before starting the issuer.",
                "Start the issuer only in the environment that is meant to hold permit-issuing authority."
              ],
              "typed_capabilities": []
            },
            {
              "action_classes": [
                "x402shield gateway database migration command"
              ],
              "baseline_floor": "review",
              "configurable": true,
              "conflicts": [],
              "default_enabled": true,
              "dependencies": [],
              "deprecated": false,
              "description": "Identifies `x402shield-gateway migrate`, which applies database migrations to the DATABASE_URL target.",
              "example_command": "x402shield-gateway migrate",
              "implementation_version": "1.0.0",
              "implied_permissions": [],
              "introduced_version": "1.0.0",
              "label": "x402Shield gateway database migration",
              "permission_id": "command.x402shield.permission.gateway-migrate",
              "risk_tier": "high",
              "safer_guidance": [
                "Confirm DATABASE_URL points at the intended database and take a backup before migrating.",
                "Review the pending migrations first."
              ],
              "typed_capabilities": []
            }
          ],
          "project_markers": [],
          "reference_urls": [
            "https://x402shield.dev"
          ],
          "required": false,
          "risk_classes": [
            "financial_transaction",
            "destructive_shell"
          ],
          "rules": [
            {
              "action_classes": [
                "x402shield live payment execution command"
              ],
              "default_mode": "review",
              "description": "Matches `x402shield-e2e-buyer-runner` with the live-run, live, a2a-x402-live, or a2a-live subcommand. Read-only subcommands such as config-check, dry-run, preflight, observe-tx, and verify-evidence are not matched.",
              "matcher": {
                "config": {},
                "matchers": [
                  {
                    "config": {
                      "allow_leading_options": false,
                      "executables": [
                        "x402shield-e2e-buyer-runner",
                        "x402shield-e2e-buyer-runner.cmd",
                        "x402shield-e2e-buyer-runner.exe"
                      ],
                      "fail_secure_unknown_options": true,
                      "subcommands": [
                        "live-run"
                      ]
                    },
                    "op": "executable.v1"
                  },
                  {
                    "config": {
                      "allow_leading_options": false,
                      "executables": [
                        "x402shield-e2e-buyer-runner",
                        "x402shield-e2e-buyer-runner.cmd",
                        "x402shield-e2e-buyer-runner.exe"
                      ],
                      "fail_secure_unknown_options": true,
                      "subcommands": [
                        "live"
                      ]
                    },
                    "op": "executable.v1"
                  },
                  {
                    "config": {
                      "allow_leading_options": false,
                      "executables": [
                        "x402shield-e2e-buyer-runner",
                        "x402shield-e2e-buyer-runner.cmd",
                        "x402shield-e2e-buyer-runner.exe"
                      ],
                      "fail_secure_unknown_options": true,
                      "subcommands": [
                        "a2a-x402-live"
                      ]
                    },
                    "op": "executable.v1"
                  },
                  {
                    "config": {
                      "allow_leading_options": false,
                      "executables": [
                        "x402shield-e2e-buyer-runner",
                        "x402shield-e2e-buyer-runner.cmd",
                        "x402shield-e2e-buyer-runner.exe"
                      ],
                      "fail_secure_unknown_options": true,
                      "subcommands": [
                        "a2a-live"
                      ]
                    },
                    "op": "executable.v1"
                  }
                ],
                "op": "any.v1"
              },
              "permission_id": "command.x402shield.permission.live-payment",
              "risk_classes": [
                "financial_transaction"
              ],
              "rule_id": "command.x402shield.live-payment",
              "rule_version": "1.0.0",
              "safe_variants": [],
              "safer_alternatives": [
                "Use config-check, dry-run, or preflight to inspect the setup without submitting a payment."
              ],
              "severity": "critical",
              "title": "x402Shield live payment execution"
            },
            {
              "action_classes": [
                "x402shield external signer service command"
              ],
              "default_mode": "review",
              "description": "Matches any invocation of `x402shield-external-signer`.",
              "matcher": {
                "config": {
                  "allow_leading_options": false,
                  "executables": [
                    "x402shield-external-signer",
                    "x402shield-external-signer.cmd",
                    "x402shield-external-signer.exe"
                  ],
                  "subcommands": []
                },
                "op": "executable.v1"
              },
              "permission_id": "command.x402shield.permission.external-signer",
              "risk_classes": [
                "financial_transaction"
              ],
              "rule_id": "command.x402shield.external-signer",
              "rule_version": "1.0.0",
              "safe_variants": [],
              "safer_alternatives": [
                "Verify the permit trust configuration before starting the signer."
              ],
              "severity": "critical",
              "title": "x402Shield external signer service"
            },
            {
              "action_classes": [
                "x402shield authorization issuer service command"
              ],
              "default_mode": "review",
              "description": "Matches any invocation of `x402shield-authorization-issuer`.",
              "matcher": {
                "config": {
                  "allow_leading_options": false,
                  "executables": [
                    "x402shield-authorization-issuer",
                    "x402shield-authorization-issuer.cmd",
                    "x402shield-authorization-issuer.exe"
                  ],
                  "subcommands": []
                },
                "op": "executable.v1"
              },
              "permission_id": "command.x402shield.permission.authorization-issuer",
              "risk_classes": [
                "financial_transaction"
              ],
              "rule_id": "command.x402shield.authorization-issuer",
              "rule_version": "1.0.0",
              "safe_variants": [],
              "safer_alternatives": [
                "Verify the issuer policy configuration before starting the issuer."
              ],
              "severity": "critical",
              "title": "x402Shield authorization issuer service"
            },
            {
              "action_classes": [
                "x402shield gateway database migration command"
              ],
              "default_mode": "review",
              "description": "Matches `x402shield-gateway migrate`. `x402shield-gateway run` is not matched.",
              "matcher": {
                "config": {
                  "allow_leading_options": false,
                  "executables": [
                    "x402shield-gateway",
                    "x402shield-gateway.cmd",
                    "x402shield-gateway.exe"
                  ],
                  "fail_secure_unknown_options": true,
                  "subcommands": [
                    "migrate"
                  ]
                },
                "op": "executable.v1"
              },
              "permission_id": "command.x402shield.permission.gateway-migrate",
              "risk_classes": [
                "destructive_shell"
              ],
              "rule_id": "command.x402shield.gateway-migrate",
              "rule_version": "1.0.0",
              "safe_variants": [],
              "safer_alternatives": [
                "Back up the database and confirm DATABASE_URL before migrating."
              ],
              "severity": "high",
              "title": "x402Shield gateway database migration"
            }
          ],
          "safer_alternatives": [
            "Use the read-only diagnostic subcommands before any live payment run."
          ],
          "source": "built-in",
          "version": "1.0.0"
