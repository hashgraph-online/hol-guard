    {"id": "connect-names-provider-and-workspace", "argv": ["accounts", "connect", "slack", "--cloud-workspace", "WS", "--json"], "exit": 3,
     "command": "accounts connect", "context": {"cloud_workspace": "WS", "provider": "slack"}},
    {"id": "connect-requires-cloud-workspace", "argv": ["accounts", "connect", "slack", "--json"], "exit": 2,
