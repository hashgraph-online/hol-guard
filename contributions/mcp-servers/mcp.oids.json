    "serverNames": [
      "oids",
      "oids-mcp"
    ],
    "url": "https://mcp.tryoids.com/mcp"
  },
  "riskClasses": [
    "external-agent-messaging",
    "external-message-egress",
    "external-account-creation",
    "external-content-ingestion",
    "external-shared-state-write"
  ],
