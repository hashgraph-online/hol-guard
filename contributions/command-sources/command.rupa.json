    "description": "Reviews rupa commands that replace or delete local files the caller names: a render with --force, which can replace an existing file of any type, and `rupa verify --out DIR`, which writes and deletes review sheets in a chosen folder. A plain render is not matched, although it replaces an existing .html or .pdf without asking; `rupa --help` and `rupa --version` are read-only.",
    "ecosystem_ids": [],
    "executables": [
      "rupa"
    ],
    "extension_id": "command.rupa",
    "homepage": "https://github.com/VajraSarpa/rupa",
    "icon": {
      "kind": "none"
    },
    "license": "MIT",
    "name": "rupa command protection",
    "permissions": [
      {
        "action_classes": [
          "rupa forced output overwrite command"
        ],
        "baseline_floor": "review",
        "configurable": true,
        "conflicts": [],
        "default_enabled": true,
        "dependencies": [],
        "deprecated": false,
        "description": "Identifies `rupa ... --force`. With --to, -o can name any path. If that file exists and isn't .html or .pdf, rupa refuses (exit 2) unless --force is given, and then replaces it: `rupa --to html --force -o notes.txt in.md` overwrites notes.txt. Covers the installed rupa script and `uv run rupa`, `uvx rupa` and `uv tool run rupa` launches. Known limit: a plain render without --force (`rupa in.md -o out.pdf`) is not matched, although it replaces an existing .html or .pdf at -o without asking; flagging it would review every normal run. `rupa verify` rejects --force (exit 2, nothing written), but a --force there is still matched: Guard compares arguments case-insensitively, and `rupa VERIFY --force ...` renders a file named VERIFY.",
        "example_command": "rupa --to html --force -o notes.txt in.md",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "label": "rupa forced output overwrite",
        "permission_id": "command.rupa.permission.force",
        "replacement_permission_id": null,
        "risk_tier": "high",
        "safer_guidance": [
          "Drop --force and write to a new .html or .pdf path; without --force rupa refuses to replace any other existing file.",
          "Check that -o does not name a file you want to keep before adding --force."
        ],
        "typed_capabilities": []
      },
      {
        "action_classes": [
          "rupa verify sheet write and delete command"
        ],
        "baseline_floor": "review",
        "configurable": true,
        "conflicts": [],
        "default_enabled": true,
        "dependencies": [],
        "deprecated": false,
        "description": "Identifies `rupa verify PDF --out DIR`, which writes verify.json and sheet-p<NNN>-<kind>.png files into a folder the caller picks, replacing files with the same names, and deletes the sheets that the previous verify.json in that folder listed (only names matching sheet-p<digits>-<word>.png). Without --out the sheets go to <PDF>.verify/ beside the PDF and this rule does not match. Covers the installed rupa script and `uv run rupa`, `uvx rupa` and `uv tool run rupa` launches.",
        "example_command": "rupa verify out/report.pdf --out review",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "label": "rupa verify sheets in a chosen folder",
        "permission_id": "command.rupa.permission.verify-out",
        "replacement_permission_id": null,
        "risk_tier": "medium",
        "safer_guidance": [
          "Omit --out; rupa verify then writes its sheets to <PDF>.verify/ beside the PDF.",
          "Point --out at a new, empty folder rather than one that holds other files."
        ],
        "typed_capabilities": []
      }
