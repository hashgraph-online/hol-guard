        ],
        "baseline_floor": "review",
        "configurable": true,
        "conflicts": [],
        "default_enabled": true,
        "dependencies": [],
        "deprecated": false,
        "description": "Identifies `answerloops setup`, which clones the answerLoops repository when not run inside a checkout, writes a .env file with generated secrets, and starts a self-hosted instance with `docker compose -f docker-compose.ghcr.yml up -d` using the published image. With `--with-skills` it also downloads Claude Code skills into ./.claude/skills/. Covers the installed bin and npx, bunx, npm exec, pnpm dlx and yarn dlx launches of @answerloops/agent-sdk.",
        "example_command": "answerloops setup --dir ./answerLoops",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "label": "answerLoops self-hosted setup",
        "permission_id": "command.answerloops.permission.setup",
        "replacement_permission_id": null,
        "risk_tier": "medium",
        "safer_guidance": [
          "Confirm the target directory and that starting Docker containers on this machine is intended before running setup.",
          "Run `answerloops --help` to review what setup will do first."
        ],
        "typed_capabilities": []
      },
      {
        "action_classes": [
          "answerLoops agent skill install command"
        ],
        "baseline_floor": "review",
        "configurable": true,
        "conflicts": [],
        "default_enabled": true,
        "dependencies": [],
        "deprecated": false,
        "description": "Identifies `answerloops skills <name...>`, which downloads the named skill files from the answerLoops GitHub repository's main branch and writes them into ./.claude/skills/<name>/, where a coding agent loads them as instructions in later sessions. Existing files at those paths are overwritten. Covers the installed bin and npx, bunx, npm exec, pnpm dlx and yarn dlx launches of @answerloops/agent-sdk.",
        "example_command": "answerloops skills answerloops-setup answerloops-operate",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "label": "answerLoops agent skill install",
        "permission_id": "command.answerloops.permission.skills",
        "replacement_permission_id": null,
        "risk_tier": "medium",
        "safer_guidance": [
          "Read the skill files under skills/ in the answerLoops repository before installing them into ./.claude/skills/."
        ],
        "typed_capabilities": []
      }
    ],
