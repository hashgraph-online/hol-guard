{
  "schema": "guard.cloud-action-pack.v1",
  "provider": {
    "id": "webflow-mcp",
    "name": "Webflow MCP",
    "publisher": {
      "name": "HOL",
      "verified": true
    }
  },
  "hosts": [
    "mcp.webflow.com"
  ],
  "auth": {
    "mode": "oauth2",
    "scopes": [
      "sites:read",
      "sites:write",
      "cms:read",
      "cms:write",
      "pages:read",
      "pages:write",
      "custom_code:write"
    ]
  },
  "actions": [
    {
      "actionId": "webflow-mcp.ask_webflow_ai",
      "title": "Ask Webflow AI",
      "link": {
        "tool": "ask_webflow_ai"
      },
      "executor": {
        "kind": "remote-mcp",
        "tool": "ask_webflow_ai"
      },
      "arguments": {},
      "openArguments": {
        "maxBytes": 8192
      },
      "facts": {
        "class": "read",
        "object": {
          "const": "record"
        },
        "scope": {
          "const": "query_selected"
        }
      },
      "response": {
        "maxBytes": 262144,
        "fields": [
          {
            "name": "content",
            "value": {
              "from": "content"
            },
            "untrusted": true
          }
        ]
      },
      "safety": {
        "effect": "read",
        "requiredCapabilities": [
          "bounded-output",
          "egress-pinned"
        ],
        "idempotency": "safe-read",
        "scopes": [
          "sites:read",
          "sites:write",
          "cms:read",
          "cms:write",
          "pages:read",
          "pages:write",
          "custom_code:write"
        ],
        "maxItems": 1,
        "minIntervalMs": 500,
        "timeoutMs": 15000
      },
      "fixtures": [
        {
          "name": "calls ask_webflow_ai",
          "kind": "safe",
          "arguments": {
            "message": "How do I add a CMS collection?"
          },
          "expect": {
            "facts": {
              "class": "read",
              "object": {
                "state": "known",
                "value": "record"
              },
              "scope": {
                "state": "known",
                "value": "query_selected"
              }
            },
            "decisions": {
              "balanced": "allow",
              "relaxed": "allow",
              "strict": "allow"
            }
          }
        },
        {
          "name": "refuses an argument name the tool cannot declare",
          "kind": "risky",
          "arguments": {
            "$where": "1"
          },
          "expect": {
            "error": "unknown_argument"
          }
        }
      ]
    },
