{
  "extension": {
    "action_classes": [
      "agi-memory vault rewrite command",
      "agi-memory permanent memory deletion command",
      "agi-memory vault remote initialisation command",
      "agi-memory cold-start seeding command",
      "agi-memory core memory pin command",
      "agi-memory core memory unpin command"
    ],
    "aliases": [],
    "conflicts": [],
    "delegated_protection": null,
    "dependencies": [],
    "description": "Reviews agi-memory commands that rewrite the canonical memory vault, permanently delete a memory across every synced machine, attach a remote that will receive the whole store, bulk-seed it from git history, or change the invariants injected into later sessions. Reads such as recall, log, inspect, blocks and sync status stay unreviewed.",
    "ecosystem_ids": [
      "agi-memory",
      "agent-memory",
      "agi-bootstrap",
      "agent-bootstrap"
    ],
    "executables": [
      "agi-memory",
      "agent-memory",
      "agi-bootstrap",
      "agent-bootstrap"
    ],
    "extension_id": "command.agi-memory",
    "homepage": "https://pypi.org/project/agi-memory/",
    "icon": {
      "kind": "none"
    },
    "license": "MIT",
    "name": "agi-memory command protection",
    "permissions": [
      {
        "action_classes": [
          "agi-memory vault rewrite command"
        ],
        "baseline_floor": "review",
        "configurable": true,
        "conflicts": [],
        "default_enabled": true,
        "dependencies": [],
        "deprecated": false,
        "description": "Identifies `agi-memory sync dedupe`, which rewrites the canonical append-only memory vault in place. It is the only agi-memory operation that rewrites rather than appends, it prunes records it judges redundant, and a similarity key that merges two distinct memories destroys the loser with no undo. Sync invocations carrying unresolved shell expansions are still reviewed through Guard's floor because they cannot prove the dedupe subcommand absent.",
        "example_command": "agi-memory sync dedupe",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "label": "agi-memory vault deduplication",
        "permission_id": "command.agi-memory.permission.sync-dedupe",
        "replacement_permission_id": null,
        "risk_tier": "critical",
        "safer_guidance": [
          "Run agi-memory sync status first to see the vault state that dedupe would rewrite.",
          "Copy ~/.agi-memory/vault (or $AGI_MEMORY_VAULT) before compacting: the vault is the canonical store and the SQLite index is only derived from it.",
          "Expand shell variables and command substitutions before running agi-memory sync."
        ],
        "typed_capabilities": []
      },
      {
        "action_classes": [
          "agi-memory permanent memory deletion command"
        ],
        "baseline_floor": "review",
        "configurable": true,
        "conflicts": [],
        "default_enabled": true,
        "dependencies": [],
        "deprecated": false,
        "description": "Identifies `agi-memory delete <id> --hard`, which permanently removes an observation rather than marking it superseded. The delete cascades into the long-term facts promoted from that observation and appends a vault tombstone, so the removal propagates to every other machine sharing the vault on the next sync. Delete invocations carrying unresolved shell expansions are still reviewed through Guard's floor because they cannot prove --hard absent.",
        "example_command": "agi-memory delete 3 --hard",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "label": "agi-memory permanent memory deletion",
        "permission_id": "command.agi-memory.permission.delete-hard",
        "replacement_permission_id": null,
        "risk_tier": "critical",
        "safer_guidance": [
          "Run agi-memory inspect <id> first to confirm which memory the id refers to.",
          "Omit --hard to soft-delete, which marks the observation superseded and is reversible.",
          "Expand shell variables and command substitutions before running agi-memory delete."
        ],
        "typed_capabilities": []
      },
      {
        "action_classes": [
          "agi-memory vault remote initialisation command"
        ],
        "baseline_floor": "review",
        "configurable": true,
        "conflicts": [],
        "default_enabled": true,
        "dependencies": [],
        "deprecated": false,
        "description": "Identifies `agi-memory sync init`, which turns the local memory vault into a git repository and attaches a remote. Every memory already in the vault is then pushed to that remote on the next sync, so pointing it at the wrong repository publishes the whole store. With --create-private it also creates a new GitHub repository through the gh CLI.",
        "example_command": "agi-memory sync init",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "label": "agi-memory vault remote initialisation",
        "permission_id": "command.agi-memory.permission.sync-init",
        "replacement_permission_id": null,
        "risk_tier": "high",
        "safer_guidance": [
          "Run agi-memory sync status first to see whether a remote is already attached.",
          "Review what the vault already contains before attaching a remote that will receive all of it.",
          "Confirm the remote is private, since memories often quote source code and internal decisions."
        ],
        "typed_capabilities": []
      },
      {
        "action_classes": [
          "agi-memory cold-start seeding command"
        ],
        "baseline_floor": "review",
        "configurable": true,
        "conflicts": [],
        "default_enabled": true,
        "dependencies": [],
        "deprecated": false,
        "description": "Identifies `agi-memory bootstrap` and the standalone `agi-bootstrap` script, which parse git history and README.md and bulk-write the result into the memory store. Run against a store that is not empty, or against the wrong repository, this mixes generated memories into curated ones with no marker separating them afterwards.",
        "example_command": "agi-memory bootstrap",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "label": "agi-memory cold-start memory seeding",
        "permission_id": "command.agi-memory.permission.bootstrap",
        "replacement_permission_id": null,
        "risk_tier": "medium",
        "safer_guidance": [
          "Run agi-memory log first to check whether the store already holds memories for this project.",
          "Pass --repo explicitly so the seeding cannot pick up whichever repository happens to be the cwd.",
          "Seed with a small --max-commits first and inspect the result before a full run."
        ],
        "typed_capabilities": []
      },
      {
        "action_classes": [
          "agi-memory core memory pin command"
        ],
        "baseline_floor": "review",
        "configurable": true,
        "conflicts": [],
        "default_enabled": true,
        "dependencies": [],
        "deprecated": false,
        "description": "Identifies `agi-memory pin`, which writes a core-memory block that is injected into the context of every later session for the project. Pinning under an existing key overwrites that block, replacing an invariant later sessions were relying on.",
        "example_command": "agi-memory pin tls-rule 'TLS v1.3 only'",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "label": "agi-memory core memory pin",
        "permission_id": "command.agi-memory.permission.pin",
        "replacement_permission_id": null,
        "risk_tier": "medium",
        "safer_guidance": [
          "Run agi-memory blocks first to see whether the key already holds a different invariant.",
          "Choose a new key rather than overwriting an existing block."
        ],
        "typed_capabilities": []
      },
      {
        "action_classes": [
          "agi-memory core memory unpin command"
        ],
        "baseline_floor": "review",
        "configurable": true,
        "conflicts": [],
        "default_enabled": true,
        "dependencies": [],
        "deprecated": false,
        "description": "Identifies `agi-memory unpin`, which removes a core-memory block. Later sessions stop receiving the invariant it held, and nothing in a later session reveals that it was ever there.",
        "example_command": "agi-memory unpin tls-rule",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "label": "agi-memory core memory unpin",
        "permission_id": "command.agi-memory.permission.unpin",
        "replacement_permission_id": null,
        "risk_tier": "medium",
        "safer_guidance": [
          "Run agi-memory blocks first to record the content of the block before removing it.",
          "Confirm no project rule still depends on the invariant the block carried."
        ],
        "typed_capabilities": []
      }
    ],
