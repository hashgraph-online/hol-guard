            "safe",
            "risky"
          ]
        },
        "arguments": {
          "type": "object"
        },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "error": {
              "type": "string",
              "pattern": "^[a-z_]{1,64}$"
            },
            "facts": {
              "type": "object"
            },
            "request": {
              "type": "object"
            },
            "response": {
              "type": "string"
            },
            "projection": {},
            "decisions": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "relaxed": {
                  "enum": [
                    "allow",
                    "warn",
                    "review",
                    "require-reapproval",
                    "sandbox-required",
                    "block"
                  ]
                },
                "balanced": {
                  "enum": [
                    "allow",
                    "warn",
                    "review",
                    "require-reapproval",
                    "sandbox-required",
                    "block"
                  ]
                },
                "strict": {
