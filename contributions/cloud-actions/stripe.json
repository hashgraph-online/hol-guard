          "expect": {
            "error": "invalid_argument"
          }
        },
        {
          "name": "refuses an unknown reason",
          "kind": "risky",
          "arguments": {
            "payment_intent": "pi_3PqA1b2C3d4E5f6G",
            "reason": "goodwill"
          },
          "expect": {
            "error": "invalid_argument"
          }
        }
      ]
