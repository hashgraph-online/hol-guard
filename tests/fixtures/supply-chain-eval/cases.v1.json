{
 "schema": "hol-guard.supply-chain-eval-vectors.v1",
 "description": "Language-neutral expectations for resident package supply-chain evaluation on a workspace without Guard Cloud. No Python oracle.",
 "lockfile_parse": [
  {
   "name": "clean_v3",
   "path": "package-lock.json",
   "text": "{\"lockfileVersion\": 3, \"packages\": {\"\": {\"name\": \"a\"}, \"node_modules/react\": {\"version\": \"18.0.0\"}}}",
   "expect": {
    "complete": true,
    "entries": [
     [
      "react",
      "react",
      "18.0.0"
     ]
    ]
   }
  },
  {
   "name": "empty_object",
   "path": "package-lock.json",
   "text": "{}",
   "expect": {
    "complete": true,
    "entries": []
   }
  },
  {
   "name": "syntax_error",
   "path": "package-lock.json",
   "text": "{",
   "expect": {
    "complete": false,
    "error_reason": "syntax_error"
   }
  },
  {
   "name": "duplicate_key",
   "path": "package-lock.json",
   "text": "{\"packages\":{\"a\":{},\"a\":{}}}",
   "expect": {
    "complete": false,
    "error_reason": "duplicate_key"
   }
  },
  {
   "name": "invalid_utf8",
   "path": "package-lock.json",
   "bytes_hex": "fffefd",
   "expect": {
    "complete": false,
    "error_reason": "decode_error"
   }
  },
  {
   "name": "array_root",
   "path": "package-lock.json",
   "text": "[]",
   "expect": {
    "complete": false,
    "error_reason": "unsupported_shape"
   }
  },
  {
   "name": "unsupported_format",
   "path": "notes.lock",
   "text": "{}",
   "expect": {
    "complete": false,
    "error_reason": "unsupported_format"
   }
  },
  {
   "name": "depth_limit",
   "path": "package-lock.json",
   "generate": {
    "prefix": "{\"packages\":",
    "unit": "[",
    "count": 300,
    "closing_unit": "]",
    "suffix": "}"
   },
   "expect": {
    "complete": false,
    "error_reason": "depth_limit_exceeded"
   }
  },
  {
   "name": "byte_limit",
   "path": "package-lock.json",
   "generate": {
    "unit": " ",
    "count": 8388609
   },
   "expect": {
    "complete": false,
    "error_reason": "byte_limit_exceeded"
   }
  },
  {
   "name": "cargo_lock_clean",
   "path": "Cargo.lock",
   "text": "version = 3\n\n[[package]]\nname = \"serde\"\nversion = \"1.0.200\"\n\n[[package]]\nname = \"itoa\"\nversion = \"1.0.11\"\n",
   "expect": {
    "complete": true,
    "entries": [
     [
      "itoa",
      "itoa",
      "1.0.11"
     ],
     [
      "serde",
      "serde",
      "1.0.200"
     ]
    ]
   }
  },
  {
   "name": "uv_lock_clean",
   "path": "uv.lock",
   "text": "version = 1\n\n[[package]]\nname = \"requests\"\nversion = \"2.32.3\"\n",
   "expect": {
    "complete": true,
    "entries": [
     [
      "requests",
      "requests",
      "2.32.3"
     ]
    ]
   }
  },
  {
   "name": "poetry_lock_clean",
   "path": "poetry.lock",
   "text": "[[package]]\nname = \"click\"\nversion = \"8.1.7\"\n\n[metadata]\nlock-version = \"2.0\"\n",
   "expect": {
    "complete": true,
    "entries": [
     [
      "click",
      "click",
      "8.1.7"
     ]
    ]
   }
  },
  {
   "name": "toml_lock_empty",
   "path": "uv.lock",
   "text": "",
   "expect": {
    "complete": true,
    "entries": []
   }
  },
  {
   "name": "cargo_lock_syntax_error",
   "path": "Cargo.lock",
   "text": "[[package]\nname = \"serde\"\n",
   "expect": {
    "complete": false,
    "error_reason": "syntax_error"
   }
  },
  {
   "name": "poetry_lock_duplicate_key",
   "path": "poetry.lock",
   "text": "[[package]]\nname = \"a\"\nname = \"b\"\nversion = \"1\"\n",
   "expect": {
    "complete": false,
    "error_reason": "syntax_error"
   }
  },
  {
   "name": "uv_lock_unsupported_shape",
   "path": "uv.lock",
   "text": "package = \"requests\"\n",
   "expect": {
    "complete": false,
    "error_reason": "unsupported_shape"
   }
  },
  {
   "name": "cargo_lock_invalid_utf8",
   "path": "Cargo.lock",
   "text": "",
   "expect": {
    "complete": false,
    "error_reason": "decode_error"
   },
   "bytes_hex": "fffefd"
  },
  {
   "name": "bun_lock_jsonc_clean",
   "path": "bun.lock",
   "text": "{\n  // comment\n  \"lockfileVersion\": 1,\n  \"packages\": {\n    \"react\": [\"react@18.2.0\", \"\", {}, \"sha512-x\"],\n    \"@types/node\": [\"@types/node@20.1.0\", \"\", {}, \"sha512-y\"], /* trailing */\n  },\n}\n",
   "expect": {
    "complete": true,
    "entries": [
     [
      "@types/node",
      "@types/node",
      "20.1.0"
     ],
     [
      "react",
      "react",
      "18.2.0"
     ]
    ]
   }
  },
  {
   "name": "bun_lock_syntax_error",
   "path": "bun.lock",
   "text": "{\"packages\": ",
   "expect": {
    "complete": false,
    "error_reason": "syntax_error"
   }
  },
  {
   "name": "bun_lock_duplicate_key",
   "path": "bun.lock",
   "text": "{\"packages\": {\"a\": [\"a@1.0.0\"], \"a\": [\"a@2.0.0\"]}}",
   "expect": {
    "complete": false,
    "error_reason": "duplicate_key"
   }
  },
  {
   "name": "bun_lock_unsupported_version",
   "path": "bun.lock",
   "text": "{\"lockfileVersion\": 9, \"packages\": {}}",
   "expect": {
    "complete": false,
    "error_reason": "unsupported_version"
   }
  },
  {
   "name": "bun_lock_array_root",
   "path": "bun.lock",
   "text": "[]",
   "expect": {
    "complete": false,
    "error_reason": "unsupported_shape"
   }
  },
  {
   "name": "bun_lock_bad_package_entry",
   "path": "bun.lock",
   "text": "{\"packages\": {\"a\": \"a@1.0.0\"}}",
   "expect": {
    "complete": false,
    "error_reason": "parse_error"
   }
  },
  {
   "name": "pnpm_lock_clean",
   "path": "pnpm-lock.yaml",
   "text": "lockfileVersion: '9.0'\n\npackages:\n\n  react@18.2.0:\n    resolution: {integrity: sha512-x}\n\nsnapshots:\n\n  react@18.2.0: {}\n",
   "expect": {
    "complete": true,
    "entries": [
     [
      "react",
      "react",
      "18.2.0"
     ]
    ]
   }
  },
  {
   "name": "pnpm_lock_tab_indent",
   "path": "pnpm-lock.yaml",
   "text": "packages:\n\treact@18.2.0:\n",
   "expect": {
    "complete": false,
    "error_reason": "syntax_error"
   }
  },
  {
   "name": "pnpm_lock_missing_colon",
   "path": "pnpm-lock.yaml",
   "text": "packages:\n  react@18.2.0\n",
   "expect": {
    "complete": false,
    "error_reason": "syntax_error"
   }
  },
  {
   "name": "pnpm_lock_unbalanced_flow",
   "path": "pnpm-lock.yaml",
   "text": "packages:\n  react@18.2.0:\n    resolution: {integrity: sha512-x\n",
   "expect": {
    "complete": false,
    "error_reason": "syntax_error"
   }
  },
  {
   "name": "yarn_lock_classic_clean",
   "path": "yarn.lock",
   "text": "# yarn lockfile v1\n\nlodash@^4.17.21:\n  version \"4.17.21\"\n  resolved \"https://registry.yarnpkg.com/lodash/-/lodash-4.17.21.tgz\"\n",
   "expect": {
    "complete": true,
    "entries": [
     [
      "lodash",
      "lodash",
      "4.17.21"
     ]
    ]
   }
  },
  {
   "name": "yarn_lock_berry_clean",
   "path": "yarn.lock",
   "text": "__metadata:\n  version: 8\n\n\"left-pad@npm:^1.3.0\":\n  version: 1.3.0\n  resolution: \"left-pad@npm:1.3.0\"\n",
   "expect": {
    "complete": true,
    "entries": [
     [
      "left-pad",
      "left-pad",
      "1.3.0"
     ]
    ]
   }
  },
  {
   "name": "yarn_lock_unindented_junk",
   "path": "yarn.lock",
   "text": "lodash@^4.17.21:\n  version \"4.17.21\"\ngarbage line\n",
   "expect": {
    "complete": false,
    "error_reason": "syntax_error"
   }
  },
  {
   "name": "yarn_lock_unbalanced_bracket",
   "path": "yarn.lock",
   "text": "lodash@^4.17.21:\n  version \"4.17.21\"\n  deps [\n",
   "expect": {
    "complete": false,
    "error_reason": "syntax_error"
   }
  },
  {
   "name": "bundler_lock_clean",
   "path": "Gemfile.lock",
   "text": "GEM\n  remote: https://rubygems.org/\n  specs:\n    rack (2.2.8)\n    rake (13.1.0)\n\nPLATFORMS\n  ruby\n\nBUNDLED WITH\n   2.5.3\n",
   "expect": {
    "complete": true,
    "entries": [
     [
      "rack",
      "rack",
      "2.2.8"
     ],
     [
      "rake",
      "rake",
      "13.1.0"
     ]
    ]
   }
  },
  {
   "name": "bundler_lock_stray_close",
   "path": "Gemfile.lock",
   "text": "GEM\n  specs:\n    rack (2.2.8)\n]\n",
   "expect": {
    "complete": false,
    "error_reason": "syntax_error"
   }
  },
  {
   "name": "bundler_lock_nul_byte",
   "path": "Gemfile.lock",
   "text": "GEM\n  specs:\n    rack (2.2.8)\n\u0000\n",
   "expect": {
    "complete": false,
    "error_reason": "syntax_error"
   }
  },
  {
   "name": "npm_scoped_package_lockfile_preserves_scope",
   "path": "package-lock.json",
   "text": "{\"lockfileVersion\": 3, \"packages\": {\"node_modules/@playwright/test\": {\"version\": \"1.60.0\"}}}",
   "expect": {
    "complete": true,
    "entries": [
     [
      "@playwright/test",
      "@playwright/test",
      "1.60.0"
     ]
    ]
   }
  },
  {
   "name": "npm_two_scoped_packages_same_unscoped_name",
   "path": "package-lock.json",
   "text": "{\"lockfileVersion\": 3, \"packages\": {\"node_modules/@oh-my-pi/pi-coding-agent\": {\"version\": \"0.1.0\"}, \"node_modules/@earendil-works/pi-coding-agent\": {\"version\": \"0.1.0\"}}}",
   "expect": {
    "complete": true,
    "entries": [
     [
      "@earendil-works/pi-coding-agent",
      "@earendil-works/pi-coding-agent",
      "0.1.0"
     ],
     [
      "@oh-my-pi/pi-coding-agent",
      "@oh-my-pi/pi-coding-agent",
      "0.1.0"
     ]
    ]
   }
  },
  {
   "name": "npm_scoped_nested_under_scoped",
   "path": "package-lock.json",
   "text": "{\"lockfileVersion\": 3, \"packages\": {\"node_modules/@types/node\": {\"version\": \"20.0.0\"}, \"node_modules/@playwright/test/node_modules/@types/node\": {\"version\": \"20.0.0\"}}}",
   "expect": {
    "complete": true,
    "entries": [
     [
      "@playwright/test/node_modules/@types/node",
      "@types/node",
      "20.0.0"
     ],
     [
      "@types/node",
      "@types/node",
      "20.0.0"
     ]
    ]
   }
  }
 ],
