{
  "schemaVersion": "guard.mcp-server-contribution.v1",
  "id": "mcp.cappz-market",
  "version": "1.0.0",
  "name": "CAPPZ Marketplace (cappz-market)",
  "description": "Reviews the local cappz-market MCP server, which trades on the CAPPZ Marketplace over XRPL: it publishes listings, bids and contracts to a shared market log, funds and releases XRP escrow, pays for counterparty checks and hires paid agents from a wallet kept on this computer. Market reads inherit Guard's handling; every write, signature or payment needs review. The server is external and remains off until enabled by a local administrator.",
  "trustClass": "external",
  "activation": "opt-in",
  "publisher": {
    "id": "cappz",
    "displayName": "CAPPZ",
    "url": "https://cappz.ai"
  },
  "icon": {
    "kind": "react-icon",
