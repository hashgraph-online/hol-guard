        "schema": "guard.command-extension-source.v1",
        "extension": {
          "extension_id": "command.codesage",
          "version": "1.0.0",
          "name": "CodeSage command protection",
          "description": "Reviews CodeSage commands that install Git hooks or change MCP server registration. doctor, status, and search are outside these rules.",
          "action_classes": [
            "CodeSage hook installation command",
            "CodeSage MCP registration command",
            "CodeSage MCP unregistration command"
          ],
          "risk_classes": [
            "destructive_shell"
          ],
          "safer_alternatives": [
            "Inspect existing Git hooks and review codesage install-hooks --help before installing hooks.",
            "Review the target agent configuration and the scope of --global before registering CodeSage.",
            "Review the target agent configuration and the scope of --global before unregistering CodeSage."
          ],
          "reference_urls": [
            "https://github.com/iliaal/codesage"
          ],
          "required": false,
          "source": "built-in",
          "aliases": [],
          "dependencies": [],
          "conflicts": [],
          "ecosystem_ids": [
            "codesage"
          ],
          "executables": [
            "codesage",
            "codesage.cmd",
            "codesage.exe"
          ],
          "project_markers": [],
          "publisher": {
            "id": "community.iliaal",
            "display_name": "Ilia Alshanetsky",
            "url": "https://github.com/iliaal"
          },
          "homepage": "https://github.com/iliaal/codesage",
          "icon": {
            "kind": "none"
          },
          "license": "Apache-2.0",
          "permissions": [
            {
              "permission_id": "command.codesage.permission.install-hooks",
              "implementation_version": "1.0.0",
              "label": "Install CodeSage Git hooks",
              "description": "Reviews installation of CodeSage Git hooks, including the optional repository leak-check hook.",
              "risk_tier": "medium",
              "baseline_floor": "review",
              "default_enabled": true,
              "configurable": true,
              "typed_capabilities": [],
              "action_classes": [
                "CodeSage hook installation command"
              ],
              "dependencies": [],
              "conflicts": [],
              "implied_permissions": [],
              "introduced_version": "1.0.0",
              "deprecated": false,
              "safer_guidance": [
                "Inspect existing Git hooks and review codesage install-hooks --help before installing hooks."
              ],
              "example_command": "codesage install-hooks"
            },
            {
              "permission_id": "command.codesage.permission.install",
              "implementation_version": "1.0.0",
              "label": "Register CodeSage MCP server",
              "description": "Reviews registration of the CodeSage MCP server in a project-local or user-level agent configuration.",
              "risk_tier": "medium",
              "baseline_floor": "review",
              "default_enabled": true,
              "configurable": true,
              "typed_capabilities": [],
              "action_classes": [
                "CodeSage MCP registration command"
              ],
              "dependencies": [],
              "conflicts": [],
              "implied_permissions": [],
              "introduced_version": "1.0.0",
              "deprecated": false,
              "safer_guidance": [
                "Review the target agent configuration and the scope of --global before registering CodeSage."
              ],
              "example_command": "codesage install codex"
            },
            {
              "permission_id": "command.codesage.permission.uninstall",
              "implementation_version": "1.0.0",
              "label": "Remove CodeSage MCP server",
              "description": "Reviews removal of the CodeSage MCP server from a project-local or user-level agent configuration.",
              "risk_tier": "medium",
              "baseline_floor": "review",
              "default_enabled": true,
              "configurable": true,
              "typed_capabilities": [],
              "action_classes": [
                "CodeSage MCP unregistration command"
              ],
              "dependencies": [],
              "conflicts": [],
              "implied_permissions": [],
              "introduced_version": "1.0.0",
              "deprecated": false,
