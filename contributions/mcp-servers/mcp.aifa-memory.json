{
  "schemaVersion": "guard.mcp-server-contribution.v1",
  "id": "mcp.aifa-memory",
  "version": "1.9.8",
  "name": "AIfa Memory",
  "description": "Hosted encrypted long-term memory for AI agents over Streamable HTTP at https://aifa.works/api/mcp with optional permanent Arweave anchoring (AES-256-GCM). Discovery, memory_about, plans and partner_kit keep Guard's usual handling; every tool that reads or modifies private memory, creates payment invoices, requests payouts or configures webhooks is gated on review. Off until you turn it on.",
  "trustClass": "external",
  "activation": "opt-in",
  "publisher": {
    "id": "maksimgalatin",
    "displayName": "Maksim Galatin",
    "url": "https://github.com/MaksimGalatin"
  },
  "icon": {
    "kind": "react-icon",
    "name": "HiMiniCloud",
    "background": "#0B1020"
  },
  "homepage": "https://aifa.works/mcp",
  "license": "MIT",
  "launch": {
    "kind": "remote-http",
    "url": "https://aifa.works/api/mcp",
    "serverNames": [
      "aifa-memory",
      "aifa-memory-mcp"
    ]
  },
  "riskClasses": [
    "external-network-read",
    "external-account-read",
    "external-shared-state-write"
  ],
  "tools": [
