                        "project",
                        "open"
                      ],
                      "options_with_values": [
                        "-p",
                        "--project"
                      ],
                      "interleaved_options_with_values": [
                        "-p",
                        "--project"
                      ]
                    },
                    "matchers": []
                  },
                  {
                    "op": "leading-subcommand.v1",
                    "config": {
                      "executables": [
                        "agentburp",
                        "agentburp.cmd",
                        "agentburp.exe"
                      ],
                      "subcommands": [
                        "project",
                        "delete"
                      ],
                      "options_with_values": [
                        "-p",
                        "--project"
                      ],
                      "interleaved_options_with_values": [
                        "-p",
                        "--project"
                      ]
                    },
                    "matchers": []
                  }
                ]
              }
            }
          ]
