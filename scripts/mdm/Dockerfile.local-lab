FROM ghcr.io/astral-sh/uv:0.9.30-python3.12-bookworm-slim@sha256:e5b65587bce7de595f299855d7385fe7fca39b8a74baa261ba1b7147afa78e58

WORKDIR /hol-guard

COPY pyproject.toml uv.lock README.md ./
COPY docs ./docs
COPY src ./src
COPY tests ./tests
COPY scripts/mdm ./scripts/mdm

RUN uv sync --extra dev --frozen

RUN useradd --create-home --uid 10001 guard && chown -R guard:guard /hol-guard

ENV PATH="/hol-guard/.venv/bin:${PATH}"

USER 10001:10001

ENTRYPOINT ["python", "scripts/mdm/run-local-lab.py", "--json"]
