{
  "schemaVersion": "guard.mcp-server-contribution.v1",
  "id": "mcp.fetchsandbox",
  "version": "1.0.0",
  "name": "FetchSandbox MCP",
  "description": "Reviews the FetchSandbox tools that upload a workspace for remote analysis or publish evidence to a shareable receipt, and leaves catalog and run listing automatic.",
  "trustClass": "external",
  "activation": "opt-in",
  "publisher": {
    "id": "fetchsandbox.com",
    "displayName": "FetchSandbox",
    "url": "https://fetchsandbox.com"
  },
