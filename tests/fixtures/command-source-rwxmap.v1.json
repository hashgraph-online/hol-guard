              "configurable": true,
              "conflicts": [],
              "default_enabled": true,
              "dependencies": [],
              "deprecated": false,
              "description": "Identifies `rwxmap ... --force`, which replaces existing `<vendor>.rwxmap.json`, `<vendor>.rwxmap.review.json` and `<vendor>.openapi.rwx.json` files in the output folder (-o, default the current folder). Without --force rwxmap refuses to overwrite and writes nothing. Covers the installed bin and npx, bunx and pnpx launches of the rwxmap package. This rule does not gate rwxmap's optional Jev pass, which sends operation text to api.typesafe.ai on any run when RWXMAP_JEV_KEY is set in the environment or a working-directory .env.",
              "example_command": "rwxmap ./openapi.json -o out --force",
              "family": null,
              "fixed_reason": null,
              "implementation_version": "1.0.0",
              "implied_permissions": [],
              "introduced_version": "1.0.0",
              "label": "rwxmap forced output overwrite",
              "permission_id": "command.rwxmap.permission.force",
              "replacement_permission_id": null,
              "risk_tier": "low",
              "safer_guidance": [
                "Run rwxmap without --force first; it refuses to overwrite and names the existing files.",
                "Point -o at a new, empty folder instead of overwriting earlier output.",
                "Do not set RWXMAP_JEV_KEY, and check the working directory for a .env that sets it, when processing private API schemas: with the key set, any rwxmap run, with or without --force, sends each operation's method, path, operationId, summary and description to api.typesafe.ai. This extension's --force rule does not gate that optional network disclosure."
              ],
              "typed_capabilities": []
