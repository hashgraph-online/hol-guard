              "action_classes": [
                "netdoctor network diagnosis"
              ],
              "baseline_floor": "allow",
              "configurable": true,
              "conflicts": [],
              "default_enabled": true,
              "dependencies": [],
              "deprecated": false,
              "description": "One-shot netdoctor runs against the named targets: DNS resolution, a single ICMP ping, a TCP connect, HTTP GET probes (5 by default), and a traceroute. Output goes to the terminal or stdout as JSON; nothing is written to disk.",
              "example_command": "netdoctor github.com --json",
              "family": null,
              "fixed_reason": null,
              "implementation_version": "1.0.0",
