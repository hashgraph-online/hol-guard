                "interspersed_flags": [
                  "--dry-run",
                  "--help",
                  "-h",
                  "--json",
                  "--no-color",
                  "--force"
                ],
                "required_flags": [
                  "--dry-run"
                ],
                "required_flags_in_all_arguments": true,
                "fail_secure_unknown_options": true,
                "paths": [
                  [
                    "project",
                    "create"
                  ],
                  [
                    "project",
                    "open"
                  ],
