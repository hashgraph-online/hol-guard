{
  "schema": "guard.command-extension-source.v1",
  "extension": {
    "extension_id": "command.cross-exam",
    "version": "1.0.0",
    "name": "MCP Cross Exam",
    "description": "Reviews agent invocations of mcp-cross-exam that contact an MCP target, start a stdio server, run write probes, or serve a fixture process. Help, version, probes list, probes plan, and config show are unmatched and keep first-party floors. Package launchers stay on command.package.python. Enabling this extension does not start Guard-invoked audits.",
    "action_classes": [
      "MCP Cross Exam network audit",
      "MCP Cross Exam stdio audit",
      "MCP Cross Exam write probe",
      "MCP Cross Exam fixture serve"
    ],
    "risk_classes": [
      "execution",
      "network_egress",
      "local_write"
    ],
    "safer_alternatives": [
      "Use mcp-cross-exam --help, --version, probes list, probes plan, or config show to inspect the auditor without starting a target."
    ],
    "reference_urls": [
      "https://github.com/smusali/mcp-cross-exam"
    ],
    "required": false,
    "source": "built-in",
    "aliases": [],
    "dependencies": [],
    "conflicts": [],
    "ecosystem_ids": [],
    "executables": [
      "mcp-cross-exam",
      "mcp-cross-exam.cmd",
      "mcp-cross-exam.exe"
    ],
    "project_markers": [],
    "publisher": {
      "id": "community.smusali",
      "display_name": "Samir Musali",
      "url": "https://github.com/smusali/mcp-cross-exam"
    },
    "homepage": "https://github.com/smusali/mcp-cross-exam",
    "icon": {
      "kind": "none"
    },
    "license": "MIT",
    "permissions": [
      {
        "permission_id": "command.cross-exam.permission.network",
        "implementation_version": "1.0.0",
        "label": "MCP Cross Exam network audit",
        "description": "Allows mcp-cross-exam to contact an http(s) or SSE MCP target.",
        "risk_tier": "high",
        "baseline_floor": "review",
        "default_enabled": true,
        "configurable": true,
        "typed_capabilities": [],
        "action_classes": [
          "MCP Cross Exam network audit"
        ],
        "dependencies": [],
        "conflicts": [],
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "deprecated": false,
        "safer_guidance": [
          "Inspect the target URL before authorizing a network audit.",
          "Use --help or probes list when you only need auditor metadata."
        ],
        "example_command": "mcp-cross-exam http://127.0.0.1:8765/mcp --read-only"
      },
      {
        "permission_id": "command.cross-exam.permission.stdio",
        "implementation_version": "1.0.0",
        "label": "MCP Cross Exam stdio audit",
        "description": "Allows mcp-cross-exam to launch a remainder command as a stdio MCP server.",
        "risk_tier": "high",
        "baseline_floor": "review",
        "default_enabled": true,
        "configurable": true,
        "typed_capabilities": [],
        "action_classes": [
          "MCP Cross Exam stdio audit"
        ],
        "dependencies": [],
        "conflicts": [],
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "deprecated": false,
        "safer_guidance": [
          "Review the remainder command before authorizing a stdio audit."
        ],
        "example_command": "mcp-cross-exam -- python server.py"
      },
      {
        "permission_id": "command.cross-exam.permission.writes",
        "implementation_version": "1.0.0",
        "label": "MCP Cross Exam write probes",
        "description": "Allows mcp-cross-exam --allow-writes, which can invoke tools that claim write side effects.",
        "risk_tier": "high",
        "baseline_floor": "review",
        "default_enabled": true,
        "configurable": true,
        "typed_capabilities": [],
        "action_classes": [
          "MCP Cross Exam write probe"
        ],
        "dependencies": [],
        "conflicts": [],
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "deprecated": false,
        "safer_guidance": [
          "Tool annotations are not verified side-effect guarantees. Prefer --read-only."
        ],
        "example_command": "mcp-cross-exam http://127.0.0.1:8765/mcp --allow-writes"
      },
      {
        "permission_id": "command.cross-exam.permission.fixture-serve",
        "implementation_version": "1.0.0",
        "label": "MCP Cross Exam fixture serve",
        "description": "Allows mcp-cross-exam fixture serve, which starts a local process.",
        "risk_tier": "medium",
        "baseline_floor": "review",
        "default_enabled": true,
        "configurable": true,
        "typed_capabilities": [],
        "action_classes": [
          "MCP Cross Exam fixture serve"
        ],
        "dependencies": [],
        "conflicts": [],
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "deprecated": false,
        "safer_guidance": [
          "Fixture servers are for local testing. Do not expose them beyond loopback."
        ],
        "example_command": "mcp-cross-exam fixture serve --http 127.0.0.1:8765"
      }
    ],
    "rules": [
      {
        "rule_id": "command.cross-exam.network",
        "rule_version": "1.0.0",
        "permission_id": "command.cross-exam.permission.network",
        "title": "MCP Cross Exam network audit",
        "description": "Identifies mcp-cross-exam invocations that include an http(s) URL or --sse, except --help and --version.",
        "severity": "high",
        "risk_classes": [
          "execution",
          "network_egress"
        ],
        "action_classes": [
          "MCP Cross Exam network audit"
        ],
        "safer_alternatives": [
          "Use mcp-cross-exam --help or probes list when you do not need to contact a server."
        ],
        "default_mode": "review",
        "safe_variants": [],
        "matcher": {
          "op": "any.v1",
          "config": {},
          "matchers": [
            {
              "op": "executable.v1",
              "config": {
                "allow_leading_options": true,
                "executables": [
                  "mcp-cross-exam",
                  "mcp-cross-exam.cmd",
                  "mcp-cross-exam.exe"
                ],
                "fail_secure_unknown_options": false,
                "forbidden_flags": [
                  "--help",
                  "--version"
                ],
                "interspersed_flags": [],
                "interspersed_options_with_values": [],
                "inverse_flag_pairs": [],
                "leading_options_with_values": [],
                "options_with_values": [
                  "--out-dir",
                  "--family",
                  "--probe",
                  "--skip",
                  "--tool",
                  "--jobs",
                  "--timeout",
                  "--config",
                  "--snapshot",
                  "--fail-on",
                  "--cwd",
                  "--env-from",
                  "--bearer-env",
                  "--header-env",
                  "--expired-bearer-env"
                ],
                "required_flags": [
                  "--sse"
                ],
                "required_flags_in_all_arguments": false,
                "required_option_values": [],
                "subcommands": []
              }
            },
            {
              "op": "trailing-operand-prefix.v1",
              "config": {
                "excluded_first_arguments": [
                  "probes",
                  "config",
                  "fixture"
                ],
                "executables": [
                  "mcp-cross-exam",
                  "mcp-cross-exam.cmd",
                  "mcp-cross-exam.exe"
                ],
                "forbidden_flags": [
                  "--help",
                  "--version"
                ],
                "minimum_operands": 1,
                "operand_prefixes": [
                  "http://",
                  "https://"
                ],
                "options_with_values": [
                  "--out-dir",
                  "--family",
                  "--probe",
                  "--skip",
                  "--tool",
                  "--jobs",
                  "--timeout",
                  "--config",
                  "--snapshot",
                  "--fail-on",
                  "--cwd",
                  "--env-from",
                  "--bearer-env",
                  "--header-env",
                  "--expired-bearer-env"
                ],
                "required_flags": []
              }
            }
          ]
        }
      },
      {
        "rule_id": "command.cross-exam.stdio",
        "rule_version": "1.0.0",
        "permission_id": "command.cross-exam.permission.stdio",
        "title": "MCP Cross Exam stdio audit",
        "description": "Identifies mcp-cross-exam invocations that pass a remainder command.",
        "severity": "high",
        "risk_classes": [
          "execution"
        ],
        "action_classes": [
          "MCP Cross Exam stdio audit"
        ],
        "safer_alternatives": [
          "Inspect the remainder command before authorizing a stdio audit."
        ],
        "default_mode": "review",
        "safe_variants": [],
        "matcher": {
          "op": "any.v1",
          "config": {},
          "matchers": [
            {
              "op": "arguments.v1",
              "config": {
                "executables": [
                  "mcp-cross-exam",
                  "mcp-cross-exam.cmd",
                  "mcp-cross-exam.exe"
                ],
                "required_arguments": [
                  "--"
                ]
              }
            }
          ]
        }
      },
      {
        "rule_id": "command.cross-exam.writes",
        "rule_version": "1.0.0",
        "permission_id": "command.cross-exam.permission.writes",
        "title": "MCP Cross Exam write probes",
        "description": "Identifies mcp-cross-exam --allow-writes.",
        "severity": "high",
        "risk_classes": [
          "execution",
          "local_write"
        ],
        "action_classes": [
          "MCP Cross Exam write probe"
        ],
        "safer_alternatives": [
          "Use --read-only unless write probes are explicitly required."
        ],
        "default_mode": "review",
        "safe_variants": [],
        "matcher": {
          "op": "executable.v1",
          "config": {
            "allow_leading_options": true,
            "executables": [
              "mcp-cross-exam",
              "mcp-cross-exam.cmd",
              "mcp-cross-exam.exe"
            ],
            "fail_secure_unknown_options": false,
            "forbidden_flags": [
              "--help",
              "--version"
            ],
            "interspersed_flags": [],
            "interspersed_options_with_values": [],
            "inverse_flag_pairs": [],
            "leading_options_with_values": [],
            "options_with_values": [
              "--out-dir",
              "--family",
              "--probe",
              "--skip",
              "--tool",
              "--jobs",
              "--timeout",
              "--config",
              "--snapshot",
              "--fail-on",
              "--cwd",
              "--env-from",
              "--bearer-env",
              "--header-env",
              "--expired-bearer-env"
            ],
            "required_flags": [
              "--allow-writes"
            ],
            "required_flags_in_all_arguments": true,
            "required_option_values": [],
            "subcommands": []
          }
        }
      },
      {
        "rule_id": "command.cross-exam.fixture-serve",
        "rule_version": "1.0.0",
        "permission_id": "command.cross-exam.permission.fixture-serve",
        "title": "MCP Cross Exam fixture serve",
        "description": "Identifies mcp-cross-exam fixture serve, which starts a process.",
        "severity": "medium",
        "risk_classes": [
          "execution"
        ],
        "action_classes": [
          "MCP Cross Exam fixture serve"
        ],
        "safer_alternatives": [
          "Keep fixture servers on loopback and stop them after the test."
        ],
        "default_mode": "review",
        "safe_variants": [],
        "matcher": {
          "op": "executable.v1",
          "config": {
            "allow_leading_options": false,
            "executables": [
              "mcp-cross-exam",
              "mcp-cross-exam.cmd",
              "mcp-cross-exam.exe"
            ],
            "fail_secure_unknown_options": false,
            "forbidden_flags": [
              "--help",
              "--version"
            ],
            "interspersed_flags": [],
            "interspersed_options_with_values": [],
            "inverse_flag_pairs": [],
            "leading_options_with_values": [],
            "options_with_values": [
              "--http"
            ],
            "required_flags": [],
            "required_flags_in_all_arguments": false,
            "required_option_values": [],
            "subcommands": [
              "fixture",
              "serve"
            ]
          }
        }
      }
    ]
  }
}
