              "permission_id": "command.codesage.permission.install-hooks",
              "title": "CodeSage hook installation",
              "description": "Identifies codesage install-hooks, which writes repository Git hooks that reindex the project and can install an optional leak-check hook.",
              "severity": "medium",
              "risk_classes": [
                "destructive_shell"
              ],
              "action_classes": [
                "CodeSage hook installation command"
              ],
              "safer_alternatives": [
                "Inspect existing Git hooks and review codesage install-hooks --help before installing hooks."
              ],
              "default_mode": "review",
              "matcher": {
                "op": "executable.v1",
                "config": {
                  "executables": [
                    "codesage",
                    "codesage.cmd",
                    "codesage.exe"
                  ],
                  "subcommands": [
                    "install-hooks"
                  ],
                  "allow_leading_options": false,
                  "leading_options_with_values": [],
                  "interspersed_options_with_values": [],
                  "interspersed_flags": [
                    "--help",
                    "--strict",
                    "--with-leak-check",
                    "-h"
                  ],
