{
  "build": {
    "schema": "guard.command-extension-build.v1",
    "base": "packaged",
    "sources": [
      {
        "extension": {
          "action_classes": [
            "gitsync mirror-mutating command",
            "gitsync webhook-rewriting command",
            "gitsync service-install command"
          ],
          "aliases": [],
          "conflicts": [],
          "delegated_protection": null,
          "dependencies": [],
          "description": "Reviews gitsync's live mirror sync, server-side webhook rewrites, and service install/uninstall. `check`, `status`, and plain `hooks` do not match any rule here; Guard's default floor still applies to them since gitsync is not on the built-in safe-command list and no rule in this extension matches those subcommands. Every mutating subcommand covered here always requires review, even with --help, -h or --dry-run present, because gitsync's flag parser can silently drop those flags depending on argument order and this matcher engine cannot detect when that happened.",
          "ecosystem_ids": [],
          "executables": [],
          "extension_id": "command.gitsync",
          "homepage": "https://github.com/cristobaltormo/git-sync",
          "icon": {
            "kind": "none"
          },
          "license": "Apache-2.0",
          "name": "gitsync command protection",
          "permissions": [
            {
              "action_classes": [
                "gitsync mirror-mutating command"
              ],
              "baseline_floor": "review",
              "configurable": true,
              "conflicts": [],
              "default_enabled": true,
              "dependencies": [],
              "deprecated": false,
              "description": "Identifies `gitsync sync` and `gitsync run`, which force-push and prune every configured repo's branches and tags to GitHub so the two sides end up identical, and can eventually delete the GitHub mirror once a repo disappears from the source (subject to gitsync's own delete_grace and delete_limit safeguards). Both accept --help/-h, and `run` also accepts --dry-run, but gitsync's flag parser (Go's stdlib flag.FlagSet) stops at the first token that isn't a flag and never looks at anything after it - so a flag placed after a repo name, or after any other token, is silently ignored and the command still runs live. No safe variant is reliable against that, so this rule always reviews sync and run regardless of which flags are present.",
              "example_command": "gitsync sync",
              "family": null,
              "fixed_reason": null,
              "implementation_version": "1.0.0",
              "implied_permissions": [],
              "introduced_version": "2.2.0",
              "label": "gitsync live mirror sync",
              "permission_id": "command.gitsync.permission.mirror-mutation",
              "replacement_permission_id": null,
              "risk_tier": "high",
              "safer_guidance": [
                "Run `gitsync run --dry-run` as the very first argument, nothing before it, and review what it reports before running it live - never rely on --dry-run appearing safe by itself.",
                "Run `gitsync check` to confirm token scopes and account mapping before mirroring."
              ],
              "typed_capabilities": []
            },
            {
              "action_classes": [
                "gitsync webhook-rewriting command",
                "gitsync service-install command"
              ],
              "baseline_floor": "review",
              "configurable": true,
              "conflicts": [],
              "default_enabled": true,
              "dependencies": [],
              "deprecated": false,
              "description": "Identifies `gitsync hooks --force`/`-force` (rewrites existing webhooks on the git server), `gitsync hooks --remove`/`-remove` (deletes them), and `gitsync install` / `gitsync uninstall` (registers or removes the persistent background service). Go's flag parser treats a single dash the same as a double dash for a named flag, so both spellings are matched. Plain `gitsync hooks` (no flags) still mutates - it creates any missing webhooks - but never rewrites or deletes an existing one, so it is not covered here. No safe variant is offered for --help/-h on any of these: gitsync's flag parser stops at the first non-flag token and never looks at anything after it, so a flag placed after any other token is silently ignored rather than shown as help, and a declarative matcher cannot tell that case apart from one where the flag actually took effect. `uninstall` additionally never parses flags at all - it ignores every argument on both Linux and Windows and always removes the service and binary - so it was never going to have a safe variant regardless.",
              "example_command": "gitsync hooks --remove",
              "family": null,
              "fixed_reason": null,
              "implementation_version": "1.0.0",
              "implied_permissions": [],
              "introduced_version": "2.2.0",
              "label": "gitsync webhook rewrite, removal, or service install/uninstall",
              "permission_id": "command.gitsync.permission.operational-mutation",
              "replacement_permission_id": null,
              "risk_tier": "medium",
              "safer_guidance": [
                "Prefer plain `gitsync hooks`, which only creates missing webhooks and does not rewrite or delete existing ones.",
                "Run `gitsync run --dry-run` interactively before installing it as an unattended service."
              ],
              "typed_capabilities": []
            }
          ],
          "project_markers": [],
          "publisher": {
            "display_name": "Community",
            "id": "community.gitsync",
            "url": null
          },
          "reference_urls": [
