        "dependencies": [],
        "deprecated": false,
        "description": "Identifies `kd pull`, `kd pull-async` and `kd bench-pull`, which write a file from the peer to a local path. Given no second argument the destination is the name the peer chose, so the remote side picks the path. The write creates missing parent directories and truncates a file already there. `bench-pull` deletes the destination after measuring it.",
        "example_command": "kd pull report.mov ./downloads/report.mov",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
