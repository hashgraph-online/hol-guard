{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hol.org/schemas/guard/extension-contribution.v1.json",
  "title": "HOL Guard extension contribution v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "description",
    "trustClass",
    "activation",
    "publisher",
    "icon",
    "executables",
    "riskClasses",
    "actionClasses",
    "detector"
  ],
  "properties": {
    "schemaVersion": { "const": "guard.extension-contribution.v1" },
    "id": {
      "type": "string",
      "pattern": "^command\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 256
    },
    "version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$",
      "maxLength": 32
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "description": { "type": "string", "minLength": 1, "maxLength": 512 },
    "trustClass": { "const": "external" },
    "activation": { "const": "opt-in" },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 128 },
        "url": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "icon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["react-icon", "svg-ref", "none"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "background": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      }
    },
    "homepage": { "type": "string", "minLength": 1, "maxLength": 512 },
    "license": { "type": "string", "minLength": 1, "maxLength": 64 },
    "executables": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "ecosystemIds": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "riskClasses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "actionClasses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "referenceUrls": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "saferAlternatives": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "module"],
      "properties": {
        "kind": { "const": "python-module" },
        "module": {
          "type": "string",
          "pattern": "^codex_plugin_scanner\\.guard\\.runtime\\.[a-z0-9_]+$"
        }
      }
    }
  }
}
