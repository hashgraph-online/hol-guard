              "dependencies": [],
              "deprecated": false,
              "description": "Identifies `batterycontrol limit off`, which removes an active charge-limit policy and hands charging back to macOS. Upstream requires `--confirm` while a limit is active so unattended callers cannot silently drop the protection.",
              "example_command": "batterycontrol limit off --confirm",
              "family": null,
              "fixed_reason": null,
              "implementation_version": "1.0.0",
              "implied_permissions": [],
              "introduced_version": "3.6.1",
              "label": "Charge limit removal",
              "permission_id": "command.batterycontrol.permission.limit-off",
              "replacement_permission_id": null,
              "risk_tier": "high",
              "safer_guidance": [
                "Run `batterycontrol limit status` first to see whether a limit is active and verified on hardware.",
                "Removing an active limit lets the battery charge to 100% again; confirm the change is deliberate."
              ],
              "typed_capabilities": []
            },
            {
              "action_classes": [
                "batterycontrol charging policy command"
              ],
              "baseline_floor": "review",
