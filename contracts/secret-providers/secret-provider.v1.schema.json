{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hol.org/schemas/secret-provider.v1.json",
  "title": "Guard secret provider",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "publisher", "display_name", "status", "default_enabled", "connection", "endpoints", "capabilities", "references", "limits", "delivery", "responses", "privacy"],
  "properties": {
    "schema": { "const": "guard.secret-provider.v1" },
    "id": { "type": "string", "pattern": "^provider\\.[a-z][a-z0-9._-]{0,62}$", "maxLength": 72 },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name"],
      "properties": {
        "id": { "type": "string", "pattern": "^publisher\\.[a-z][a-z0-9._-]{0,62}$", "maxLength": 72 },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "status": { "enum": ["first_party", "external"] },
    "default_enabled": { "const": false },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auth", "credential_scope"],
      "properties": {
        "auth": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["native_keychain", "api_token", "oauth_device", "oauth_loopback", "oidc_workload", "spiffe_workload", "local_peer"] }
        },
        "credential_scope": { "$ref": "#/$defs/safe_name" }
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scheme", "host", "port", "paths", "redirects"],
        "properties": {
          "scheme": { "const": "https" },
          "host": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$", "maxLength": 253 },
          "port": { "const": 443 },
          "paths": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "pattern": "^/[A-Za-z0-9._~/-]{1,240}$", "maxLength": 241 } },
          "redirects": { "const": false }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "enum": ["secret.metadata", "secret.resolve", "secret.lease", "secret.verify"] }
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_pattern", "name_pattern", "fields", "versions"],
      "properties": {
        "scope_pattern": { "type": "string", "maxLength": 120 },
        "name_pattern": { "type": "string", "maxLength": 120 },
        "fields": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/safe_name" } },
        "versions": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "enum": ["latest", "pinned"] } }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_bytes", "response_bytes", "json_depth", "timeout_ms", "retries"],
      "properties": {
        "request_bytes": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "response_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "json_depth": { "type": "integer", "minimum": 1, "maximum": 16 },
        "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 10000 },
        "retries": { "type": "integer", "minimum": 0, "maximum": 2 }
      }
    },
    "delivery": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["environment", "stdin", "file_descriptor"] }
    },
    "responses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metadata_pointer", "value_pointer", "version_pointer"],
      "properties": {
        "metadata_pointer": { "$ref": "#/$defs/json_pointer" },
        "value_pointer": { "$ref": "#/$defs/json_pointer" },
        "version_pointer": { "$ref": "#/$defs/json_pointer" },
        "lease_pointer": { "$ref": "#/$defs/json_pointer" }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shares", "shares_secret_values", "shares_connection_credentials"],
      "properties": {
        "shares": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/safe_name" } },
        "shares_secret_values": { "const": false },
        "shares_connection_credentials": { "const": false }
      }
    }
  },
  "$defs": {
    "safe_name": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,62}$", "maxLength": 63 },
    "json_pointer": { "type": "string", "pattern": "^/(?:[A-Za-z0-9._~-]+/)*[A-Za-z0-9._~-]+$", "maxLength": 256 }
  }
}
