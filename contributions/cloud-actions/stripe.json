          "const": "payment"
        },
        "scope": {
          "const": "single"
        },
        "reversibility": {
          "const": "permanent"
        },
        "recordCount": {
          "const": 1
        }
      },
      "response": {
        "maxBytes": 16384,
        "fields": [
          {
            "name": "id",
            "value": {
              "from": "id"
            }
          },
          {
            "name": "amount",
            "value": {
              "from": "amount"
            }
          },
          {
            "name": "currency",
            "value": {
              "from": "currency"
            }
          },
          {
            "name": "status",
