{
  "schemaVersion": "guard.mcp-server-contribution.v1",
  "id": "mcp.authyouragent",
  "version": "1.0.0",
  "name": "Auth Your Agent",
  "description": "Reviews the tools that drive a signed-in browser vault: navigate, click, type_text, press_key, select_option, go_back, fill_secret (types a saved password or TOTP code the agent never sees) and request_approval. Reads, status checks, take over and sign-out follow your normal Guard policy. The server also holds committing clicks for phone approval. Off until you turn it on.",
  "trustClass": "external",
  "activation": "opt-in",
  "publisher": {
    "id": "io.github.kjames2001",
    "displayName": "kjames2001",
    "url": "https://github.com/kjames2001/authyouragent"
  },
  "icon": { "kind": "react-icon", "name": "HiMiniGlobeAlt", "background": "#0D9488" },
  "homepage": "https://authyouragent.com",
  "license": "MIT",
  "launch": {
    "kind": "package-launcher",
    "command": "npx",
    "package": "authyouragent-mcp"
  },
  "riskClasses": [
    "external-signed-in-browser-actions",
    "external-saved-credential-fill",
    "external-server-enforces-phone-approval"
  ],
  "tools": [
    { "name": "navigate", "state": "review" },
    { "name": "click", "state": "review" },
    { "name": "type_text", "state": "review" },
    { "name": "fill_secret", "state": "review" },
    { "name": "press_key", "state": "review" },
    { "name": "select_option", "state": "review" },
    { "name": "go_back", "state": "review" },
    { "name": "request_approval", "state": "review" },
    { "name": "read_page", "state": "inherit" },
    { "name": "check_login_wall", "state": "inherit" },
    { "name": "list_secrets", "state": "inherit" },
    { "name": "request_takeover", "state": "inherit" },
    { "name": "wait_for_takeover", "state": "inherit" },
    { "name": "check_agent_status", "state": "inherit" },
    { "name": "end_session", "state": "inherit" },
    { "name": "scroll", "state": "inherit" },
    { "name": "wait_for", "state": "inherit" },
    { "name": "screenshot", "state": "review" },
    { "name": "notify_owner", "state": "inherit" },
    { "name": "report_site", "state": "inherit" },
    { "name": "other", "state": "inherit" }
  ],
  "referenceUrls": [
    "https://github.com/kjames2001/authyouragent",
    "https://github.com/kjames2001/authyouragent/blob/main/sdk/authyouragent/mcp_server.py",
    "https://authyouragent.com/docs/developers/takeover"
  ],
  "saferAlternatives": [
    "Keep fill_secret on Review: it types a stored password or authenticator code into the page, even though the agent never sees the value.",
    "The vault already holds every committing click, Enter and scripted write for phone approval; Review on click adds a second prompt for routine clicks.",
    "Consider allowing end_session locally: it signs out and wipes the browser profile, and pausing it would leave the owner signed in after the agent stops."
  ]
}
