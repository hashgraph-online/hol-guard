        "matcher": {
          "op": "any.v1",
          "config": {},
          "matchers": [
            {
              "op": "executable.v1",
              "config": {
                "allow_leading_options": true,
                "executables": [
                  "snoboard",
                  "snoboard.cmd",
                  "snoboard.exe"
                ],
                "fail_secure_unknown_options": true,
                "forbidden_flags": [],
                "interspersed_flags": [
                  "--fetch",
                  "--help",
                  "--version"
                ],
                "interspersed_options_with_values": [
                  "--priority",
                  "--repo",
                  "--title"
                ],
                "inverse_flag_pairs": [],
                "leading_options_with_values": [
                  "--priority",
                  "--repo",
                  "--title"
                ],
                "options_with_values": [
                  "--priority",
                  "--repo",
                  "--title"
                ],
                "required_flags": [],
                "required_flags_in_all_arguments": false,
                "required_option_values": [],
                "subcommands": [
                  "new"
                ]
              }
            }
          ]
        },
        "safe_variants": [
          {
