{
  "schema": "hol-guard.native-readiness.v1",
  "states": {
    "ready": {
      "verdict": "evaluated",
      "retry": false,
      "summary": "The native runtime answered for this Guard home."
    },
    "starting": {
      "verdict": "not_evaluated",
      "retry": true,
      "summary": "The native runtime is starting or recovering and has not answered yet."
    },
    "overloaded": {
      "verdict": "not_evaluated",
      "retry": true,
      "summary": "The native runtime is busy and turned this request away."
    },
    "unavailable": {
      "verdict": "not_evaluated",
      "retry": false,
      "summary": "No native runtime is reachable for this Guard home."
    },
    "incompatible": {
      "verdict": "not_evaluated",
      "retry": false,
      "summary": "The native runtime does not match this Guard build or protocol."
    },
    "unauthenticated": {
      "verdict": "not_evaluated",
      "retry": false,
      "summary": "The native runtime could not prove it belongs to this Guard home."
    },
    "failed": {
      "verdict": "not_evaluated",
      "retry": false,
      "summary": "The native runtime answered, but its answer could not be used."
    }
  },
  "default_state": "unavailable",
