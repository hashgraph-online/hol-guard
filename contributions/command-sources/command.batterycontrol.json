        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
        "introduced_version": "3.6.1",
        "label": "Forced discharge start",
        "permission_id": "command.batterycontrol.permission.discharge-start",
        "replacement_permission_id": null,
        "risk_tier": "high",
        "safer_guidance": [
          "Run `batterycontrol discharge status` first; a discharge session may already be running.",
