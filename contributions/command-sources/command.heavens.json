        ],
        "baseline_floor": "review",
        "configurable": true,
        "conflicts": [],
        "default_enabled": true,
        "dependencies": [],
        "deprecated": false,
        "description": "Identifies `heaven post|put|patch|delete`, which sends a state-changing HTTP request to the active or specified environment. Protected environments prompt a human, but non-interactive agent sessions bypass that review path. exec and xargs launches are blocked by Guard's wrapper floor.",
        "example_command": "heaven delete /users/42 --env prod",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
