  "trustClass": "external",
  "activation": "opt-in",
  "publisher": {
    "id": "community.crizant",
    "displayName": "Community",
    "url": "https://github.com/crizant/probe"
  },
  "icon": { "kind": "react-icon", "name": "HiMiniCommandLine", "background": "#B45309" },
