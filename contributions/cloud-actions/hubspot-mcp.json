{
  "schema": "guard.cloud-action-pack.v1",
  "provider": {
    "id": "hubspot-mcp",
    "name": "HubSpot MCP",
    "publisher": {
      "name": "HOL",
      "verified": true
    }
  },
  "hosts": [
    "mcp.hubspot.com"
  ],
  "auth": {
    "mode": "oauth2",
    "scopes": [
      "crm.objects.contacts.read",
      "crm.objects.contacts.write"
    ]
  },
  "actions": [
    {
      "actionId": "hubspot-mcp.get_user_details",
      "title": "Read the signed-in user",
      "link": {
        "tool": "get_user_details"
      },
      "executor": {
        "kind": "remote-mcp",
        "tool": "get_user_details"
      },
      "arguments": {},
      "openArguments": {
        "maxBytes": 8192
      },
      "facts": {
        "class": "read",
        "object": {
          "const": "contact"
        },
        "scope": {
          "const": "single"
        },
        "recordCount": {
          "const": 1
        }
      },
      "response": {
        "maxBytes": 262144,
        "fields": [
          {
            "name": "content",
            "value": {
              "from": "content"
            },
            "untrusted": true
          }
        ]
      },
      "safety": {
        "effect": "read",
        "requiredCapabilities": [
          "bounded-output",
          "egress-pinned"
        ],
        "idempotency": "safe-read",
        "scopes": [
          "crm.objects.contacts.read",
          "crm.objects.contacts.write"
        ],
        "maxItems": 1,
        "minIntervalMs": 500,
        "timeoutMs": 15000
      },
      "fixtures": [
        {
          "name": "calls get_user_details",
          "kind": "safe",
          "arguments": {},
          "expect": {
            "facts": {
              "class": "read",
              "object": {
                "state": "known",
                "value": "contact"
              },
              "scope": {
                "state": "known",
                "value": "single"
              },
              "record_count": {
                "state": "known",
                "value": 1
              }
            },
            "decisions": {
              "balanced": "allow",
              "relaxed": "allow",
              "strict": "allow"
            }
          }
        },
        {
          "name": "refuses arguments over the size bound",
          "kind": "risky",
          "arguments": {
            "payload": ""
          },
          "expect": {
            "error": "open_arguments_too_large"
          }
        }
      ]
    },
    {
      "actionId": "hubspot-mcp.search_crm_objects",
      "title": "Search CRM records",
      "link": {
        "tool": "search_crm_objects"
      },
      "executor": {
        "kind": "remote-mcp",
        "tool": "search_crm_objects"
      },
      "arguments": {},
      "openArguments": {
        "maxBytes": 8192
      },
      "facts": {
        "class": "read",
        "object": {
          "const": "record"
        },
        "scope": {
          "const": "query_selected"
        }
      },
      "response": {
        "maxBytes": 262144,
        "fields": [
          {
            "name": "content",
            "value": {
              "from": "content"
            },
            "untrusted": true
          }
        ]
      },
      "safety": {
        "effect": "read",
        "requiredCapabilities": [
          "bounded-output",
          "egress-pinned"
        ],
        "idempotency": "safe-read",
        "scopes": [
          "crm.objects.contacts.read",
          "crm.objects.contacts.write"
        ],
        "maxItems": 1,
        "minIntervalMs": 500,
        "timeoutMs": 15000
      },
      "fixtures": [
        {
          "name": "calls search_crm_objects",
          "kind": "safe",
          "arguments": {
            "objectType": "contacts",
            "query": "acme"
          },
          "expect": {
            "facts": {
              "class": "read",
              "object": {
                "state": "known",
                "value": "record"
              },
              "scope": {
                "state": "known",
                "value": "query_selected"
              }
            },
            "decisions": {
              "balanced": "allow",
              "relaxed": "allow",
              "strict": "allow"
            }
          }
        },
        {
          "name": "refuses arguments over the size bound",
          "kind": "risky",
          "arguments": {
            "payload": ""
          },
          "expect": {
            "error": "open_arguments_too_large"
          }
        }
      ]
    },
    {
      "actionId": "hubspot-mcp.get_crm_objects",
      "title": "Read CRM records",
      "link": {
        "tool": "get_crm_objects"
      },
      "executor": {
        "kind": "remote-mcp",
        "tool": "get_crm_objects"
      },
      "arguments": {},
      "openArguments": {
        "maxBytes": 8192
      },
      "facts": {
        "class": "read",
        "object": {
          "const": "record"
        },
        "scope": {
          "const": "enumerated"
        }
      },
      "response": {
        "maxBytes": 262144,
        "fields": [
          {
            "name": "content",
            "value": {
              "from": "content"
            },
            "untrusted": true
          }
        ]
      },
      "safety": {
        "effect": "read",
        "requiredCapabilities": [
          "bounded-output",
          "egress-pinned"
        ],
        "idempotency": "safe-read",
        "scopes": [
          "crm.objects.contacts.read",
          "crm.objects.contacts.write"
        ],
        "maxItems": 1,
        "minIntervalMs": 500,
        "timeoutMs": 15000
      },
      "fixtures": [
        {
          "name": "calls get_crm_objects",
          "kind": "safe",
          "arguments": {
            "objectType": "contacts",
            "objectIds": [
              "101"
            ]
          },
          "expect": {
            "facts": {
              "class": "read",
              "object": {
                "state": "known",
                "value": "record"
              },
              "scope": {
                "state": "known",
                "value": "enumerated"
              }
            },
            "decisions": {
              "balanced": "allow",
              "relaxed": "allow",
              "strict": "allow"
            }
          }
        },
        {
          "name": "refuses arguments over the size bound",
          "kind": "risky",
          "arguments": {
            "payload": ""
          },
          "expect": {
            "error": "open_arguments_too_large"
          }
        }
      ]
    }
  ]
}
