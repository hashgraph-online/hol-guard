{
  "schemaVersion": "guard.mcp-server-contribution.v1",
  "id": "mcp.garmin-coach-mcp",
  "version": "1.0.0",
  "name": "Garmin Coach MCP",
  "description": "Reads Garmin Connect data (sleep, health metrics, activities, training load) and writes structured workouts to the Garmin calendar. Four tools change the account: create, schedule, unschedule and delete workouts. Off until you turn it on.",
  "trustClass": "external",
  "activation": "opt-in",
  "publisher": {
    "id": "io.github.yeisonfjrd",
    "displayName": "Yeison Fajardo",
    "url": "https://github.com/Yeisonfjrd"
  },
  "icon": {
    "kind": "react-icon",
    "name": "HiMiniBolt",
    "background": "#2E1065"
  },
  "homepage": "https://github.com/Yeisonfjrd/garmin-coach-mcp",
  "license": "MIT",
  "launch": {
    "kind": "package-launcher",
    "command": "npx",
    "package": "garmin-coach-mcp"
  },
  "riskClasses": [
    "external-network-read",
    "external-shared-state-write",
    "external-content-deletion",
    "local-file-write",
    "package-or-source-installation"
  ],
