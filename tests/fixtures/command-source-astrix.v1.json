              "permission_id": "command.astrix.permission.read-only",
              "title": "Astrix read-only command",
              "description": "Matches only supported inspection subcommands; test execution, repair, initialization, and other commands are separate or out of scope.",
              "severity": "low",
              "risk_classes": [
                "read_local"
              ],
              "action_classes": [
                "Astrix read-only inspection command"
              ],
              "safer_alternatives": [
                "Keep this contribution limited to the supported inspection subcommands."
              ],
              "default_mode": "disabled",
              "family": null,
              "native_capability": null,
              "matcher": {
                "op": "any.v1",
                "config": {},
                "matchers": [
                  {
                    "op": "executable.v1",
                    "config": {
                      "executables": [
                        "astrix",
                        "astrix.exe",
                        "astrix.cmd"
                      ],
                      "subcommands": [
                        "check"
                      ],
                      "allow_leading_options": false,
                      "leading_options_with_values": [],
                      "interspersed_options_with_values": [],
                      "interspersed_flags": [],
                      "fail_secure_unknown_options": true,
                      "required_flags": [],
                      "required_flags_in_all_arguments": false,
                      "required_option_values": [],
                      "forbidden_flags": [],
                      "inverse_flag_pairs": [],
                      "options_with_values": []
