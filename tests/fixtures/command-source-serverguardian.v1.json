      {
        "schema": "guard.command-extension-source.v1",
        "extension": {
          "extension_id": "command.serverguardian",
          "version": "1.0.0",
          "name": "Server Guardian command protection",
          "description": "Reviews direct Server Guardian daemon starts, manual nightly maintenance, and configuration after local opt-in. Status checks do not match these rules. Operations inside the interactive dashboard or already-running daemon are outside command-level coverage.",
          "action_classes": [
            "Server Guardian maintenance command",
            "Server Guardian configuration command"
          ],
          "risk_classes": [
            "execution",
            "data_modification"
          ],
          "safer_alternatives": [
            "Check daemon status and inspect the scheduled maintenance settings before starting maintenance."
          ],
          "reference_urls": [
            "https://github.com/GonnyTech/ServerManager/blob/76fa1fed37dfe0ee696d313fca4186514769bf8d/server_guardian/cli.py",
            "https://github.com/GonnyTech/ServerManager/blob/76fa1fed37dfe0ee696d313fca4186514769bf8d/pyproject.toml"
          ],
          "required": false,
          "source": "built-in",
          "aliases": [],
          "dependencies": [],
          "conflicts": [],
          "ecosystem_ids": [
            "server-guardian"
          ],
          "executables": [
            "server-guardian"
          ],
          "project_markers": [],
          "publisher": {
            "id": "community.serverguardian",
            "display_name": "Server Guardian community",
            "url": "https://github.com/GonnyTech/ServerManager"
          },
          "homepage": "https://github.com/GonnyTech/ServerManager",
          "license": "MIT",
          "icon": {
            "kind": "none"
          },
