      {
        "action_classes": [
          "rungs gate execution command"
        ],
        "baseline_floor": "review",
        "configurable": true,
        "conflicts": [],
        "default_enabled": true,
        "dependencies": [],
        "deprecated": false,
        "description": "Identifies `rungs check`, which executes every command gate registered in .ai/gates.toml \u2014 commands the repository owns, not rungs \u2014 and appends one line per gate to the local .ai/.gate-ledger.jsonl. check has no preview form; --dry-run is not read.",
        "example_command": "rungs check",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "label": "rungs gate execution",
        "permission_id": "command.rungs.permission.check",
        "replacement_permission_id": null,
        "risk_tier": "high",
        "safer_guidance": [
          "Read .ai/gates.toml first; each `kind = \"command\"` gate is a repository-owned command that will run.",
          "Use `rungs doctor --explain` to run the in-process detectors without executing any command gate."
        ],
        "typed_capabilities": []
      },
      {
        "action_classes": [
          "rungs module install command"
        ],
        "baseline_floor": "review",
        "configurable": true,
        "conflicts": [],
        "default_enabled": true,
        "dependencies": [],
        "deprecated": false,
        "description": "Identifies `rungs add`, which writes module files, the gate registry, the install record and the rendered harness instruction files into the target repository. `--dry-run` reports the same plan and writes nothing, and is the only preview form.",
        "example_command": "rungs add backlog",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "label": "rungs module install",
        "permission_id": "command.rungs.permission.add",
        "replacement_permission_id": null,
        "risk_tier": "high",
        "safer_guidance": [
          "Run `rungs add <module> --dry-run` first: it prints every file, gate and record it would write.",
          "Run `rungs doctor` to see what the repository already has before installing over it."
        ],
        "typed_capabilities": []
      },
      {
        "action_classes": [
          "rungs module upgrade command"
        ],
        "baseline_floor": "review",
        "configurable": true,
        "conflicts": [],
        "default_enabled": true,
        "dependencies": [],
        "deprecated": false,
        "description": "Identifies `rungs upgrade --apply`, which rewrites stale and missing module files, replaces gate registry blocks and updates the install record. Without --apply, upgrade only prints the plan; it never reads --dry-run, so `--apply --dry-run` still writes.",
        "example_command": "rungs upgrade --apply",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "label": "rungs module upgrade",
        "permission_id": "command.rungs.permission.upgrade",
        "replacement_permission_id": null,
        "risk_tier": "high",
        "safer_guidance": [
          "Run `rungs upgrade` without --apply: it prints the stale, missing and diverged files and writes nothing."
        ],
        "typed_capabilities": []
      }
