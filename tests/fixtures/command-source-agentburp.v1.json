              "default_mode": "review",
              "permission_id": "command.agentburp.permission.project-modify",
              "safe_variants": [],
              "matcher": {
                "op": "any.v1",
                "config": {},
                "matchers": [
                  {
                    "op": "leading-subcommand.v1",
                    "config": {
                      "executables": [
                        "agentburp",
                        "agentburp.cmd",
                        "agentburp.exe"
                      ],
                      "subcommands": [
                        "project",
                        "create"
