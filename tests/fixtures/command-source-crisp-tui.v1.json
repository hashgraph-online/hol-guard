                "op": "any.v1",
                "config": {},
                "matchers": [
                  {
                    "op": "executable.v1",
                    "config": {
                      "allow_leading_options": false,
                      "executables": [
                        "crisp-tui",
                        "crisp-tui.cmd",
                        "crisp-tui.exe"
                      ],
                      "fail_secure_unknown_options": true,
