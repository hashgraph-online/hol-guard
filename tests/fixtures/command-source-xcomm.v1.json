          "risk_classes": [
            "execution",
            "local_write"
          ],
          "rules": [
            {
              "action_classes": [
                "xcomm serial device input"
              ],
              "default_mode": "review",
              "description": "Identifies xcomm ctl send and ctl run, which put text, --hex bytes or a --file's bytes on the serial line. Matches the subcommand word anywhere in an xcomm ctl invocation before `--`, because the device name (or --pane) comes between ctl and the subcommand and the word can follow options. Two limits follow. A subcommand after `--` (xcomm ctl -- ttyUSB1 send ls) is not seen, so it keeps only the unknown-executable review floor and a disabled permission does not block it. A matching word elsewhere in the line counts as the subcommand: option text or a wait pattern (--fail-on set, wait run), the text of a send or run (send set), or xfer's direction (xfer send also hits device input). A disabled permission then also blocks that command; this fails closed. dtr, rts, xfer and capture also need the word xcomm requires after them (on/off/toggle/pulse, send/recv, start/stop), so a status field such as status capture does not match. No help-flag exemption is granted: xcomm takes the word after a value option as its value, so --help can be a --until pattern while the send still happens. xcomm ctl status, read, wait and sessions only observe the session and are outside these rules.",
              "matcher": {
                "config": {},
                "matchers": [
                  {
                    "config": {
                      "executables": [
                        "xcomm"
                      ],
                      "required_arguments": [
                        "ctl",
                        "send"
                      ]
                    },
                    "op": "arguments.v1"
                  },
                  {
                    "config": {
                      "executables": [
                        "xcomm"
                      ],
                      "required_arguments": [
                        "ctl",
                        "run"
                      ]
                    },
                    "op": "arguments.v1"
                  }
                ],
                "op": "any.v1"
              },
              "permission_id": "command.xcomm.permission.device-input",
              "risk_classes": [
                "execution"
              ],
              "rule_id": "command.xcomm.device-input",
              "rule_version": "1.0.0",
              "safe_variants": [],
              "safer_alternatives": [
                "Use xcomm ctl <device> wait or read to observe the board without sending."
              ],
              "severity": "high",
              "title": "xcomm serial device input"
            },
            {
              "action_classes": [
                "xcomm serial line control"
              ],
              "default_mode": "review",
              "description": "Identifies xcomm ctl break, dtr, rts and set. Matches the subcommand word anywhere in an xcomm ctl invocation before `--`, because the device name (or --pane) comes between ctl and the subcommand and the word can follow options. Two limits follow. A subcommand after `--` (xcomm ctl -- ttyUSB1 send ls) is not seen, so it keeps only the unknown-executable review floor and a disabled permission does not block it. A matching word elsewhere in the line counts as the subcommand: option text or a wait pattern (--fail-on set, wait run), the text of a send or run (send set), or xfer's direction (xfer send also hits device input). A disabled permission then also blocks that command; this fails closed. dtr, rts, xfer and capture also need the word xcomm requires after them (on/off/toggle/pulse, send/recv, start/stop), so a status field such as status capture does not match.",
              "matcher": {
                "config": {},
                "matchers": [
                  {
                    "config": {
                      "executables": [
                        "xcomm"
                      ],
                      "required_arguments": [
