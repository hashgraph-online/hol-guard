        "description": "Identifies mcp-guard lock, which writes the trusted baseline that later inspect --lock and proxy --lock runs compare against.",
        "example_command": "mcp-guard lock mcp.json -o mcp-guard.lock",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
