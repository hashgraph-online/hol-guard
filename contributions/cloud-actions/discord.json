{
  "schema": "guard.cloud-action-pack.v1",
  "provider": {
    "id": "discord",
    "name": "Discord",
    "publisher": {
      "name": "HOL",
      "verified": true
    }
  },
  "hosts": [
    "discord.com"
  ],
  "auth": {
    "mode": "api-key",
    "scopes": [
      "bot"
    ]
  },
  "actions": [
    {
      "actionId": "discord.messages.create",
      "title": "Post a message to a channel",
      "executor": {
        "kind": "declarative-http",
        "request": {
          "method": "POST",
          "host": "discord.com",
          "path": "/api/v10/channels/{channel_id}/messages",
          "headers": [
            {
              "name": "accept",
              "value": "application/json"
            }
          ],
          "body": {
            "object": [
              {
                "name": "content",
                "value": {
                  "arg": "content"
                }
              },
              {
                "name": "allowed_mentions",
                "value": {
                  "object": [
                    {
                      "name": "parse",
                      "value": {
                        "const": []
                      }
                    }
                  ]
                }
              }
            ]
          },
          "maxPages": 1
        }
      },
      "arguments": {
        "channel_id": {
          "type": "string",
          "required": true,
          "maxLength": 20,
          "pattern": "^[0-9]{17,20}$"
        },
        "content": {
          "type": "string",
          "required": true,
          "maxLength": 2000
        }
      },
      "facts": {
        "class": "send",
        "object": {
          "const": "message"
        },
        "scope": {
          "const": "single"
        },
        "reversibility": {
          "const": "reversible"
        },
        "recordCount": {
          "const": 1
        }
      },
      "response": {
        "maxBytes": 131072,
        "fields": [
          {
            "name": "id",
            "value": {
              "from": "id"
            }
          },
          {
            "name": "content",
            "value": {
              "from": "content"
            },
            "untrusted": true
          }
        ]
      },
      "safety": {
        "effect": "write",
        "requiredCapabilities": [
          "bounded-output",
          "egress-pinned"
        ],
        "idempotency": "none",
        "scopes": [
          "bot"
        ],
        "maxItems": 1,
        "minIntervalMs": 1000,
        "timeoutMs": 15000
      },
      "fixtures": [
        {
          "name": "posts a message with mentions turned off",
          "kind": "safe",
          "arguments": {
            "channel_id": "1234567890123456789",
            "content": "Build 42 is green. @everyone"
          },
          "expect": {
            "facts": {
              "class": "send"
            },
            "request": {
              "body": "{\"content\":\"Build 42 is green. @everyone\",\"allowed_mentions\":{\"parse\":[]}}",
              "headers": [
                [
                  "accept",
                  "application/json"
                ],
                [
                  "content-type",
                  "application/json; charset=utf-8"
                ]
              ],
              "maxPages": 1,
              "method": "POST",
              "url": "https://discord.com/api/v10/channels/1234567890123456789/messages"
            },
            "decisions": {
              "relaxed": "allow",
              "balanced": "review",
              "strict": "review"
            }
          }
        },
        {
          "name": "refuses a message over 2000 characters",
          "kind": "risky",
          "arguments": {
            "channel_id": "1234567890123456789",
            "content": ""
          },
          "expect": {
            "error": "invalid_argument"
          }
        }
      ]
    },
    {
      "actionId": "discord.messages.delete",
      "title": "Delete a message",
      "executor": {
        "kind": "declarative-http",
        "request": {
          "method": "DELETE",
          "host": "discord.com",
          "path": "/api/v10/channels/{channel_id}/messages/{message_id}",
          "headers": [
            {
              "name": "accept",
              "value": "application/json"
            }
          ],
          "maxPages": 1
        }
      },
      "arguments": {
        "channel_id": {
          "type": "string",
          "required": true,
          "maxLength": 20,
          "pattern": "^[0-9]{17,20}$"
        },
        "message_id": {
          "type": "string",
          "required": true,
          "maxLength": 20,
          "pattern": "^[0-9]{17,20}$"
        }
      },
      "facts": {
        "class": "delete",
        "object": {
          "const": "message"
        },
        "scope": {
          "const": "single"
        },
        "reversibility": {
          "const": "permanent"
        },
        "recordCount": {
          "const": 1
        }
      },
      "response": {
        "maxBytes": 65536,
        "emptyOk": true,
        "fields": [
          {
            "name": "message",
            "value": {
              "from": "message"
            },
            "untrusted": true
          }
        ]
      },
      "safety": {
        "effect": "destructive",
        "requiredCapabilities": [
          "bounded-output",
          "egress-pinned"
        ],
        "idempotency": "none",
        "scopes": [
          "bot"
        ],
        "maxItems": 1,
        "minIntervalMs": 3000,
        "timeoutMs": 15000
      },
      "fixtures": [
        {
          "name": "deletes one message",
          "kind": "safe",
          "arguments": {
            "channel_id": "1234567890123456789",
            "message_id": "1234567890123456790"
          },
          "expect": {
            "facts": {
              "class": "delete"
            },
            "request": {
              "body": null,
              "headers": [
                [
                  "accept",
                  "application/json"
                ]
              ],
              "maxPages": 1,
              "method": "DELETE",
              "url": "https://discord.com/api/v10/channels/1234567890123456789/messages/1234567890123456790"
            },
            "decisions": {
              "relaxed": "review",
              "balanced": "review",
              "strict": "block"
            }
          }
        },
        {
          "name": "refuses a message id that is not a snowflake",
          "kind": "risky",
          "arguments": {
            "channel_id": "1234567890123456789",
            "message_id": "@me"
          },
          "expect": {
            "error": "invalid_argument"
          }
        }
      ]
    },
    {
      "actionId": "discord.messages.bulk_delete",
      "title": "Delete many messages at once",
      "executor": {
        "kind": "declarative-http",
        "request": {
          "method": "POST",
          "host": "discord.com",
          "path": "/api/v10/channels/{channel_id}/messages/bulk-delete",
          "headers": [
            {
              "name": "accept",
              "value": "application/json"
            }
          ],
          "body": {
            "object": [
              {
                "name": "messages",
                "value": {
                  "arg": "message_ids"
                }
              }
            ]
          },
          "maxPages": 1
        }
      },
      "arguments": {
        "channel_id": {
          "type": "string",
          "required": true,
          "maxLength": 20,
          "pattern": "^[0-9]{17,20}$"
        },
        "message_ids": {
          "type": "array",
          "required": true,
          "minItems": 2,
          "maxItems": 100,
          "items": {
            "maxLength": 20,
            "pattern": "^[0-9]{17,20}$"
          }
        }
      },
      "facts": {
        "class": "delete",
        "object": {
          "const": "message"
        },
        "scope": {
          "const": "query_selected"
        },
        "reversibility": {
          "const": "permanent"
        },
        "recordCount": {
          "count": {
            "arguments": [
              "message_ids"
            ]
          }
        }
      },
      "response": {
        "maxBytes": 65536,
        "emptyOk": true,
        "fields": [
          {
            "name": "message",
            "value": {
              "from": "message"
            },
            "untrusted": true
          }
        ]
      },
