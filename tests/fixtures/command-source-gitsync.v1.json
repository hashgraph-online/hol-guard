                        "--help",
                        "-h"
                      ],
                      "interspersed_options_with_values": [],
                      "inverse_flag_pairs": [],
                      "leading_options_with_values": [
                        "-c"
                      ],
                      "options_with_values": [],
                      "required_flags": [],
                      "required_flags_in_all_arguments": false,
                      "required_option_values": [],
                      "subcommands": [
                        "sync"
                      ]
                    },
                    "op": "executable.v1"
                  },
                  {
                    "config": {
                      "allow_leading_options": true,
                      "executables": [
                        "gitsync",
                        "gitsync.exe"
                      ],
                      "fail_secure_unknown_options": true,
                      "forbidden_flags": [],
                      "interspersed_flags": [
                        "--help",
                        "-h"
                      ],
                      "interspersed_options_with_values": [],
                      "inverse_flag_pairs": [],
                      "leading_options_with_values": [
                        "-c"
                      ],
                      "options_with_values": [],
                      "required_flags": [],
                      "required_flags_in_all_arguments": false,
                      "required_option_values": [],
                      "subcommands": [
                        "run"
                      ]
                    },
                    "op": "executable.v1"
                  }
                ],
                "op": "any.v1"
              },
              "native_capability": null,
