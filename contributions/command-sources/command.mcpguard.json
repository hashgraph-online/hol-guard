        "permission_id": "command.mcpguard.permission.server-launch",
        "replacement_permission_id": null,
        "risk_tier": "high",
        "safer_guidance": [
          "Audit the config statically first: mcp-guard inspect CONFIG reads the file and starts nothing.",
          "Check which command each server entry runs before allowing --live, proxy or test-injection --run."
        ],
        "typed_capabilities": []
      },
      {
        "action_classes": [
          "mcp-guard lock approval command"
        ],
        "baseline_floor": "review",
