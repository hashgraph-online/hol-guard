    {
      "actionId": "huggingface-mcp.hub_repo_search",
      "title": "Search Hugging Face repositories",
      "link": {
        "tool": "hub_repo_search"
      },
      "executor": {
        "kind": "remote-mcp",
        "tool": "hub_repo_search"
      },
      "arguments": {},
      "openArguments": {
        "maxBytes": 8192
      },
      "facts": {
        "class": "read",
        "object": {
          "const": "repository"
        },
        "scope": {
          "const": "query_selected"
        }
      },
      "response": {
        "maxBytes": 262144,
        "fields": [
          {
            "name": "content",
            "value": {
              "from": "content"
            },
            "untrusted": true
          }
        ]
      },
      "safety": {
        "effect": "read",
        "requiredCapabilities": [
          "bounded-output",
          "egress-pinned"
        ],
        "idempotency": "safe-read",
        "scopes": [
          "openid"
        ],
        "maxItems": 1,
        "minIntervalMs": 500,
        "timeoutMs": 15000
      },
      "fixtures": [
        {
          "name": "calls hub_repo_search",
          "kind": "safe",
          "arguments": {
            "query": "whisper",
            "repo_types": [
              "model"
            ]
          },
          "expect": {
            "facts": {
              "class": "read",
              "object": {
                "state": "known",
                "value": "repository"
              },
              "scope": {
                "state": "known",
                "value": "query_selected"
              }
            },
            "decisions": {
              "balanced": "allow",
              "relaxed": "allow",
              "strict": "allow"
            }
          }
        },
        {
          "name": "refuses an argument name the tool cannot declare",
          "kind": "risky",
          "arguments": {
            "$where": "1"
          },
          "expect": {
            "error": "unknown_argument"
          }
        }
      ]
    },
