{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hol-guard.example/benchmark/ci-runner-config.v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "id", "campaign", "policy", "selection", "shards", "assets", "runtime", "provider"],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096},
    "document": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha"}}
    },
    "asset": {
      "type": "object", "additionalProperties": false, "required": ["path", "kind", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha"},
        "kind": {"enum": ["file", "sdk-tree", "guard-prefix"]}
      }
    }
  },
  "properties": {
    "schema": {"const": "gauntlet-ci-runner.v1"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "campaign": {"$ref": "#/$defs/document"}, "policy": {"$ref": "#/$defs/document"},
    "selection": {
      "type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"}
    },
    "shards": {"type": "integer", "minimum": 1, "maximum": 64},
    "assets": {
      "type": "object", "minProperties": 10, "maxProperties": 11,
      "propertyNames": {"enum": ["bun", "node", "wheel", "native", "policy", "compiler", "model_manifest", "provider_manifest", "sdk", "guard_prefix", "zod_cache"]},
      "additionalProperties": {"$ref": "#/$defs/asset"}
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "base_url", "guard_source_sha", "guard_bwrap_sha256", "guard_executor_image_id"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "base_url": {"type": "string", "minLength": 1, "maxLength": 256},
        "guard_source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "guard_bwrap_sha256": {"$ref": "#/$defs/sha"},
        "guard_executor_image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "quota_config_digest", "model_identity_digest", "binding_sha256", "adapter_sha256", "server_sha256", "token_cap", "maximum_requests"],
      "properties": {
        "profile": {"const": "owned-mlx-serial.v1"},
        "quota_config_digest": {"$ref": "#/$defs/sha"}, "model_identity_digest": {"$ref": "#/$defs/sha"},
        "quota_allowance_digest": {"$ref": "#/$defs/sha"},
        "binding_sha256": {"$ref": "#/$defs/sha"}, "adapter_sha256": {"$ref": "#/$defs/sha"}, "server_sha256": {"$ref": "#/$defs/sha"},
        "token_cap": {"type": "integer", "minimum": 1, "maximum": 1000000000},
        "maximum_requests": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    }
  }
}
