{
  "schemaVersion": "guard.browser-driver.v1",
  "id": "browser.chrome-devtools-mcp",
  "name": "Chrome DevTools MCP",
  "publisher": {
    "name": "HOL Guard",
    "url": "https://github.com/hashgraph-online/hol-guard",
    "verified": true
  },
  "referenceUrls": [
    "https://github.com/ChromeDevTools/chrome-devtools-mcp"
  ],
  "match": {
    "mcpServerNames": [
      "chrome-devtools"
    ],
    "packages": [
      "chrome-devtools-mcp",
      "@modelcontextprotocol/server-chrome-devtools"
    ],
    "toolNamespaces": [
      "mcp__chrome-devtools__"
    ],
    "harnessTools": []
  },
  "profileMode": {
    "default": "unknown",
    "flags": {
      "isolated": [
        "--isolated",
        "--isolated-context"
      ],
      "dedicated": [
        "--user-data-dir",
        "--persistent",
        "--profile-dir",
        "--storage-state"
      ],
      "shared": [
        "--shared",
        "--no-isolated"
      ],
      "remoteDebugging": [
        "--remote-debugging-port",
        "--remote-debugging-pipe",
        "--ws-endpoint"
      ]
    }
  },
