{
  "schemaVersion": "guard.mcp-server-contribution.v1",
  "id": "mcp.insumer",
  "version": "1.0.0",
  "name": "InsumerAPI MCP",
  "description": "Reviews the InsumerAPI tools that register a payment, create an API key or merchant, or replace a merchant's configuration and public listing. Verification tools, which return signed yes or no results about wallet conditions, keep Guard's usual handling. Off until you turn it on.",
  "trustClass": "external",
  "activation": "opt-in",
  "publisher": {
    "id": "insumermodel.com",
    "displayName": "InsumerAPI",
    "url": "https://insumermodel.com"
  },
  "icon": { "kind": "react-icon", "name": "HiMiniGlobeAlt", "background": "#111827" },
  "homepage": "https://insumermodel.com/developers/",
  "license": "MIT",
  "launch": {
    "kind": "package-launcher",
    "command": "npx",
    "package": "mcp-server-insumer"
  },
  "riskClasses": [
    "external-payment-registration",
    "external-account-creation",
    "external-merchant-config-write",
    "external-public-listing"
  ],
  "tools": [
    { "name": "insumer_buy_key", "state": "review" },
    { "name": "insumer_buy_credits", "state": "review" },
    { "name": "insumer_buy_merchant_credits", "state": "review" },
    { "name": "insumer_confirm_payment", "state": "review" },
    { "name": "insumer_setup", "state": "review" },
    { "name": "insumer_create_merchant", "state": "review" },
    { "name": "insumer_configure_tokens", "state": "review" },
    { "name": "insumer_configure_nfts", "state": "review" },
    { "name": "insumer_configure_settings", "state": "review" },
    { "name": "insumer_publish_directory", "state": "review" },
    { "name": "other", "state": "inherit" }
  ],
  "referenceUrls": [
    "https://insumermodel.com/developers/",
    "https://github.com/insumerapi/mcp-server-insumer",
    "https://www.npmjs.com/package/mcp-server-insumer"
  ],
  "saferAlternatives": [
    "Use insumer_credits, insumer_merchant_status and insumer_check_discount to inspect state before a tool that registers a payment or replaces configuration."
  ]
}
