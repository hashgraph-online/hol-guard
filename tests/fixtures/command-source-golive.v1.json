{
  "build": {
    "base": "packaged",
    "schema": "guard.command-extension-build.v1",
    "sources": [
      {
        "extension": {
          "action_classes": [
            "GoLive confirmed resource deletion",
            "GoLive confirmed live write",
            "GoLive confirmed DNS change"
          ],
          "aliases": [],
          "conflicts": [],
          "dependencies": [],
          "description": "Reviews the GoLive plan executions that carry an explicit destructive or live confirmation flag. GoLive already refuses account writes without an approved plan id, recomputes that plan's identity before running, and deletes only resources it recorded as its own; the confirmation flags themselves are passed by the caller on the human's behalf, so `golive apply` with --confirm-destroy, --confirm-live or --confirm-dns is where an independent review adds something. The read-only surface (`golive help`, `version`, `update-check`, `detect`, `menu`, `doctor`, `plan`, `teardown`, `verify`, `status`, `handoff`) is outside these rules: `teardown` is the inverse plan and deletes nothing, and `plan` is what prints the plan id a human approves.",
          "ecosystem_ids": [],
          "executables": [
            "golive",
            "golive.cmd",
            "golive.exe"
          ],
          "extension_id": "command.golive",
          "homepage": "https://github.com/mikehasa/golive-skill",
          "icon": {
            "kind": "none"
          },
          "license": "MIT",
          "name": "GoLive deployment CLI protection",
          "permissions": [
            {
              "action_classes": [
                "GoLive confirmed resource deletion"
              ],
              "baseline_floor": "review",
              "configurable": true,
              "conflicts": [],
              "default_enabled": true,
              "dependencies": [],
              "deprecated": false,
              "description": "Identifies `golive apply` with --confirm-destroy, the only invocation that deletes resources GoLive recorded as its own (a host project it created, DNS records it wrote, webhook endpoints and sending keys it issued). GoLive refuses those deletions without an approved teardown plan id and this flag, and reports every resource it cannot prove it created as a manual handoff instead of deleting it.",
              "example_command": "golive apply --plan 8f3c1d2a4b5e --yes --confirm-destroy",
              "family": null,
              "fixed_reason": null,
              "implementation_version": "1.0.0",
              "implied_permissions": [],
              "introduced_version": "1.0.0",
              "label": "GoLive teardown execution",
              "permission_id": "command.golive.permission.apply-confirm-destroy",
              "replacement_permission_id": null,
              "risk_tier": "critical",
              "safer_guidance": [
                "Pause for the human before the deletion: show the teardown plan (`golive teardown`) and the exact plan id, and let them say whether this deletion happens now."
              ],
              "typed_capabilities": []
            },
            {
              "action_classes": [
                "GoLive confirmed live write"
              ],
              "baseline_floor": "review",
              "configurable": true,
              "conflicts": [],
              "default_enabled": true,
              "dependencies": [],
              "deprecated": false,
              "description": "Identifies `golive apply` with --confirm-live: live-mode payments, production data, a real account (a seeded test user or a signup probe), a password rotation, or a project's first production deploy. GoLive keeps this separate from plan approval on purpose, so plan approval alone never authorizes the first write to a live destination.",
              "example_command": "golive apply --plan 8f3c1d2a4b5e --yes --confirm-live",
              "family": null,
              "fixed_reason": null,
              "implementation_version": "1.0.0",
              "implied_permissions": [],
              "introduced_version": "1.0.0",
              "label": "GoLive live write execution",
              "permission_id": "command.golive.permission.apply-confirm-live",
              "replacement_permission_id": null,
              "risk_tier": "high",
              "safer_guidance": [
                "Pause for the human: name the live-mode destination the step preview lists (payments, production data, the first production deploy) and let them approve that specific write."
              ],
              "typed_capabilities": []
            },
            {
              "action_classes": [
                "GoLive confirmed DNS change"
              ],
              "baseline_floor": "review",
              "configurable": true,
              "conflicts": [],
              "default_enabled": true,
              "dependencies": [],
              "deprecated": false,
              "description": "Identifies `golive apply` with --confirm-dns: creating or changing DNS records at an automated DNS provider, including records that make a domain resolve to the new deployment. GoLive refuses these writes without the flag and shows every record in the step preview first.",
              "example_command": "golive apply --plan 8f3c1d2a4b5e --yes --confirm-dns",
              "family": null,
              "fixed_reason": null,
              "implementation_version": "1.0.0",
              "implied_permissions": [],
              "introduced_version": "1.0.0",
              "label": "GoLive DNS change execution",
              "permission_id": "command.golive.permission.apply-confirm-dns",
              "replacement_permission_id": null,
              "risk_tier": "critical",
              "safer_guidance": [
                "Pause for the human: show the records the plan prints, including any record it would replace, and confirm the zone and domain before they answer."
              ],
              "typed_capabilities": []
            }
          ],
          "project_markers": [
            "golive.yaml"
          ],
