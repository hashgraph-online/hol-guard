{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hol.org/guard/contracts/extension-listing.v2.schema.json",
  "title": "HOL Guard extension contributor listing metadata",
  "description": "Bounded public credit and provenance metadata. contributors is attribution only; maintainerGithubIds remains separately reviewed claim-authority input and validation does not grant authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "extensionId",
    "tagline",
    "category",
    "limitations",
    "summary",
    "contributors",
    "originalContributions",
    "upstream"
  ],
  "properties": {
    "schemaVersion": { "const": "guard.extension-listing.v2" },
    "extensionId": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(command|mcp)\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "tagline": { "type": "string", "minLength": 10, "maxLength": 140 },
    "summary": { "type": "string", "minLength": 20, "maxLength": 2048 },
    "category": {
      "enum": [
        "core-safety",
        "cloud-infrastructure",
        "data-resilience",
        "delivery-remote",
        "managed-services",
        "package-supply-chain",
        "specialized-tools",
        "other"
      ]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 10, "maxLength": 400 }
    },
    "documentationUrl": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1024,
      "pattern": "^https://",
      "format": "uri"
    },
    "tags": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 30,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "maintainerGithubIds": {
      "description": "Reviewed numeric GitHub IDs authorized to manage a publisher profile. Credits and pull-request authorship never grant this authority.",
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" }
    },
    "contributors": {
      "description": "Public credit only. These identities cannot authorize a claim.",
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["githubId", "githubLogin", "roles"],
        "properties": {
          "githubId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
          "githubLogin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,98}[A-Za-z0-9])?$"
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": { "enum": ["author", "co-author", "reviewer", "maintainer"] }
          }
        }
      }
    },
    "originalContributions": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "url"],
        "properties": {
          "kind": { "enum": ["pull-request", "issue", "commit", "discussion"] },
          "url": { "type": "string", "minLength": 10, "maxLength": 1024, "pattern": "^https://", "format": "uri" }
        }
      }
    },
    "upstream": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "url"],
          "properties": {
            "name": { "type": "string", "minLength": 2, "maxLength": 160 },
            "url": { "type": "string", "minLength": 10, "maxLength": 1024, "pattern": "^https://", "format": "uri" }
          }
        }
      ]
    }
  }
}
