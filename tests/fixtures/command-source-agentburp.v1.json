              "risk_tier": "medium",
              "baseline_floor": "review",
              "default_enabled": true,
              "configurable": true,
              "typed_capabilities": [],
              "action_classes": [
                "AgentBurp project modification"
              ],
              "dependencies": [],
              "conflicts": [],
              "implied_permissions": [],
