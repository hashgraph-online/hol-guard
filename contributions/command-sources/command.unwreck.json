    "rules": [
      {
        "action_classes": [
          "Unwreck state and snapshot mutation command"
        ],
        "default_mode": "review",
        "description": "Identifies Unwreck 0.1.0 operations that restore or modify project files, persist or delete local snapshots, or open the interactive restore interface. Help and explicit dry-run commands narrow this rule.",
        "family": null,
        "matcher": {
          "op": "any.v1",
          "config": {},
          "matchers": [
            {
              "op": "executable.v1",
              "config": {
                "allow_leading_options": true,
                "executables": [
                  "unwreck",
                  "unwreck.exe"
                ],
                "fail_secure_unknown_options": true,
                "forbidden_flags": [],
                "interspersed_flags": [],
                "interspersed_options_with_values": [],
                "inverse_flag_pairs": [],
                "leading_options_with_values": [
                  "--root"
                ],
                "options_with_values": [
                  "--only",
                  "--keep",
                  "--message",
                  "-m",
                  "--quiet-ms"
                ],
                "required_flags_in_all_arguments": false,
                "required_option_values": [],
                "subcommands": [
                  "restore",
                  "undo",
                  "redo",
                  "gc",
                  "snap",
                  "watch",
                  "tui"
                ]
              }
            }
          ]
        },
        "native_capability": null,
