{
  "schema": "guard.cloud-action-pack.v1",
  "provider": {
    "id": "mailchimp",
    "name": "Mailchimp",
    "publisher": {
      "name": "HOL",
      "verified": true
    }
  },
  "hosts": [
    "{dc}.api.mailchimp.com"
  ],
  "auth": {
    "mode": "oauth2",
    "scopes": [
      "api"
    ]
  },
  "connection": {
    "values": {
      "dc": {
        "title": "Mailchimp data centre",
        "pattern": "^[a-z]{2}[0-9]{1,3}$",
        "maxLength": 5
      }
    }
  },
  "transports": {
    "partner": [
      {
        "partner": "composio",
        "toolkit": "mailchimp"
      }
    ]
  },
  "actions": [
    {
      "actionId": "mailchimp.lists.get",
      "title": "Read an audience",
      "executor": {
        "kind": "declarative-http",
        "request": {
          "method": "GET",
          "host": "{dc}.api.mailchimp.com",
          "path": "/3.0/lists/{list_id}",
          "headers": [
            {
              "name": "accept",
              "value": "application/json"
            }
          ],
          "query": [
            {
              "name": "fields",
              "value": {
                "const": "id,name,stats.member_count"
              }
            }
          ],
          "maxPages": 1
        }
      },
      "arguments": {
        "list_id": {
          "type": "string",
          "required": true,
          "maxLength": 10,
          "pattern": "^[0-9a-f]{10}$"
        }
      },
      "facts": {
        "class": "read",
        "object": {
          "const": "record"
        },
        "scope": {
          "const": "single"
        },
        "recordCount": {
          "const": 1
        }
      },
      "response": {
        "maxBytes": 131072,
        "fields": [
          {
            "name": "id",
            "value": {
              "from": "id"
            }
          },
          {
            "name": "name",
            "value": {
              "from": "name"
            },
            "untrusted": true
          },
          {
            "name": "member_count",
            "value": {
              "from": "stats.member_count"
            }
          },
          {
            "name": "error_title",
            "value": {
              "from": "title"
            },
            "untrusted": true
          },
          {
            "name": "error_detail",
            "value": {
              "from": "detail"
            },
            "untrusted": true
          }
        ]
      },
      "safety": {
        "effect": "read",
        "requiredCapabilities": [
          "bounded-output",
          "egress-pinned"
        ],
        "idempotency": "safe-read",
        "scopes": [
          "api"
        ],
        "maxItems": 1,
        "minIntervalMs": 500,
        "timeoutMs": 15000
      },
      "fixtures": [
        {
          "name": "reads one audience",
          "kind": "safe",
          "connection": {
            "dc": "us21"
          },
          "arguments": {
            "list_id": "57afe96172"
          },
          "expect": {
            "facts": {
              "class": "read"
            },
            "request": {
              "body": null,
              "headers": [
                [
                  "accept",
                  "application/json"
                ]
              ],
              "maxPages": 1,
              "method": "GET",
              "url": "https://us21.api.mailchimp.com/3.0/lists/57afe96172?fields=id%2Cname%2Cstats.member_count"
            },
            "response": "{\"id\":\"57afe96172\",\"name\":\"Newsletter\",\"stats\":{\"member_count\":1200}}",
            "projection": {
              "id": "57afe96172",
              "name": "Newsletter",
              "member_count": 1200
            },
            "decisions": {
              "relaxed": "allow",
              "balanced": "allow",
              "strict": "allow"
            }
          }
        },
        {
          "name": "refuses an audience id with a path",
          "kind": "risky",
          "connection": {
            "dc": "us21"
          },
          "arguments": {
            "list_id": "57afe9/../"
          },
          "expect": {
            "error": "invalid_argument"
          }
        }
      ]
    },
    {
      "actionId": "mailchimp.members.get",
      "title": "Read an audience member",
      "executor": {
        "kind": "declarative-http",
        "request": {
          "method": "GET",
          "host": "{dc}.api.mailchimp.com",
          "path": "/3.0/lists/{list_id}/members/{subscriber_hash}",
          "headers": [
            {
              "name": "accept",
              "value": "application/json"
            }
          ],
          "query": [
            {
              "name": "fields",
              "value": {
                "const": "id,email_address,status"
              }
            }
          ],
          "maxPages": 1
        }
      },
      "arguments": {
        "list_id": {
          "type": "string",
          "required": true,
          "maxLength": 10,
          "pattern": "^[0-9a-f]{10}$"
        },
        "subscriber_hash": {
          "type": "string",
          "required": true,
          "maxLength": 32,
          "pattern": "^[0-9a-f]{32}$"
        }
      },
      "facts": {
        "class": "read",
        "object": {
          "const": "contact"
        },
        "scope": {
          "const": "single"
        },
        "recordCount": {
          "const": 1
        }
      },
      "response": {
        "maxBytes": 131072,
        "fields": [
          {
            "name": "id",
            "value": {
              "from": "id"
            }
          },
          {
            "name": "email_address",
            "value": {
              "from": "email_address"
            },
            "untrusted": true
          },
          {
            "name": "status",
            "value": {
              "from": "status"
            }
          },
          {
            "name": "error_title",
            "value": {
              "from": "title"
            },
            "untrusted": true
          },
          {
            "name": "error_detail",
            "value": {
              "from": "detail"
            },
            "untrusted": true
          }
        ]
      },
      "safety": {
        "effect": "read",
        "requiredCapabilities": [
          "bounded-output",
          "egress-pinned"
        ],
        "idempotency": "safe-read",
        "scopes": [
          "api"
        ],
        "maxItems": 1,
        "minIntervalMs": 500,
        "timeoutMs": 15000
      },
      "fixtures": [
        {
          "name": "reads one member",
          "kind": "safe",
          "connection": {
            "dc": "us21"
          },
          "arguments": {
            "list_id": "57afe96172",
            "subscriber_hash": "62eeb292278cc15f5817cb78f7790b08"
          },
          "expect": {
            "facts": {
              "class": "read"
            },
            "request": {
              "body": null,
              "headers": [
                [
                  "accept",
                  "application/json"
                ]
              ],
              "maxPages": 1,
              "method": "GET",
              "url": "https://us21.api.mailchimp.com/3.0/lists/57afe96172/members/62eeb292278cc15f5817cb78f7790b08?fields=id%2Cemail_address%2Cstatus"
            },
            "decisions": {
              "relaxed": "allow",
              "balanced": "allow",
              "strict": "allow"
            }
          }
        },
        {
          "name": "refuses an email address in place of its hash",
          "kind": "risky",
          "connection": {
            "dc": "us21"
          },
          "arguments": {
            "list_id": "57afe96172",
            "subscriber_hash": "someone@example.org"
          },
          "expect": {
            "error": "invalid_argument"
          }
        }
      ]
    },
    {
      "actionId": "mailchimp.members.archive",
      "title": "Archive an audience member",
      "executor": {
        "kind": "declarative-http",
        "request": {
          "method": "DELETE",
          "host": "{dc}.api.mailchimp.com",
          "path": "/3.0/lists/{list_id}/members/{subscriber_hash}",
          "headers": [
            {
              "name": "accept",
              "value": "application/json"
            }
          ],
          "maxPages": 1
        }
      },
      "arguments": {
        "list_id": {
          "type": "string",
          "required": true,
          "maxLength": 10,
          "pattern": "^[0-9a-f]{10}$"
        },
        "subscriber_hash": {
          "type": "string",
          "required": true,
          "maxLength": 32,
          "pattern": "^[0-9a-f]{32}$"
        }
      },
      "facts": {
        "class": "delete",
        "object": {
          "const": "contact"
        },
        "scope": {
          "const": "single"
        },
        "recordCount": {
          "const": 1
        },
        "reversibility": {
          "const": "recoverable"
        }
      },
      "response": {
        "maxBytes": 131072,
        "emptyOk": true,
        "fields": [
          {
            "name": "error_title",
            "value": {
              "from": "title"
            },
            "untrusted": true
          },
          {
            "name": "error_detail",
            "value": {
              "from": "detail"
            },
            "untrusted": true
          }
        ]
      },
      "safety": {
        "effect": "destructive",
        "requiredCapabilities": [
          "bounded-output",
          "egress-pinned"
        ],
        "idempotency": "none",
        "scopes": [
          "api"
        ],
        "maxItems": 1,
        "minIntervalMs": 1000,
        "timeoutMs": 15000
      },
      "fixtures": [
        {
          "name": "archives one member",
          "kind": "safe",
          "connection": {
            "dc": "us21"
          },
          "arguments": {
            "list_id": "57afe96172",
            "subscriber_hash": "62eeb292278cc15f5817cb78f7790b08"
          },
          "expect": {
            "facts": {
              "class": "delete"
            },
            "request": {
              "body": null,
              "headers": [
                [
                  "accept",
                  "application/json"
                ]
              ],
              "maxPages": 1,
              "method": "DELETE",
              "url": "https://us21.api.mailchimp.com/3.0/lists/57afe96172/members/62eeb292278cc15f5817cb78f7790b08"
            },
            "decisions": {
              "relaxed": "allow",
              "balanced": "allow",
              "strict": "review"
            }
          }
        },
        {
          "name": "refuses a missing member",
          "kind": "risky",
          "connection": {
            "dc": "us21"
          },
          "arguments": {
            "list_id": "57afe96172"
          },
          "expect": {
            "error": "missing_argument"
          }
        }
      ]
    }
  ]
}
