  "version": "1.0.0",
  "name": "LocalSites",
  "description": "Local web development for macOS and Linux: every project folder gets https://name.test with its own PHP and database. Agents can read projects, logs and health checks, and change projects, databases and shares. LocalSites already makes risky calls wait for Approve in its app; this entry adds Guard review on top. Off until you turn it on.",
  "trustClass": "external",
  "activation": "opt-in",
  "publisher": {
    "id": "github.itismowgli",
    "displayName": "Parth Shah",
    "url": "https://github.com/itismowgli/localsites"
  },
