                "List projects with agentburp project list before changing the active project.",
                "Confirm the project name before deleting it."
              ],
              "example_command": "agentburp project delete example-project"
            }
          ],
          "rules": [
            {
              "rule_id": "command.agentburp.project-modify",
              "rule_version": "1.0.0",
              "title": "AgentBurp project changes",
              "description": "Matches commands that create a project, write the active project setting, or delete a project.",
              "severity": "medium",
              "risk_classes": [
                "data_modification"
              ],
              "action_classes": [
                "AgentBurp project modification"
              ],
              "safer_alternatives": [
                "List projects with agentburp project list before changing the active project.",
                "Confirm the project name before deleting it."
              ],
              "default_mode": "review",
              "permission_id": "command.agentburp.permission.project-modify",
              "safe_variants": [
                {
                  "variant_id": "dry-run",
                  "title": "AgentBurp project preview",
                  "matcher": {
                    "op": "executable-path-set.v1",
                    "config": {
                      "executables": [
                        "agentburp",
                        "agentburp.cmd",
                        "agentburp.exe"
                      ],
                      "interspersed_options_with_values": [
                        "--project",
                        "-p"
                      ],
                      "interspersed_flags": [
                        "--dry-run",
                        "--help",
                        "-h",
                        "--json",
                        "--no-color",
                        "--force"
                      ],
                      "required_flags": [
                        "--dry-run"
                      ],
                      "required_flags_in_all_arguments": true,
                      "fail_secure_unknown_options": true,
                      "paths": [
                        [
                          "project",
                          "create"
                        ],
                        [
                          "project",
                          "open"
                        ],
                        [
                          "project",
                          "delete"
                        ]
                      ]
                    },
                    "matchers": []
                  }
                },
                {
                  "variant_id": "help",
                  "title": "AgentBurp project help",
                  "matcher": {
                    "op": "executable-path-set.v1",
                    "config": {
                      "executables": [
                        "agentburp",
