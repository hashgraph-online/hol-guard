  },
  "icon": {
    "kind": "react-icon",
    "name": "HiMiniCube",
    "background": "#0F766E"
  },
  "homepage": "https://github.com/abendrothj/simgit",
  "license": "Apache-2.0",
  "executables": [
    "simgit",
    "sg"
  ],
  "ecosystemIds": [
    "simgit"
  ],
  "riskClasses": [
    "destructive_shell"
  ],
  "actionClasses": [
    "simgit uncommitted worktree discard command",
    "simgit unmerged branch deletion command"
  ],
  "referenceUrls": [
    "https://github.com/abendrothj/simgit"
