      {
        "action_classes": [
          "netdoctor network diagnosis"
        ],
        "default_mode": "review",
        "description": "Matches every netdoctor run except plain -h, --help, -V, and --version, which exit before any probe. Each run sends DNS queries and HTTP GET requests whose host names and paths come from the arguments, so a target such as https://host/?k=value or a --path value can carry data to a remote server.",
        "family": null,
