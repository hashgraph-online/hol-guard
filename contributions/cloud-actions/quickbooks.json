              "name": "operation",
              "value": {
                "const": "void"
              }
            },
            {
              "name": "minorversion",
              "value": {
                "const": "75"
              }
            }
          ],
          "headers": [
            {
              "name": "accept",
              "value": "application/json"
            }
          ],
          "body": {
            "object": [
              {
                "name": "Id",
                "value": {
                  "arg": "invoice_id"
                }
              },
              {
                "name": "SyncToken",
                "value": {
                  "arg": "sync_token"
                }
              }
            ]
          },
          "maxPages": 1
        }
      },
      "arguments": {
        "realm_id": {
          "type": "string",
          "required": true,
          "maxLength": 20,
          "pattern": "^[0-9]{1,20}$"
        },
        "invoice_id": {
          "type": "string",
          "required": true,
          "maxLength": 20,
          "pattern": "^[0-9]{1,20}$"
        },
        "sync_token": {
          "type": "string",
          "required": true,
          "maxLength": 10,
          "pattern": "^[0-9]{1,10}$"
        }
      },
      "facts": {
        "class": "update",
        "object": {
          "const": "record"
        },
        "scope": {
          "const": "single"
        },
        "reversibility": {
          "const": "permanent"
        },
        "recordCount": {
          "const": 1
        }
      },
      "response": {
        "maxBytes": 262144,
        "fields": [
          {
            "name": "id",
            "value": {
              "from": "Invoice.Id"
            }
          },
          {
            "name": "status",
            "value": {
              "from": "Invoice.status"
            }
          },
          {
            "name": "errors",
            "value": {
              "list": {
                "from": "Fault.Error",
                "maxItems": 20,
                "fields": [
                  {
                    "name": "code",
                    "value": {
                      "from": "code"
                    }
                  },
                  {
                    "name": "message",
                    "value": {
                      "from": "Message"
                    },
                    "untrusted": true
                  },
                  {
                    "name": "detail",
                    "value": {
                      "from": "Detail"
                    },
                    "untrusted": true
                  }
                ]
              }
            }
          }
        ]
      },
      "safety": {
        "effect": "destructive",
        "requiredCapabilities": [
          "bounded-output",
          "egress-pinned"
        ],
        "idempotency": "none",
        "scopes": [
          "com.intuit.quickbooks.accounting"
        ],
        "maxItems": 1,
        "minIntervalMs": 3000,
        "timeoutMs": 15000
      },
      "fixtures": [
        {
          "name": "voids one invoice",
          "kind": "safe",
          "arguments": {
            "realm_id": "9341453050206514",
            "invoice_id": "130",
            "sync_token": "2"
          },
          "expect": {
            "facts": {
              "class": "update",
              "reversibility": {
                "state": "known",
                "value": "permanent"
              }
            },
            "request": {
              "body": "{\"Id\":\"130\",\"SyncToken\":\"2\"}",
              "headers": [
                [
                  "accept",
                  "application/json"
                ],
                [
                  "content-type",
                  "application/json; charset=utf-8"
                ]
              ],
              "maxPages": 1,
              "method": "POST",
              "url": "https://quickbooks.api.intuit.com/v3/company/9341453050206514/invoice?operation=void&minorversion=75"
            },
            "decisions": {
              "relaxed": "allow",
              "balanced": "allow",
              "strict": "require-reapproval"
            }
          }
        },
        {
          "name": "refuses a sync token that is not a number",
          "kind": "risky",
          "arguments": {
            "realm_id": "9341453050206514",
            "invoice_id": "130",
            "sync_token": "-1"
          },
          "expect": {
            "error": "invalid_argument"
          }
        }
      ]
    },
