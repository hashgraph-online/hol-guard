{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guard.hashgraphonline.com/schema/policy/v1alpha1/extensions/x-hol.tests",
  "title": "GuardPolicy x-hol.tests extension value",
  "description": "Example events stored with a policy and the decision each one must produce. Authoring and CI only; enforcement ignores this extension.",
  "type": "array",
  "maxItems": 256,
  "items": {
    "$ref": "#/$defs/test"
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "selector": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "test": {
      "type": "object",
      "required": [
        "id",
        "event",
        "expect"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "event": {
          "$ref": "#/$defs/event"
        },
        "expect": {
          "$ref": "#/$defs/expect"
        }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": [
        "harness"
      ],
      "properties": {
        "harness": {
          "$ref": "#/$defs/selector"
        },
        "artifact": {
          "$ref": "#/$defs/selector"
        },
        "tool": {
          "enum": [
            "file-read",
            "mcp",
            "mcp-tool",
            "package-request",
            "prompt",
            "prompt-env-read",
            "prompt-file",
            "tool-action",
            "shell"
          ]
        },
        "publisher": {
          "$ref": "#/$defs/selector"
        },
        "workspace": {
          "$ref": "#/$defs/selector"
        },
        "at": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"
        }
      },
      "additionalProperties": false,
      "not": {
        "required": [
          "artifact",
          "tool"
        ]
      }
    },
    "expect": {
      "type": "object",
      "required": [
        "effect"
      ],
      "properties": {
        "effect": {
          "enum": [
            "allow",
            "block",
            "default"
          ]
        },
        "ruleId": {
          "$ref": "#/$defs/identifier"
        }
      },
      "additionalProperties": false
    }
  }
}
