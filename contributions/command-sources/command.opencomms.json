                ]
              }
            }
          },
          {
            "variant_id": "opencomms.exe-json-check",
            "title": "Check update availability without replacement",
            "matcher": {
              "op": "reviewed-literal.v1",
              "config": {
                "executable": "opencomms.exe",
                "arguments": [
                  "update",
                  "--json",
                  "--check"
                ]
              }
            }
          }
        ]
      },
      {
        "rule_id": "command.opencomms.doctor-fix",
        "rule_version": "1.0.0",
        "permission_id": "command.opencomms.permission.doctor-fix",
        "title": "OpenComms integration repair",
        "description": "Reviews doctor invocations that may repair integrations, including --fix after --, as an option value, or followed by an assignment. Only exact standalone plain doctor invocations are reviewed safe variants. Extra arguments, quoting, wrappers, paths and unresolved expansions retain review until the native matcher can prove OpenComms' exact argv.includes semantics.",
        "severity": "high",
        "risk_classes": [
          "execution",
          "destructive_shell"
        ],
        "action_classes": [
