          "minimum": 1
        },
        "minIntervalMs": {
          "type": "integer",
          "minimum": 0
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "arguments",
        "expect"
      ],
      "properties": {
