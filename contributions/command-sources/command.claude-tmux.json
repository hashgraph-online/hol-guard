    ],
    "baseline_floor": "review",
    "configurable": true,
    "conflicts": [],
    "default_enabled": true,
    "dependencies": [],
    "deprecated": false,
    "description": "Identifies claude-tmux-cleanup runs that kill tmux sessions without answering the confirmation prompt by hand — --force, a pipeline feeding the prompt its consent, or a here-string holding it. Every pane in a selected session is terminated, ending the agent teams running in them and discarding the unsaved terminal state they hold. With no target and no selection flag the run sweeps every session on the host.",
    "example_command": "ctc --all --force",
    "family": null,
    "fixed_reason": null,
    "implementation_version": "1.0.0",
    "implied_permissions": [],
    "introduced_version": "2.2.0",
    "label": "Claude tmux unattended session teardown",
    "permission_id": "command.claude-tmux.permission.session-teardown",
    "replacement_permission_id": null,
    "risk_tier": "medium",
    "safer_guidance": [
     "Run the same command with --dry-run to list the sessions, or drop --force and confirm each one."
    ],
    "typed_capabilities": []
   },
   {
    "action_classes": [
     "claude tmux process prune command"
    ],
    "baseline_floor": "review",
    "configurable": true,
    "conflicts": [],
    "default_enabled": true,
    "dependencies": [],
    "deprecated": false,
    "description": "Identifies claude-tmux-cleanup runs that kill Claude Code processes outside tmux without answering the confirmation prompt by hand. The scan runs after any session teardown in the same command, so it takes both the processes that teardown just orphaned and any that were already stray, including a Claude Code session started in a plain terminal that the caller never named.",
    "example_command": "ctc --all --force --prune",
    "family": null,
    "fixed_reason": null,
    "implementation_version": "1.0.0",
    "implied_permissions": [],
    "introduced_version": "2.2.0",
