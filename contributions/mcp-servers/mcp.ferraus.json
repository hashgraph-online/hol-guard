{
  "schemaVersion": "guard.mcp-server-contribution.v1",
  "id": "mcp.ferraus",
  "version": "1.0.0",
  "name": "ferraus",
  "description": "Reviews the ferraus audio workstation's MCP tools that reach beyond the --allow music folders: downloads (including tools that fetch an ML model on first use), cache deletion, config changes, CLAP/VST3 plugin code, raw FFmpeg arguments, and tools that run other tools. Other editing, mixing and mastering tools only touch paths inside --allow and keep inherited policy. Off until you turn it on.",
  "trustClass": "external",
  "activation": "opt-in",
  "publisher": {
    "id": "io.github.djynnius",
    "displayName": "Sunday Ikpe",
    "url": "https://github.com/djynnius/ferraus"
  },
  "icon": {
    "kind": "react-icon",
    "name": "HiMiniCommandLine",
    "background": "#0F172A"
  },
  "homepage": "https://djynnius.github.io/ferraus",
  "license": "Apache-2.0 OR MIT",
  "launch": {
    "kind": "direct-command",
    "command": "ferraus"
  },
  "riskClasses": [
    "local-media-read",
    "local-file-write",
    "package-or-source-installation",
    "local-data-deletion",
    "external-command-execution"
  ],
  "tools": [
