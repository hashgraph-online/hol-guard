{
  "schema": "guard.cloud-action-pack.v1",
  "provider": {
    "id": "hubspot",
    "name": "HubSpot",
    "publisher": {
      "name": "HOL",
      "verified": true
    }
  },
  "hosts": [
    "api.hubapi.com"
  ],
  "auth": {
    "mode": "oauth2",
    "scopes": [
      "crm.objects.companies.read",
      "crm.objects.companies.write",
      "crm.objects.contacts.read",
      "crm.objects.contacts.write",
      "crm.objects.deals.read",
      "crm.objects.deals.write",
      "crm.schemas.custom.write"
    ]
  },
  "actions": [
    {
      "actionId": "hubspot.objects.list",
      "title": "List contacts, companies or deals",
      "executor": {
        "kind": "declarative-http",
        "request": {
          "method": "GET",
          "path": "/crm/v3/objects/{object_type}",
          "query": [
            {
              "name": "limit",
              "value": {
                "arg": {
                  "name": "limit"
                }
              }
            },
            {
              "name": "after",
              "value": {
                "arg": {
                  "name": "after"
                }
              }
            }
          ],
          "host": "api.hubapi.com",
          "headers": [
            {
              "name": "accept",
              "value": "application/json"
            }
          ],
          "maxPages": 1
        }
      },
      "arguments": {
        "object_type": {
          "type": "string",
          "required": true,
          "maxLength": 9,
          "pattern": "^(?:contacts|companies|deals)$"
        },
        "limit": {
          "type": "integer",
          "required": false,
          "minimum": 1,
          "maximum": 100
        },
        "after": {
          "type": "string",
          "required": false,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        }
      },
      "facts": {
        "class": "read",
        "object": {
          "const": "record"
        },
        "scope": {
          "const": "query_selected"
        },
        "recordCount": {
          "argument": {
            "name": "limit",
            "max": 100,
            "default": 10
          }
        }
      },
      "response": {
        "maxBytes": 262144,
        "fields": [
          {
            "name": "results",
            "value": {
              "list": {
                "from": "results",
                "maxItems": 100,
                "fields": [
                  {
                    "name": "id",
                    "value": {
                      "from": "id"
                    }
                  },
                  {
                    "name": "name",
                    "value": {
                      "from": "properties.name"
                    },
                    "untrusted": true
                  },
                  {
                    "name": "email",
                    "value": {
                      "from": "properties.email"
                    },
                    "untrusted": true
                  },
                  {
                    "name": "updated",
                    "value": {
                      "from": "updatedAt"
                    }
                  }
                ]
              }
            }
          },
          {
            "name": "next",
            "value": {
              "from": "paging.next.after"
            }
          }
        ]
      },
      "safety": {
        "effect": "read",
        "requiredCapabilities": [
          "bounded-output",
          "egress-pinned"
        ],
        "idempotency": "safe-read",
        "scopes": [
          "crm.objects.contacts.read",
          "crm.objects.companies.read",
          "crm.objects.deals.read"
        ],
        "maxItems": 100,
        "minIntervalMs": 250,
        "timeoutMs": 10000
      },
      "fixtures": [
        {
          "name": "lists contacts",
          "kind": "safe",
          "arguments": {
            "object_type": "contacts",
            "limit": 20
          },
          "expect": {
            "facts": {
              "class": "read",
              "object": {
                "state": "known",
                "value": "record"
              },
              "scope": {
                "state": "known",
                "value": "query_selected"
              },
              "record_count": {
                "state": "known",
                "value": 20
              }
            },
            "decisions": {
              "balanced": "allow",
              "relaxed": "allow",
              "strict": "allow"
            }
          }
        },
        {
          "name": "refuses an object type it does not cover",
          "kind": "risky",
          "arguments": {
            "object_type": "line_items"
          },
          "expect": {
            "error": "invalid_argument"
          }
        },
        {
          "name": "refuses a page over 100",
          "kind": "risky",
          "arguments": {
            "object_type": "deals",
            "limit": 500
          },
          "expect": {
            "error": "invalid_argument"
          }
        }
      ]
    },
    {
      "actionId": "hubspot.objects.set_property",
      "title": "Set one property on up to 100 records",
      "executor": {
        "kind": "declarative-http",
        "request": {
          "method": "POST",
          "path": "/crm/v3/objects/{object_type}/batch/update",
          "body": {
            "object": [
              {
                "name": "inputs",
                "value": {
                  "each": {
                    "arg": "record_ids",
                    "item": {
                      "object": [
                        {
                          "name": "id",
                          "value": {
                            "element": true
                          }
                        },
                        {
                          "name": "properties",
                          "value": {
                            "keyed": {
                              "key": "property",
                              "value": {
                                "arg": "value"
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            ]
          },
          "host": "api.hubapi.com",
          "headers": [
            {
              "name": "accept",
              "value": "application/json"
            }
          ],
          "maxPages": 1
        }
      },
      "arguments": {
        "object_type": {
          "type": "string",
          "required": true,
          "maxLength": 9,
          "pattern": "^(?:contacts|companies|deals)$"
        },
        "record_ids": {
          "type": "array",
          "required": true,
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "maxLength": 20,
            "pattern": "^[0-9]{1,20}$"
          }
        },
        "property": {
          "type": "string",
          "required": true,
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_]{0,99}$"
        },
        "value": {
          "type": "string",
          "required": true,
          "maxLength": 10000,
          "pattern": "^[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f]*$"
        }
      },
      "facts": {
        "class": "update",
        "object": {
          "const": "record"
        },
        "scope": {
          "const": "enumerated"
        },
        "reversibility": {
          "const": "reversible"
        },
        "recordCount": {
          "count": {
            "arguments": [
              "record_ids"
            ]
          }
        }
      },
      "response": {
        "maxBytes": 262144,
        "fields": [
          {
            "name": "results",
            "value": {
              "list": {
                "from": "results",
                "maxItems": 100,
                "fields": [
                  {
                    "name": "id",
                    "value": {
                      "from": "id"
                    }
                  },
                  {
                    "name": "updated",
                    "value": {
                      "from": "updatedAt"
                    }
                  }
                ]
              }
            }
          },
          {
            "name": "status",
            "value": {
              "from": "status"
            }
          }
        ]
      },
      "safety": {
        "effect": "write",
        "requiredCapabilities": [
          "bounded-output",
          "egress-pinned"
        ],
        "idempotency": "none",
        "scopes": [
          "crm.objects.contacts.write",
          "crm.objects.companies.write",
          "crm.objects.deals.write"
        ],
        "maxItems": 100,
        "minIntervalMs": 1000,
        "timeoutMs": 10000
      },
