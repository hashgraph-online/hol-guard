{
  "schema": "guard.cloud-action-pack.v1",
  "provider": {
    "id": "figma",
    "name": "Figma",
    "publisher": {
      "name": "HOL",
      "verified": true
    }
  },
  "hosts": [
    "api.figma.com"
  ],
  "auth": {
    "mode": "oauth2",
    "scopes": [
      "file_comments:read",
      "file_comments:write"
    ]
  },
  "actions": [
    {
      "actionId": "figma.comments.list",
      "title": "List comments on a file",
      "executor": {
        "kind": "declarative-http",
        "request": {
          "method": "GET",
          "host": "api.figma.com",
          "path": "/v1/files/{file_key}/comments",
          "headers": [
            {
              "name": "accept",
              "value": "application/json"
            }
          ],
          "maxPages": 1
        }
      },
      "arguments": {
        "file_key": {
          "type": "string",
          "required": true,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9]{10,64}$"
        }
      },
      "facts": {
        "class": "read",
        "object": {
          "const": "message"
        },
        "scope": {
          "const": "all"
        }
      },
      "response": {
        "maxBytes": 1048576,
        "fields": [
          {
            "name": "comments",
            "value": {
              "list": {
                "from": "comments",
                "maxItems": 1000,
                "fields": [
                  {
                    "name": "id",
                    "value": {
                      "from": "id"
                    }
                  },
                  {
                    "name": "message",
                    "value": {
                      "from": "message"
                    },
                    "untrusted": true
                  },
                  {
                    "name": "author",
                    "value": {
                      "from": "user.handle"
                    },
                    "untrusted": true
                  },
                  {
                    "name": "created_at",
                    "value": {
                      "from": "created_at"
                    }
                  },
                  {
                    "name": "resolved_at",
                    "value": {
                      "from": "resolved_at"
                    }
                  }
                ]
              }
            }
          }
        ]
      },
      "safety": {
        "effect": "read",
        "requiredCapabilities": [
          "bounded-output",
          "egress-pinned"
        ],
        "idempotency": "safe-read",
        "scopes": [
          "file_comments:read"
        ],
        "maxItems": 1,
        "minIntervalMs": 500,
        "timeoutMs": 15000
      },
      "fixtures": [
        {
          "name": "lists comments",
          "kind": "safe",
          "arguments": {
            "file_key": "examplefile"
          },
          "expect": {
            "facts": {
              "class": "read"
            },
            "request": {
              "body": null,
              "headers": [
                [
                  "accept",
                  "application/json"
                ]
              ],
              "maxPages": 1,
              "method": "GET",
              "url": "https://api.figma.com/v1/files/examplefile/comments"
            },
            "decisions": {
              "relaxed": "allow",
              "balanced": "allow",
              "strict": "allow"
            }
          }
        },
        {
          "name": "refuses a file key with a path",
          "kind": "risky",
          "arguments": {
            "file_key": "abc/../../me"
          },
          "expect": {
            "error": "invalid_argument"
          }
        }
      ]
    },
    {
      "actionId": "figma.comments.post",
      "title": "Comment on a file",
      "executor": {
        "kind": "declarative-http",
        "request": {
          "method": "POST",
          "host": "api.figma.com",
          "path": "/v1/files/{file_key}/comments",
          "headers": [
            {
              "name": "accept",
              "value": "application/json"
            }
          ],
          "body": {
            "object": [
              {
                "name": "message",
                "value": {
                  "arg": "message"
                }
              }
            ]
          },
          "maxPages": 1
        }
      },
      "arguments": {
        "file_key": {
          "type": "string",
          "required": true,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9]{10,64}$"
        },
        "message": {
          "type": "string",
          "required": true,
          "maxLength": 5000
        }
      },
      "facts": {
        "class": "update",
        "object": {
          "const": "message"
        },
        "scope": {
          "const": "single"
        },
        "reversibility": {
          "const": "reversible"
        },
        "recordCount": {
          "const": 1
        }
      },
      "response": {
        "maxBytes": 131072,
        "fields": [
          {
            "name": "id",
            "value": {
              "from": "id"
            }
          },
          {
            "name": "message",
            "value": {
              "from": "message"
            },
            "untrusted": true
          }
        ]
      },
      "safety": {
        "effect": "write",
        "requiredCapabilities": [
          "bounded-output",
          "egress-pinned"
        ],
        "idempotency": "none",
        "scopes": [
          "file_comments:write"
        ],
        "maxItems": 1,
        "minIntervalMs": 1000,
        "timeoutMs": 15000
      },
      "fixtures": [
        {
          "name": "adds a comment",
          "kind": "safe",
          "arguments": {
            "file_key": "examplefile",
            "message": "Spacing on the header looks off."
          },
          "expect": {
            "facts": {
              "class": "update"
            },
            "request": {
              "body": "{\"message\":\"Spacing on the header looks off.\"}",
              "headers": [
                [
                  "accept",
                  "application/json"
                ],
                [
                  "content-type",
                  "application/json; charset=utf-8"
                ]
              ],
              "maxPages": 1,
              "method": "POST",
              "url": "https://api.figma.com/v1/files/examplefile/comments"
            },
            "decisions": {
              "relaxed": "allow",
              "balanced": "allow",
              "strict": "review"
            }
          }
        },
        {
          "name": "refuses a comment over 5000 characters",
          "kind": "risky",
          "arguments": {
            "file_key": "examplefile",
            "message": ""
          },
          "expect": {
            "error": "invalid_argument"
          }
        }
      ]
    },
    {
      "actionId": "figma.comments.delete",
      "title": "Delete a comment",
      "executor": {
        "kind": "declarative-http",
        "request": {
          "method": "DELETE",
          "host": "api.figma.com",
          "path": "/v1/files/{file_key}/comments/{comment_id}",
          "headers": [
            {
              "name": "accept",
              "value": "application/json"
            }
          ],
          "maxPages": 1
        }
      },
      "arguments": {
        "file_key": {
          "type": "string",
          "required": true,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9]{10,64}$"
        },
        "comment_id": {
          "type": "string",
          "required": true,
          "maxLength": 20,
          "pattern": "^[0-9]{1,20}$"
        }
      },
      "facts": {
        "class": "delete",
        "object": {
          "const": "message"
        },
        "scope": {
          "const": "single"
        },
        "reversibility": {
          "const": "permanent"
        },
        "recordCount": {
          "const": 1
        }
      },
      "response": {
        "maxBytes": 65536,
        "emptyOk": true,
        "fields": [
          {
            "name": "status",
            "value": {
              "from": "status"
            }
          }
        ]
      },
      "safety": {
        "effect": "destructive",
        "requiredCapabilities": [
          "bounded-output",
          "egress-pinned"
        ],
        "idempotency": "none",
        "scopes": [
          "file_comments:write"
        ],
        "maxItems": 1,
        "minIntervalMs": 3000,
        "timeoutMs": 15000
      },
      "fixtures": [
        {
          "name": "deletes one comment",
          "kind": "safe",
          "arguments": {
            "file_key": "examplefile",
            "comment_id": "123456"
          },
          "expect": {
            "facts": {
              "class": "delete"
            },
            "request": {
              "body": null,
              "headers": [
                [
                  "accept",
                  "application/json"
                ]
              ],
              "maxPages": 1,
              "method": "DELETE",
              "url": "https://api.figma.com/v1/files/examplefile/comments/123456"
            },
            "decisions": {
              "relaxed": "review",
              "balanced": "review",
              "strict": "block"
            }
          }
        },
        {
          "name": "refuses a comment id that is not numeric",
          "kind": "risky",
          "arguments": {
            "file_key": "examplefile",
            "comment_id": "all"
          },
          "expect": {
            "error": "invalid_argument"
          }
        }
      ]
    }
  ]
}
