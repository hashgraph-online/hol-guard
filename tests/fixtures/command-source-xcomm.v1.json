{
  "build": {
    "base": "packaged",
    "mcp_sources": [],
    "schema": "guard.command-extension-build.v1",
    "sources": [
      {
        "extension": {
          "action_classes": [
            "xcomm serial device input",
            "xcomm serial line control",
            "xcomm serial file transfer",
            "xcomm local capture write"
          ],
          "aliases": [],
          "conflicts": [],
          "dependencies": [],
          "description": "Reviews xcomm control-socket commands that act on a real serial device: text and bytes sent to the board (ctl send, ctl run), line control (break, DTR/RTS, line settings), zmodem/ymodem/xmodem transfers, and captures written to local files. Commands that only observe (ctl status, read, wait, sessions) are left unmatched. Opening a session directly (xcomm <device>, which also sends piped stdin and raises DTR/RTS) is outside this extension. Boundary reviewed against xcomm 0.1.3.",
          "ecosystem_ids": [],
          "executables": [
            "xcomm"
          ],
          "extension_id": "command.xcomm",
          "homepage": "https://github.com/cantona/xcomm",
          "icon": {
            "kind": "none"
          },
          "license": "GPL-2.0-only",
          "name": "xcomm",
          "permissions": [
            {
              "action_classes": [
                "xcomm serial device input"
              ],
              "baseline_floor": "review",
              "configurable": true,
              "conflicts": [],
              "default_enabled": true,
              "dependencies": [],
              "deprecated": false,
              "description": "Sends text or raw bytes to the board on the session's serial port. Whatever is listening there runs it: a shell, a bootloader such as U-Boot, or firmware. A send cannot be taken back, and a reply prompt is not proof the command ran.",
              "example_command": "xcomm ctl ttyUSB1 run 'reboot' --until '# $' --timeout 10",
              "implementation_version": "1.0.0",
              "implied_permissions": [],
              "introduced_version": "1.0.0",
              "label": "Send input to a serial device",
              "permission_id": "command.xcomm.permission.device-input",
              "risk_tier": "high",
              "safer_guidance": [
                "Read the session's output first (xcomm ctl <device> read --last 4096) to see which prompt the board is at.",
                "Give run a --fail-on pattern for boot banners or error text so a reboot is not taken as success."
              ],
              "typed_capabilities": []
            },
            {
              "action_classes": [
                "xcomm serial line control"
              ],
              "baseline_floor": "review",
              "configurable": true,
              "conflicts": [],
              "default_enabled": true,
              "dependencies": [],
              "deprecated": false,
              "description": "Sends a break, sets or pulses DTR/RTS, or changes baud, data bits, parity, stop bits or flow control. On many boards DTR/RTS are wired to reset or boot-mode pins, and a break can stop a bootloader or trigger a console SysRq.",
              "example_command": "xcomm ctl ttyUSB1 dtr pulse 200",
              "implementation_version": "1.0.0",
              "implied_permissions": [],
              "introduced_version": "1.0.0",
              "label": "Control serial line signals and settings",
              "permission_id": "command.xcomm.permission.line-control",
              "risk_tier": "high",
              "safer_guidance": [
                "Check the board's wiring before toggling DTR/RTS; on auto-reset boards a pulse resets the target."
              ],
              "typed_capabilities": []
            },
            {
              "action_classes": [
                "xcomm serial file transfer"
              ],
              "baseline_floor": "review",
              "configurable": true,
              "conflicts": [],
              "default_enabled": true,
              "dependencies": [],
              "deprecated": false,
              "description": "Runs lrzsz on the session's port: send pushes local files to the device; recv writes files from the device. zmodem and ymodem recv write only below the working directory; xmodem recv writes to the path given, wherever it is.",
              "example_command": "xcomm ctl ttyUSB1 xfer send zmodem firmware.bin",
              "implementation_version": "1.0.0",
              "implied_permissions": [],
              "introduced_version": "1.0.0",
              "label": "Transfer files over the serial line",
              "permission_id": "command.xcomm.permission.transfer",
              "risk_tier": "high",
              "safer_guidance": [
                "Check the file list and the receiving program on the board before a send; run zmodem or ymodem recv in a scratch directory, and check the target path of an xmodem recv."
              ],
              "typed_capabilities": []
            },
            {
              "action_classes": [
                "xcomm local capture write"
              ],
              "baseline_floor": "review",
              "configurable": true,
              "conflicts": [],
              "default_enabled": true,
              "dependencies": [],
              "deprecated": false,
              "description": "Starts or stops appending the device's output to a local file chosen by the caller.",
              "example_command": "xcomm ctl ttyUSB1 capture start boot.log",
              "implementation_version": "1.0.0",
              "implied_permissions": [],
              "introduced_version": "1.0.0",
              "label": "Write a capture file",
              "permission_id": "command.xcomm.permission.capture",
              "risk_tier": "medium",
              "safer_guidance": [
                "Capture into a new file in a scratch directory; the session appends to an existing file."
              ],
              "typed_capabilities": []
            }
          ],
