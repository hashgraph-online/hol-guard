          "executables": [],
          "extension_id": "command.gitsync",
          "homepage": "https://github.com/cristobaltormo/git-sync",
          "icon": {
            "kind": "none"
          },
          "license": "Apache-2.0",
          "name": "gitsync command protection",
          "permissions": [
            {
              "action_classes": [
                "gitsync mirror-mutating command"
              ],
              "baseline_floor": "review",
              "configurable": true,
              "conflicts": [],
              "default_enabled": true,
              "dependencies": [],
              "deprecated": false,
              "description": "Identifies `gitsync sync` and `gitsync run`, which force-push and prune every configured repo's branches and tags to GitHub so the two sides end up identical, and can eventually delete the GitHub mirror once a repo disappears from the source (subject to gitsync's own delete_grace and delete_limit safeguards). `run --dry-run` reports what would happen without pushing or deleting anything and is treated as safe. `sync` also accepts --dry-run, but takes positional repo names and Go's flag parser stops at the first one, so `gitsync sync owner/name --dry-run` silently runs live; that ordering cannot be told apart from a working dry run here, so `sync --dry-run` stays reviewed.",
              "example_command": "gitsync sync",
              "family": null,
              "fixed_reason": null,
              "implementation_version": "1.0.0",
              "implied_permissions": [],
              "introduced_version": "2.2.0",
              "label": "gitsync live mirror sync",
              "permission_id": "command.gitsync.permission.mirror-mutation",
              "replacement_permission_id": null,
              "risk_tier": "high",
              "safer_guidance": [
                "Run `gitsync run --dry-run` first and review what it reports before running it live.",
                "Run `gitsync check` to confirm token scopes and account mapping before mirroring."
              ],
              "typed_capabilities": []
            },
            {
              "action_classes": [
                "gitsync webhook-rewriting command",
                "gitsync service-install command"
              ],
              "baseline_floor": "review",
              "configurable": true,
              "conflicts": [],
              "default_enabled": true,
              "dependencies": [],
              "deprecated": false,
              "description": "Identifies `gitsync hooks --force` (rewrites existing webhooks on the git server), `gitsync hooks --remove` (deletes them), and `gitsync install` / `gitsync uninstall` (registers or removes the persistent background service). Plain `gitsync hooks` (no flags) still mutates - it creates any missing webhooks - but never rewrites or deletes an existing one, so it is not covered here. `uninstall` ignores every argument and always removes the service and binary on both Linux and Windows, so it has no safe variant, not even --help/-h.",
              "example_command": "gitsync hooks --remove",
              "family": null,
              "fixed_reason": null,
              "implementation_version": "1.0.0",
              "implied_permissions": [],
              "introduced_version": "2.2.0",
              "label": "gitsync webhook rewrite, removal, or service install/uninstall",
              "permission_id": "command.gitsync.permission.operational-mutation",
              "replacement_permission_id": null,
              "risk_tier": "medium",
              "safer_guidance": [
                "Prefer plain `gitsync hooks`, which only creates missing webhooks and does not rewrite or delete existing ones.",
                "Run `gitsync run --dry-run` interactively before installing it as an unattended service."
              ],
              "typed_capabilities": []
            }
