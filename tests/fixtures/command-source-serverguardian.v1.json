              "title": "Server Guardian maintenance",
              "description": "Reviews direct daemon starts and manual nightly maintenance, which can update packages and containers.",
              "severity": "high",
              "risk_classes": [
                "execution",
                "data_modification"
              ],
              "action_classes": [
                "Server Guardian maintenance command"
              ],
              "safer_alternatives": [
                "Check daemon status and inspect the scheduled maintenance settings before starting maintenance."
              ],
              "default_mode": "review",
              "permission_id": "command.serverguardian.permission.maintenance",
              "safe_variants": [],
              "matcher": {
                "op": "any.v1",
                "config": {},
                "matchers": [
                  {
                    "op": "executable.v1",
                    "config": {
                      "executables": [
                        "server-guardian"
                      ],
                      "subcommands": [
                        "daemon"
                      ]
                    },
                    "matchers": []
                  },
                  {
                    "op": "executable.v1",
                    "config": {
                      "executables": [
                        "python",
                        "python3"
                      ],
                      "subcommands": [
                        "-m",
                        "server_guardian.cli",
                        "daemon"
                      ]
                    },
                    "matchers": []
                  },
                  {
                    "op": "executable.v1",
                    "config": {
                      "executables": [
                        "server-guardian"
                      ],
                      "subcommands": [
                        "trigger-nightly"
                      ]
                    },
                    "matchers": []
                  },
                  {
                    "op": "executable.v1",
                    "config": {
                      "executables": [
                        "python",
                        "python3"
                      ],
                      "subcommands": [
                        "-m",
                        "server_guardian.cli",
                        "trigger-nightly"
                      ]
                    },
                    "matchers": []
                  }
                ]
              }
            },
            {
              "rule_id": "command.serverguardian.configure",
              "rule_version": "1.0.0",
              "title": "Server Guardian configuration",
              "description": "Reviews the interactive setup that saves Server Guardian configuration.",
              "severity": "medium",
              "risk_classes": [
                "data_modification"
              ],
              "action_classes": [
                "Server Guardian configuration command"
              ],
              "safer_alternatives": [
                "Check the running daemon status before changing configuration."
              ],
              "default_mode": "review",
              "permission_id": "command.serverguardian.permission.configure",
              "safe_variants": [],
              "matcher": {
                "op": "any.v1",
                "config": {},
                "matchers": [
                  {
                    "op": "executable.v1",
                    "config": {
                      "executables": [
                        "server-guardian"
                      ],
                      "subcommands": [
                        "configure"
                      ]
                    },
                    "matchers": []
                  },
                  {
                    "op": "executable.v1",
                    "config": {
                      "executables": [
                        "python",
                        "python3"
                      ],
                      "subcommands": [
                        "-m",
                        "server_guardian.cli",
                        "configure"
                      ]
                    },
                    "matchers": []
                  }
                ]
              }
            }
          ]
        }
      }
    ],
