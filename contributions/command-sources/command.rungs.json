                  "--explain",
                  "--fast",
                  "--full",
                  "--help",
                  "--into",
                  "--params",
                  "--set",
                  "--version",
                  "-h"
                ],
                "options_with_values": [
                  "--set"
                ],
                "required_flags_anywhere": [],
                "subcommands": [
                  "check"
                ]
              },
              "op": "leading-subcommand.v1"
