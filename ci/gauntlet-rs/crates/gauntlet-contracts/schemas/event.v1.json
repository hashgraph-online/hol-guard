{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "episode_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "kind": {
      "enum": [
        "model-request",
        "tool-request",
        "tool-result",
        "product-decision",
        "forwarded-operation",
        "committed-effect",
        "approval",
        "interception",
        "error",
        "cleanup"
      ]
    },
    "source": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "payload": {
      "$ref": "#/$defs/json"
    },
    "previous_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "timestamp": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    }
  },
  "required": [
    "schema_version",
    "id",
    "episode_id",
    "sequence",
    "kind",
    "source",
    "payload_digest",
    "payload",
    "previous_digest",
    "timestamp"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hol-guard.example/benchmark/event.v1.json",
  "$defs": {
    "json": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 65536
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json"
          },
          "maxItems": 1024
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/json"
          },
          "maxProperties": 256
        }
      ]
    }
  }
}
