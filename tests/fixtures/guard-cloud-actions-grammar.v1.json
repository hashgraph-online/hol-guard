{
  "schema": "guard.cloud-actions-grammar-fixture.v1",
  "why": "Each case names which context a value lands in: a Guard Cloud workspace, a provider or connected account, or a local folder that is refused.",
  "values": {
    "WS": "4f0c2b9e-1d7a-4c3e-9b8a-2e5f6a7b8c9d",
    "ACCOUNT": "8a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d"
  },
  "cases": [
    {"id": "status-before-connect", "argv": ["status", "--json"], "guard_home": true, "paired": false, "exit": 0,
     "command": "status", "expect": {"state": "not_paired"}},
    {"id": "status-names-cloud-workspace", "argv": ["status", "--cloud-workspace", "WS", "--offline", "--json"], "guard_home": true, "paired": true, "exit": 0,
     "command": "status", "expect": {"state": "paired", "cloud_workspace": "WS", "workspace_matches": true}},
    {"id": "status-offline-before-connect", "argv": ["status", "--offline", "--json"], "guard_home": true, "paired": false, "exit": 0,
     "command": "status", "expect": {"state": "not_paired"}},
    {"id": "doctor-before-connect", "argv": ["doctor", "--json"], "guard_home": true, "home": true, "paired": false, "exit": 4,
     "command": "doctor", "expect": {"result": "needs_connect"}},
    {"id": "workspace-select-was-removed", "argv": ["workspace", "select", "WS", "--json"], "guard_home": true, "exit": 4,
     "command": "workspace", "expect": {"state": "removed", "reason": "use_hol_guard_connect", "next_command": "hol-guard connect"}},
    {"id": "connect-names-provider-and-workspace", "argv": ["accounts", "connect", "slack", "--cloud-workspace", "WS", "--no-browser", "--json"], "paired": true, "exit": 0,
     "command": "accounts connect", "expect": {"state": "link", "opened": false, "provider": "slack", "cloud_workspace": "WS",
     "url": "https://hol.org/guard/settings?tab=integrations&workspaceId=4f0c2b9e-1d7a-4c3e-9b8a-2e5f6a7b8c9d#connected-accounts"}},
    {"id": "connect-defaults-to-connected-workspace", "argv": ["accounts", "connect", "slack", "--no-browser", "--json"], "guard_home": true, "paired": true, "exit": 0,
     "command": "accounts connect", "expect": {"state": "link", "cloud_workspace": "WS"}},
    {"id": "connect-needs-connect", "argv": ["accounts", "connect", "slack", "--no-browser", "--json"], "guard_home": true, "paired": false, "exit": 4,
     "command": "accounts connect", "expect": {"state": "failed", "reason": "not_paired"}},
    {"id": "connect-refuses-local-workspace-flag", "argv": ["accounts", "connect", "slack", "--workspace", "/tmp/project", "--cloud-workspace", "WS"], "exit": 2,
     "stderr": "--workspace names a local project folder"},
    {"id": "family-refuses-local-workspace-flag", "argv": ["--workspace", ".", "status"], "exit": 2,
     "stderr": "--workspace names a local project folder"},
    {"id": "cloud-workspace-refuses-home-folder", "argv": ["accounts", "connect", "slack", "--cloud-workspace", "~/code"], "exit": 2,
     "stderr": "looks like a folder"},
    {"id": "cloud-workspace-refuses-name", "argv": ["accounts", "list", "--cloud-workspace", "acme"], "exit": 2,
     "stderr": "is not a Guard Cloud workspace ID"},
    {"id": "provider-is-a-slug", "argv": ["accounts", "connect", "https://slack.com", "--cloud-workspace", "WS"], "exit": 2,
     "stderr": "is not a provider name"},
    {"id": "disconnect-names-account-and-workspace", "argv": ["accounts", "disconnect", "ACCOUNT", "--cloud-workspace", "WS", "--json"], "exit": 3,
     "command": "accounts disconnect", "context": {"cloud_workspace": "WS", "connected_account": "ACCOUNT"}},
    {"id": "disconnect-refuses-provider-name", "argv": ["accounts", "disconnect", "slack", "--cloud-workspace", "WS"], "exit": 2,
     "stderr": "is not a connected account ID"},
    {"id": "configure-preview", "argv": ["ai-tools", "configure", "codex", "--cloud-workspace", "WS", "--dry-run", "--json"], "home": true, "paired": true, "exit": 0,
     "command": "ai-tools configure", "expect": {"state": "preview", "mode": "dry-run", "ai_tool": "codex", "cloud_workspace": "WS", "action": "create_file", "written": false}},
    {"id": "configure-apply-writes", "argv": ["ai-tools", "configure", "codex", "--cloud-workspace", "WS", "--apply", "--json"], "home": true, "guard_home": true, "paired": true, "exit": 0,
     "command": "ai-tools configure", "expect": {"state": "applied", "mode": "apply", "action": "create_file", "written": true}},
    {"id": "configure-needs-connect", "argv": ["ai-tools", "configure", "codex", "--dry-run", "--json"], "home": true, "guard_home": true, "paired": false, "exit": 4,
     "command": "ai-tools configure", "expect": {"reason": "not_paired"}},
    {"id": "restore-without-a-copy", "argv": ["ai-tools", "restore", "codex", "--json"], "home": true, "guard_home": true, "exit": 0,
     "command": "ai-tools restore", "expect": {"state": "nothing_to_restore", "restored": false}},
    {"id": "configure-needs-explicit-mode", "argv": ["ai-tools", "configure", "codex", "--cloud-workspace", "WS"], "exit": 2,
     "stderr": "one of the arguments --dry-run --apply is required"},
    {"id": "configure-one-mode", "argv": ["ai-tools", "configure", "codex", "--cloud-workspace", "WS", "--dry-run", "--apply"], "exit": 2,
     "stderr": "not allowed with argument"},
    {"id": "verify-uses-selected-workspace", "argv": ["ai-tools", "verify", "claude-code", "--json"], "exit": 3,
     "command": "ai-tools verify", "context": {"ai_tool": "claude-code"}},
    {"id": "no-abbreviated-flags", "argv": ["status", "--cloud", "WS"], "exit": 2,
     "stderr": "unrecognized arguments: --cloud"},
    {"id": "login-was-removed", "argv": ["login", "--json"], "guard_home": true, "exit": 4,
     "command": "login", "expect": {"state": "removed", "reason": "use_hol_guard_connect", "next_command": "hol-guard connect"}},
    {"id": "login-with-alpha-options-was-removed", "argv": ["login", "--cloud-url", "https://hol.org", "--cloud-workspace", "WS", "--profile", "work", "--timeout", "60", "--no-browser", "--json"], "guard_home": true, "exit": 4,
     "command": "login", "expect": {"state": "removed", "reason": "use_hol_guard_connect"}},
    {"id": "logout-was-removed", "argv": ["logout", "--profile", "work", "--json"], "guard_home": true, "exit": 4,
     "command": "logout", "expect": {"state": "removed", "reason": "use_hol_guard_connect", "next_command": "hol-guard connect"}},
    {"id": "profile-option-was-removed", "argv": ["status", "--profile", "work"], "exit": 2,
     "stderr": "unrecognized arguments: --profile"}
  ]
}
