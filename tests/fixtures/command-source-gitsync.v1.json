    "schema": "guard.command-extension-build.v1",
    "base": "packaged",
    "sources": [
      {
        "extension": {
          "action_classes": [
            "gitsync mirror-mutating command",
            "gitsync webhook-rewriting command",
            "gitsync service-install command"
          ],
          "aliases": [],
          "conflicts": [],
          "delegated_protection": null,
          "dependencies": [],
          "description": "Reviews gitsync's live mirror sync, server-side webhook rewrites, and service install/uninstall. `check`, `status`, plain `hooks`, and `run --dry-run` do not match any rule here; Guard's default floor still applies to them since gitsync is not on the built-in safe-command list and no rule in this extension matches those subcommands.",
