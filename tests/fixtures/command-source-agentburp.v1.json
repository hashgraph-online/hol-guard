                        "-h"
                      ],
                      "paths": [
                        [
                          "project",
                          "create"
                        ],
                        [
                          "project",
                          "open"
                        ],
                        [
                          "project",
                          "delete"
                        ]
                      ]
                    },
                    "matchers": []
                  }
                }
