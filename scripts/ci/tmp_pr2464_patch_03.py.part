text = tests_path.read_text(encoding="utf-8")
pid_test_pattern = re.compile(
    r"def test_guard_daemon_pid_matches_command_validates_guard_home_on_windows"
    r"\(tmp_path, monkeypatch\):\n.*?"
    r"(?=\n\ndef test_guard_daemon_pid_matches_command_accepts_console_script_launch)",
    re.DOTALL,
)
text, replaced = pid_test_pattern.subn(
    lambda _match: PID_TEST_REPLACEMENT,
    text,
    count=1,
)
if replaced != 1:
    raise RuntimeError("could not update Windows PID identity test")

inventory_test_pattern = re.compile(
    r"def test_windows_daemon_inventory_is_bounded_strict_and_guard_home_scoped"
    r"\(tmp_path, monkeypatch\) -> None:\n.*?"
    r'(?=\n\n@pytest\.mark\.skipif\(os\.name == "nt", reason="POSIX process-list coverage"\))',
    re.DOTALL,
)
text, replaced = inventory_test_pattern.subn(
    lambda _match: INVENTORY_TEST_REPLACEMENT,
    text,
    count=1,
)
if replaced != 1:
    raise RuntimeError("could not update Windows inventory test")
tests_path.write_text(text, encoding="utf-8")

new_tests_path = Path("tests/test_windows_processes.py")
if new_tests_path.exists():
    raise RuntimeError("native Windows process tests unexpectedly already exist")
new_tests_path.write_text(TEST_CONTENT, encoding="utf-8")

bounded_http_path = Path("src/codex_plugin_scanner/guard/daemon/bounded_http.py")
text = bounded_http_path.read_text(encoding="utf-8")
old_limits = "_MAX_SOCKET_TIMEOUT_SECONDS = 30.0\n"
new_limits = (
    "_MAX_SOCKET_TIMEOUT_SECONDS = 30.0\n"
    "_OVERLOAD_REQUEST_DRAIN_LIMIT_BYTES = 16 * 1024\n"
    "_OVERLOAD_REQUEST_DRAIN_TIMEOUT_SECONDS = 0.05\n"
)
text = replace_once(
    text,
    old_limits,
    new_limits,
    "bounded HTTP overload drain limits",
)

old_reject = '''    def _reject_overload(self, request: socket.socket) -> None:
        try:
            request.settimeout(0.25)
            request.sendall(_overload_response())
        except (BrokenPipeError, ConnectionAbortedError, ConnectionResetError, OSError):
            _METRICS.abort()
'''
new_reject = '''    def _reject_overload(self, request: socket.socket) -> None:
        try:
            _drain_overload_request(request)
            request.settimeout(0.25)
            request.sendall(_overload_response())
        except OSError:
            _METRICS.abort()
'''
text = replace_once(
    text,
    old_reject,
    new_reject,
    "bounded HTTP overload response",
)

old_class = "class BoundedThreadingHTTPServer(ThreadingHTTPServer):\n"
new_class = '''def _drain_overload_request(request: socket.socket) -> None:
    # Drain only a bounded request header so Windows can deliver the 503 before close.

    request.settimeout(_OVERLOAD_REQUEST_DRAIN_TIMEOUT_SECONDS)
    remaining = _OVERLOAD_REQUEST_DRAIN_LIMIT_BYTES
    trailing = b""
    while remaining > 0:
        try:
            chunk = request.recv(min(4096, remaining))
        except OSError:
            return
        if not chunk:
            return
        remaining -= len(chunk)
        combined = trailing + chunk
        if b"\\r\\n\\r\\n" in combined or b"\\n\\n" in combined:
            return
        trailing = combined[-3:]


class BoundedThreadingHTTPServer(ThreadingHTTPServer):
'''
text = replace_once(
    text,
    old_class,
    new_class,
    "bounded HTTP overload request drain",
)
bounded_http_path.write_text(text, encoding="utf-8")

runtime_path = Path("rust/crates/guard-runtime/src/main.rs")
text = runtime_path.read_text(encoding="utf-8")
text = replace_once(
    text,
    "#[cfg(unix)]\nuse std::sync::atomic::{AtomicBool, Ordering};\n",
    "",
    "runtime Unix atomic import",
)
text = replace_once(
    text,
    "Result<Arc<AtomicBool>, String>",
    "Result<Arc<std::sync::atomic::AtomicBool>, String>",
    "runtime parent liveness result type",
)
text = replace_once(
    text,
    "Arc::new(AtomicBool::new(true))",
    "Arc::new(std::sync::atomic::AtomicBool::new(true))",
    "runtime parent liveness atomic",
)
text = text.replace(
    "Ordering::Release",
    "std::sync::atomic::Ordering::Release",
)
text = text.replace(
    "Ordering::Acquire",
    "std::sync::atomic::Ordering::Acquire",
)
runtime_path.write_text(text, encoding="utf-8")

secure_fs_path = Path("rust/crates/guard-secure-fs/src/lib.rs")
text = secure_fs_path.read_text(encoding="utf-8")
old_canonical_dir = '''fn canonical_dir(path: &Path) -> Option<PathBuf> {
    let canonical = fs::canonicalize(path).ok()?;
    canonical.is_dir().then_some(canonical)
}
'''
new_canonical_dir = '''fn canonical_dir(path: &Path) -> Option<PathBuf> {
    fs::canonicalize(path).ok().and_then(|canonical| canonical.is_dir().then_some(canonical))
}
'''
text = replace_once(
    text,
    old_canonical_dir,
    new_canonical_dir,
    "secure fs canonical directory helper",
)
old_sibling_marker = '''    let marker = checkout.join(".git");
    match fs::symlink_metadata(&marker) {
        Ok(metadata) => {
            !metadata.file_type().is_symlink() && (metadata.is_file() || metadata.is_dir())
        }
        Err(_) => false,
    }
'''
new_sibling_marker = '''    fs::symlink_metadata(checkout.join(".git")).is_ok_and(|metadata| {
        !metadata.file_type().is_symlink() && (metadata.is_file() || metadata.is_dir())
    })
'''
text = replace_once(
    text,
    old_sibling_marker,
    new_sibling_marker,
    "secure fs sibling checkout marker",
)
secure_fs_path.write_text(text, encoding="utf-8")

# Parse every modified Python file before invoking project tooling.
for path in (
    module_path,
    manager_path,
    tests_path,
    new_tests_path,
    bounded_http_path,
):
    ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
