{
  "extension": {
    "action_classes": [
      "Theourgia external-runner evaluation command",
      "Theourgia block deletion command",
      "Theourgia log installation command",
      "Theourgia committed store change command",
      "Theourgia draft change command"
    ],
    "aliases": [],
    "conflicts": [],
    "delegated_protection": null,
    "dependencies": [],
    "description": "Reviews Theourgia commands that run code through an external interpreter, delete blocks, install log segments, or change the committed store or a writer's drafts, while leaving the read-only verbs (outline, search, refs, read, grep, log, diff, check and the exports) unmatched.",
    "ecosystem_ids": [],
    "executables": [
      "theourgia"
    ],
    "extension_id": "command.theourgia",
    "homepage": "https://github.com/guenchi/Theourgia",
    "icon": {
      "background": "#4338CA",
      "kind": "react-icon",
      "name": "HiMiniCube"
    },
    "license": "Apache-2.0",
    "name": "Theourgia command protection",
    "permissions": [
      {
        "action_classes": [
          "Theourgia external-runner evaluation command"
        ],
        "baseline_floor": "review",
        "configurable": true,
        "conflicts": [],
        "default_enabled": true,
        "dependencies": [],
        "deprecated": false,
        "description": "Identifies `theourgia eval --lang <language>` for a language other than `scheme`. Those runners (node, python3, sh, or Chez outside the sandbox) start an interpreter that reaches whatever it can reach on the machine; only `--lang scheme`, the default, runs in the sandbox with no filesystem and no network. This community coverage does not certify the upstream tool or every Theourgia feature.",
        "example_command": "theourgia eval --lang python 'print(1)'",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "label": "Theourgia evaluation through an external interpreter",
        "permission_id": "command.theourgia.permission.eval-runner",
        "replacement_permission_id": null,
        "risk_tier": "high",
        "safer_guidance": [
          "Evaluate Scheme in the sandbox (`theourgia eval <source>`, or `--lang scheme`) when the task allows it.",
          "External runners stay off unless the operator sets THEOURGIA_RUNNERS=on; confirm the source text and the working directory before approving one."
        ],
        "typed_capabilities": []
      },
      {
        "action_classes": [
          "Theourgia block deletion command"
        ],
        "baseline_floor": "review",
        "configurable": true,
        "conflicts": [],
        "default_enabled": true,
        "dependencies": [],
        "deprecated": false,
        "description": "Identifies `theourgia del <id>`, which retires a block, and `theourgia import-md` or `theourgia import-code` with `--allow-delete`, which retire the blocks whose files or sections have disappeared from the imported directory. This community coverage does not certify the upstream tool or every Theourgia feature.",
        "example_command": "theourgia del f0sjkuzn.4",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "label": "Theourgia block deletion",
        "permission_id": "command.theourgia.permission.delete",
        "replacement_permission_id": null,
        "risk_tier": "high",
        "safer_guidance": [
          "Read the block and what refers to it first: `theourgia read <id> --recursive` and `theourgia refs <id>`.",
          "Run the import without --allow-delete first; its answer lists the files and sections that are absent instead of deleting them."
        ],
        "typed_capabilities": []
      },
      {
        "action_classes": [
          "Theourgia log installation command"
        ],
        "baseline_floor": "review",
        "configurable": true,
        "conflicts": [],
        "default_enabled": true,
        "dependencies": [],
        "deprecated": false,
        "description": "Identifies `theourgia publish`, which installs a segment file into a writer's log, and `theourgia adopt`, which takes records that are on disk into the log. Both change the store's history from files outside it. This community coverage does not certify the upstream tool or every Theourgia feature.",
        "example_command": "theourgia publish w1 3 ./000003.sexp",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "label": "Theourgia log installation",
        "permission_id": "command.theourgia.permission.log-install",
        "replacement_permission_id": null,
        "risk_tier": "high",
        "safer_guidance": [
          "Run `theourgia check` before and after, and confirm where the segment or the on-disk records came from."
        ],
        "typed_capabilities": []
      },
      {
        "action_classes": [
          "Theourgia committed store change command"
        ],
        "baseline_floor": "review",
        "configurable": true,
        "conflicts": [],
        "default_enabled": true,
        "dependencies": [],
        "deprecated": false,
        "description": "Identifies the Theourgia verbs that change the committed store: `insert`, `set`, `move`, `link`, `unlink`, `def`, `commit`, `batch` (which reads its changes from standard input, deletions included), `import-md`, `import-code` and `supply`. This community coverage does not certify the upstream tool or every Theourgia feature.",
        "example_command": "theourgia commit f0sjkuzn.4",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "label": "Theourgia committed store change",
        "permission_id": "command.theourgia.permission.store-write",
        "replacement_permission_id": null,
        "risk_tier": "medium",
        "safer_guidance": [
          "Inspect what a commit will install with `theourgia drafts` before approving it.",
          "Read the intents piped to `theourgia batch` before approving it; they may include deletions."
        ],
        "typed_capabilities": []
      },
      {
        "action_classes": [
          "Theourgia draft change command"
        ],
        "baseline_floor": "review",
        "configurable": true,
        "conflicts": [],
        "default_enabled": true,
        "dependencies": [],
        "deprecated": false,
        "description": "Identifies `theourgia write`, `theourgia restore` and `theourgia discard`, which save, bring back or throw away a writer's private draft of a block. A draft is not in the committed store and no other writer sees it until `commit`. This community coverage does not certify the upstream tool or every Theourgia feature.",
        "example_command": "theourgia discard f0sjkuzn.4",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "label": "Theourgia draft change",
        "permission_id": "command.theourgia.permission.draft",
        "replacement_permission_id": null,
        "risk_tier": "low",
        "safer_guidance": [
          "List the writer's drafts with `theourgia drafts` before discarding one; a discarded draft is not kept."
        ],
        "typed_capabilities": []
      }
    ],
