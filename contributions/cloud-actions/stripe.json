    {
      "actionId": "stripe.balance.get",
      "title": "Read the account balance",
      "executor": {
        "kind": "declarative-http",
        "request": {
          "method": "GET",
          "host": "api.stripe.com",
          "path": "/v1/balance",
          "headers": [
            {
              "name": "accept",
              "value": "application/json"
            }
          ],
          "maxPages": 1
        }
      },
      "arguments": {},
      "facts": {
        "class": "read",
        "object": {
          "const": "payment"
        },
        "scope": {
          "const": "single"
        }
      },
      "response": {
        "maxBytes": 16384,
        "fields": [
          {
            "name": "available",
            "value": {
              "list": {
                "from": "available",
                "maxItems": 32,
                "fields": [
                  {
                    "name": "amount",
                    "value": {
                      "from": "amount"
                    }
                  },
                  {
                    "name": "currency",
                    "value": {
                      "from": "currency"
                    }
                  }
                ]
              }
            }
          },
          {
            "name": "pending",
            "value": {
              "list": {
                "from": "pending",
                "maxItems": 32,
                "fields": [
                  {
                    "name": "amount",
                    "value": {
                      "from": "amount"
                    }
                  },
                  {
                    "name": "currency",
                    "value": {
                      "from": "currency"
                    }
                  }
                ]
              }
            }
          }
        ]
      },
      "safety": {
        "effect": "read",
        "requiredCapabilities": [
          "bounded-output",
          "egress-pinned"
        ],
        "idempotency": "safe-read",
        "scopes": [
          "read_write"
        ],
        "maxItems": 1,
        "minIntervalMs": 250,
        "timeoutMs": 10000
      },
      "fixtures": [
        {
          "name": "reads the balance",
          "kind": "safe",
          "arguments": {},
          "expect": {
            "facts": {
              "class": "read",
              "object": {
                "state": "known",
                "value": "payment"
              },
              "scope": {
                "state": "known",
                "value": "single"
              }
            },
            "decisions": {
              "balanced": "allow",
              "relaxed": "allow",
              "strict": "allow"
            }
          }
        },
        {
          "name": "refuses an unknown argument",
          "kind": "risky",
          "arguments": {
            "account": "acct_x"
          },
          "expect": {
            "error": "unknown_argument"
          }
        }
      ]
    },
    {
      "actionId": "stripe.refunds.create",
