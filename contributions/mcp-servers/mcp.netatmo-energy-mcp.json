{
  "schemaVersion": "guard.mcp-server-contribution.v1",
  "id": "mcp.netatmo-energy-mcp",
  "version": "1.0.0",
  "name": "Netatmo Energy MCP",
  "description": "Reads Netatmo smart thermostat and radiator valve data (room temperatures, setpoints, boiler heat demand, history, schedules) through the official Netatmo API. Optional write mode changes the real heating: room setpoints, away/frost-guard mode and schedules. Off until you turn it on.",
  "trustClass": "external",
  "activation": "opt-in",
  "publisher": {
    "id": "io.github.christophe77",
    "displayName": "christophe77",
    "url": "https://github.com/christophe77"
  },
  "icon": {
    "kind": "react-icon",
    "name": "HiMiniBolt",
    "background": "#0F172A"
  },
  "homepage": "https://github.com/christophe77/netatmo-energy-mcp",
  "license": "Apache-2.0",
  "launch": {
    "kind": "package-launcher",
    "command": "npx",
    "package": "netatmo-energy-mcp"
  },
  "riskClasses": [
    "external-network-read",
    "external-account-read",
    "external-device-control",
    "external-shared-state-write",
    "local-file-write"
  ],
  "tools": [
    {
      "name": "netatmo_list_homes",
      "state": "inherit"
    },
    {
      "name": "netatmo_get_home",
      "state": "inherit"
    },
    {
      "name": "netatmo_list_rooms",
      "state": "inherit"
    },
    {
      "name": "netatmo_list_devices",
      "state": "inherit"
    },
    {
      "name": "netatmo_get_home_status",
      "state": "inherit"
    },
    {
      "name": "netatmo_get_room_status",
      "state": "inherit"
    },
    {
      "name": "netatmo_get_heating_status",
      "state": "inherit"
    },
    {
      "name": "netatmo_get_device_status",
      "state": "inherit"
    },
    {
      "name": "netatmo_get_schedules",
      "state": "inherit"
    },
    {
      "name": "netatmo_get_temperature_history",
      "state": "inherit"
    },
    {
      "name": "netatmo_get_setpoint_history",
      "state": "inherit"
    },
    {
      "name": "netatmo_get_boiler_history",
      "state": "inherit"
    },
    {
      "name": "netatmo_get_heating_summary",
      "state": "inherit"
    },
    {
      "name": "netatmo_compare_rooms",
      "state": "inherit"
    },
    {
      "name": "netatmo_detect_anomalies",
      "state": "inherit"
    },
    {
      "name": "netatmo_set_room_setpoint",
      "state": "review"
    },
    {
      "name": "netatmo_set_home_mode",
      "state": "review"
    },
    {
      "name": "netatmo_switch_schedule",
      "state": "review"
    },
    {
      "name": "netatmo_create_schedule",
      "state": "review"
    },
    {
      "name": "netatmo_update_schedule",
      "state": "review"
    },
    {
      "name": "netatmo_rename_schedule",
      "state": "review"
    },
    {
      "name": "other",
      "state": "review"
    }
  ],
  "referenceUrls": [
    "https://github.com/christophe77/netatmo-energy-mcp",
    "https://github.com/christophe77/netatmo-energy-mcp#write-mode-heating-control",
    "https://www.npmjs.com/package/netatmo-energy-mcp"
  ],
  "saferAlternatives": [
    "Log in without --write: the token only has the read_thermostat scope and the six heating-control tools are not registered.",
    "Set NETATMO_MCP_WRITE=0 to force read-only mode even after a write-enabled login.",
    "Set NETATMO_MCP_CONFIRM=elicitation so every heating change needs a confirmation prompt shown by the client, not only a preview token.",
    "Write limits: temperatures stay within 7 to 28 degrees C by default and manual setpoints always expire (24 h at most); every change is appended to changes.log.",
    "Pin the package version when launching with npx (for example netatmo-energy-mcp@0.3.2) so only the reviewed release runs."
  ]
}
