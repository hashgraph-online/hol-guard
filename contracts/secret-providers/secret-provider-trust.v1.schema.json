{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hol.org/schemas/secret-provider-trust.v1.json",
  "title": "Guard secret provider trust binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "provider_id", "publisher_id", "manifest_digest", "schema_version", "adapter_version", "status", "default_enabled", "local_enablement_required", "supported_capabilities", "supported_platforms", "conformance_digest"],
  "properties": {
    "schema": { "const": "guard.secret-provider-trust.v1" },
    "provider_id": { "type": "string", "pattern": "^provider\\.[a-z][a-z0-9._-]{0,62}$" },
    "publisher_id": { "type": "string", "pattern": "^publisher\\.[a-z][a-z0-9._-]{0,62}$" },
    "manifest_digest": { "type": "string", "minLength": 1, "maxLength": 128 },
    "schema_version": { "const": "guard.secret-provider.v1" },
    "adapter_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "status": { "enum": ["first_party", "external"] },
    "default_enabled": { "const": false },
    "local_enablement_required": { "const": true },
    "supported_capabilities": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "enum": ["secret.metadata", "secret.resolve", "secret.lease", "secret.verify"] } },
    "supported_platforms": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "enum": ["macos", "linux", "windows"] } },
    "conformance_digest": { "type": "string", "minLength": 1, "maxLength": 128 }
  }
}
