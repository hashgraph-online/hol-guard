                    "search"
                  ],
                  [
                    "./.agents/skills/rozee-search/cli/src/cli.ts",
                    "search"
                  ],
                  [
                    "run",
                    ".agents/skills/rozee-search/cli/src/cli.ts",
                    "detail"
                  ],
                  [
                    "run",
                    "./.agents/skills/rozee-search/cli/src/cli.ts",
                    "detail"
                  ],
                  [
