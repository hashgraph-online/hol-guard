        "deprecated": false,
        "description": "Identifies `batterycontrol discharge start --allow-below-floor`, which consents to draining below the 20% safety floor. Upstream documents this as deliberate battery wear and the daemon enforces its own consent check.",
        "example_command": "batterycontrol discharge start 10 --allow-below-floor",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
