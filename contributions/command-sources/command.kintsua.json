    "permissions": [
      {
        "action_classes": [
          "Kintsua hosted snapshot push"
        ],
        "baseline_floor": "review",
        "configurable": true,
        "conflicts": [],
        "default_enabled": true,
        "dependencies": [],
        "deprecated": false,
        "description": "Identifies `kintsua watch snapshot --push` and `kintsua watch diff --push`, which send the captured tool schemas to a hosted Kintsua service authenticated by an SDK key. exec and xargs launches are blocked by Guard's wrapper floor.",
        "example_command": "kintsua watch diff --server https://mcp.vendor.com/mcp --name vendor --push --repo acme/agent",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "label": "Kintsua hosted snapshot push",
        "permission_id": "command.kintsua.permission.hosted-push",
        "replacement_permission_id": null,
        "risk_tier": "medium",
        "safer_guidance": [
          "Run without `--push` to keep the snapshot local; the lockfile and history.jsonl are sufficient for CI gating.",
          "Review `--repo`, `--url` and the `KINTSUA_KEY` environment variable before sending a snapshot to a hosted service."
        ],
        "typed_capabilities": []
      },
      {
        "action_classes": [
          "Kintsua lockfile baseline rewrite"
        ],
        "baseline_floor": "review",
        "configurable": true,
        "conflicts": [],
        "default_enabled": true,
        "dependencies": [],
        "deprecated": false,
        "description": "Identifies `kintsua watch snapshot` and `kintsua watch diff --update`, which overwrite the committed `.kintsua/<name>.lock.json` baseline that later diffs are judged against. A rewritten baseline can silently accept an upstream breaking change. exec and xargs launches are blocked by Guard's wrapper floor.",
        "example_command": "kintsua watch snapshot --server https://mcp.vendor.com/mcp --name vendor",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "label": "Kintsua lockfile baseline rewrite",
        "permission_id": "command.kintsua.permission.lockfile-rewrite",
        "replacement_permission_id": null,
        "risk_tier": "medium",
        "safer_guidance": [
          "Run `kintsua watch diff` first and read the classified change table before rewriting the lockfile.",
          "Keep `.kintsua/*.lock.json` under version control so a baseline rewrite is visible in the pull request diff."
        ],
        "typed_capabilities": []
      }
