{
  "schemaVersion": "guard.mcp-server-contribution.v1",
  "id": "mcp.agentic-linkedin",
  "version": "1.0.0",
  "name": "agentic-linkedin",
  "description": "Reviews agentic-linkedin MCP tools that post, message, connect and edit a signed-in LinkedIn account. Reads of public profile data are allowed; private messages and every write need review. Off until you turn it on.",
  "trustClass": "external",
  "activation": "opt-in",
  "publisher": {
    "id": "github.darklvrd",
    "displayName": "DarkLvrd",
    "url": "https://github.com/DarkLvrd"
  },
  "icon": {
    "kind": "react-icon",
    "name": "HiMiniGlobeAlt",
    "background": "#0A66C2"
  },
  "homepage": "https://github.com/DarkLvrd/linkedin-mcp",
  "license": "MIT",
  "launch": {
    "kind": "package-launcher",
    "command": "npx",
    "package": "agentic-linkedin@0.1.0"
  },
  "riskClasses": [
    "external-account-read",
    "external-private-data-and-messaging",
    "external-public-publishing",
    "external-message-egress",
    "external-content-deletion",
    "external-shared-state-write",
    "external-signed-in-browser-actions",
    "local-file-write"
  ],
