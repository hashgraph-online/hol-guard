        "replacement_permission_id": null,
        "risk_tier": "high",
        "safer_guidance": [
          "Send the equivalent GET request first to confirm the target resource and environment.",
          "Run against a dev or staging environment, or mark the target environment with `heaven env set NAME --protected`."
        ],
        "typed_capabilities": []
      },
      {
        "action_classes": [
          "Heaven flow run"
        ],
        "baseline_floor": "review",
        "configurable": true,
