{
  "schemaVersion": "guard.mcp-server-contribution.v1",
  "id": "mcp.omarchy-mcp",
  "version": "1.0.0",
  "name": "Omarchy MCP",
  "description": "Remote AI agent dispatch to Omarchy VM \u2014 Claude Code, Codex CLI, Hermes Agent, Grok CLI, plus file ops and whitelisted shell. Conservative defaults: dispatch and write tools blocked, reads inherited.",
  "trustClass": "external",
  "activation": "opt-in",
  "publisher": {
    "id": "github.jpeetz",
    "displayName": "JPeetz",
    "url": "https://github.com/JPeetz/omarchy-mcp"
  },
  "icon": {
    "kind": "react-icon",
    "name": "HiMiniCube",
    "background": "#1E3A5F"
  },
  "homepage": "https://github.com/JPeetz/omarchy-mcp",
  "license": "MIT",
  "launch": {
    "kind": "package-launcher",
    "command": "pipx",
    "package": "omarchy-mcp"
  },
  "riskClasses": [
    "remote-execution",
    "ai-agent-dispatch",
    "filesystem-write"
  ],
  "tools": [
    {
      "name": "system_run",
      "state": "block"
    },
    {
      "name": "file_write",
      "state": "block"
    },
    {
      "name": "claude_execute",
      "state": "block"
    },
    {
      "name": "codex_execute",
      "state": "block"
    },
    {
      "name": "file_read",
      "state": "inherit"
    },
    {
      "name": "file_list",
      "state": "inherit"
    },
    {
      "name": "status",
      "state": "inherit"
    },
    {
      "name": "hermes_execute",
      "state": "block"
    },
    {
      "name": "grok_execute",
      "state": "block"
    },
    {
      "name": "other",
      "state": "review"
    }
  ],
  "referenceUrls": [
    "https://github.com/JPeetz/omarchy-mcp",
    "https://github.com/NousResearch/hermes-agent/pull/111710"
  ],
  "saferAlternatives": [
    "Configure OMARCHY_MCP_TOKEN as the server's Bearer token; rely on Guard policy (the block states above) to scope what the agent may call.",
    "claude_execute and codex_execute are opt-in \u2014 only enable when remote dispatch is needed.",
    "For read-only access there is no separate token scope — rely on Guard policy to keep write and dispatch tools blocked."
  ]
}
