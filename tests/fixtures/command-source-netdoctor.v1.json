              "risk_tier": "low",
              "safer_guidance": [
                "One-shot netdoctor checks only resolve, ping, connect to, and request the named targets; confirm the target hosts are ones you intend to contact."
              ],
              "typed_capabilities": []
            },
            {
              "action_classes": [
                "netdoctor continuous monitor"
              ],
              "baseline_floor": "review",
              "configurable": true,
              "conflicts": [],
              "default_enabled": true,
              "dependencies": [],
              "deprecated": false,
              "description": "netdoctor --watch and --mtr re-run DNS, TCP, HTTP, or traceroute probes against the targets on an interval and keep running until interrupted unless --max-runs is set.",
              "example_command": "netdoctor github.com --watch",
              "family": null,
