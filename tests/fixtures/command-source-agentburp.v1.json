        "extension": {
          "extension_id": "command.agentburp",
          "version": "1.0.0",
          "name": "AgentBurp project protection",
          "description": "Reviews project creation, active project changes, and project deletion after local opt-in.",
          "action_classes": [
            "AgentBurp project modification"
          ],
          "risk_classes": [
            "data_modification"
          ],
          "safer_alternatives": [
            "List projects with agentburp project list before changing the active project.",
            "Confirm the project name before deleting it."
          ],
          "reference_urls": [
            "https://github.com/msdbg/AgentBurp/blob/69da946fc13f2dbff6d37ab30fd26a403c054051/cmd/project.go",
            "https://github.com/msdbg/AgentBurp/blob/69da946fc13f2dbff6d37ab30fd26a403c054051/cmd/root.go"
          ],
          "required": false,
          "source": "built-in",
