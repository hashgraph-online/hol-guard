{
  "schema": "guard.command-extension-fixtures.v1",
  "build": {
    "schema": "guard.command-extension-build.v1",
    "base": "packaged",
    "sources": [
      {
        "schema": "guard.command-extension-source.v1",
        "extension": {
          "extension_id": "command.redpen",
          "version": "1.0.0",
          "name": "Redpen",
          "description": "Reviews Redpen check, which independently executes repository-defined verification commands and writes an evidence report. Output formatting is not a dry run. Cached report/status/explain commands do not rerun project verification. Boundary reviewed against Redpen 0.3.0 and commit 466df0f (0.4.0 development).",
          "action_classes": [
            "Redpen project verification execution"
          ],
          "risk_classes": [
            "execution",
            "network_egress"
          ],
          "safer_alternatives": [
            "Use redpen report to display the saved evidence receipt without rerunning project commands.",
            "Review repository scripts and .redpen/config.json before authorizing redpen check."
          ],
          "reference_urls": [
            "https://github.com/ChiragArora31/Redpen/blob/466df0f/src/cli.ts",
            "https://github.com/ChiragArora31/Redpen/blob/466df0f/src/system/process.ts",
            "https://github.com/ChiragArora31/Redpen/blob/466df0f/SECURITY.md"
          ],
          "required": false,
          "source": "built-in",
          "aliases": [],
          "dependencies": [],
          "conflicts": [],
          "ecosystem_ids": [],
          "executables": [
            "redpen",
            "redpen.cmd",
            "redpen.exe",
            "redpen-cli",
            "redpen-cli.cmd",
            "redpen-cli.exe"
          ],
          "project_markers": [],
          "publisher": {
            "id": "community.chiragarora31",
            "display_name": "Chirag Arora",
            "url": "https://github.com/ChiragArora31"
          },
          "homepage": "https://github.com/ChiragArora31/Redpen",
          "icon": {
            "kind": "none"
          },
          "license": "MIT",
          "permissions": [
            {
              "permission_id": "command.redpen.permission.check",
              "implementation_version": "1.0.0",
              "label": "Execute Redpen project verification",
              "description": "Allows Redpen to execute discovered/configured project tests, builds, lint, typechecks, regression checks, and custom verification commands. These commands are not sandboxed and may perform network or filesystem operations.",
              "risk_tier": "high",
              "baseline_floor": "review",
              "default_enabled": true,
              "configurable": true,
              "typed_capabilities": [],
              "action_classes": [
                "Redpen project verification execution"
              ],
              "dependencies": [],
              "conflicts": [],
              "implied_permissions": [],
              "introduced_version": "1.0.0",
              "deprecated": false,
              "safer_guidance": [
                "Inspect project scripts and configured verification commands before running checks in a repository you do not trust.",
                "Use redpen report for the last saved receipt; an agent completion or passing receipt is not authorization to execute commands."
              ],
              "example_command": "redpen check --json --timeout 120"
            }
          ],
          "rules": [
            {
              "rule_id": "command.redpen.check",
              "rule_version": "1.0.0",
              "permission_id": "command.redpen.permission.check",
              "title": "Redpen project verification execution",
              "description": "Identifies redpen check independently of output format or unrecognized options. Cached report/status/explain commands are outside this execution rule. Subcommand help is conservatively reviewed; no flag-based bypass is granted because shared flag grammars accept forms that Redpen does not treat as help. Direct node script paths, plugin hooks, and package downloads remain outside this rule and retain their existing floors.",
              "severity": "high",
              "risk_classes": [
                "execution",
                "network_egress"
              ],
              "action_classes": [
                "Redpen project verification execution"
              ],
              "safer_alternatives": [
                "Use redpen report to inspect the last saved verification result without executing project commands."
              ],
              "default_mode": "review",
              "safe_variants": [],
              "matcher": {
                "op": "executable.v1",
                "config": {
                  "executables": [
                    "redpen",
                    "redpen.cmd",
                    "redpen.exe",
                    "redpen-cli",
                    "redpen-cli.cmd",
                    "redpen-cli.exe"
                  ],
                  "subcommands": [
                    "check"
                  ],
                  "allow_leading_options": false,
                  "fail_secure_unknown_options": true
                }
              }
            }
          ]
        }
      }
    ],
