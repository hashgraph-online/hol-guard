        "routine-git-status-count",
        "routine-git-status-tracked-only"
      ],
      "floor": [
        "neg-redirect-null-sink-shell-profile-target",
        "neg-routine-git-status-writes-profile"
      ]
    },
    "safe_diff_query": {
