{
  "extension": {
    "action_classes": [
      "cs pin state command",
      "cs session archive command",
      "cs session resume command",
      "cs session summary command"
    ],
    "aliases": [],
    "conflicts": [],
    "delegated_protection": null,
    "dependencies": [],
    "description": "Reviews cs (Claude Sessions) commands that launch Claude Code in another folder, write pin or archive files, or send session text to a model for a recap. Read-only commands (ls, show) are not matched.",
    "ecosystem_ids": [],
    "executables": [],
    "extension_id": "command.cs",
    "homepage": "https://github.com/AryaKesharwani/claude-sessions",
    "icon": {
      "kind": "none"
    },
    "license": "MIT",
    "name": "cs (Claude Sessions) command protection",
    "permissions": [
      {
        "action_classes": [
          "cs session resume command"
        ],
        "baseline_floor": "review",
        "configurable": true,
        "conflicts": [],
        "default_enabled": true,
        "dependencies": [],
        "deprecated": false,
        "description": "Identifies `cs resume` (alias `cs r`) and `cs pick`, which change into the folder a past Claude Code session was started in and replace the process with `claude --resume <session-id>`. That starts an interactive agent with its normal tool access inside a directory other than the current one, where that folder's project settings, hooks and MCP servers apply. If the session exists only in cs's archive, the transcript is first copied back into ~/.claude/projects. `cs pick` ends in the same resume once a session is chosen. `cs resume --claude-args '<flags>'` forwards the string, split with shlex, to `claude` unchanged, so it can include flags such as `--dangerously-skip-permissions`; any form of the option is reviewed because the whole resume is. Only `--help`/`-h` is treated as safe; the bare `cs` picker is not matched by this rule.",
        "example_command": "cs resume 1a2b3c4d",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
        "introduced_version": "2.2.0",
        "label": "Claude Sessions resume",
        "permission_id": "command.cs.permission.resume",
        "replacement_permission_id": null,
        "risk_tier": "high",
        "safer_guidance": [
          "If you pass --claude-args, read the exact flags first; options such as --dangerously-skip-permissions turn off Claude Code's own prompts.",
          "Run `cs ls` or `cs show <id>` first to confirm which session and which folder you are about to enter.",
          "Check the target folder's .claude/settings.json, hooks and .mcp.json before resuming a session there.",
          "Resume from the session's own folder with `claude --resume <id>` if you want to see exactly what runs."
        ],
        "typed_capabilities": []
      },
      {
        "action_classes": [
          "cs pin state command"
        ],
        "baseline_floor": "review",
        "configurable": true,
        "conflicts": [],
        "default_enabled": true,
        "dependencies": [],
        "deprecated": false,
        "description": "Identifies `cs pin`, which toggles a session id in ~/.claude-sessions/pins.json (pin if absent, unpin if present). It writes only that small state file and does not touch session transcripts, but the same command both adds and removes, so repeating it reverses the change.",
        "example_command": "cs pin 1a2b3c4d",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
        "introduced_version": "2.2.0",
        "label": "Claude Sessions pin toggle",
        "permission_id": "command.cs.permission.pin",
        "replacement_permission_id": null,
        "risk_tier": "low",
        "safer_guidance": [
          "Run `cs ls` first to see which sessions are already pinned (shown with a star) before toggling one.",
          "The state is one JSON file, ~/.claude-sessions/pins.json; back it up if the current pins matter."
        ],
        "typed_capabilities": []
      },
      {
        "action_classes": [
          "cs session archive command"
        ],
        "baseline_floor": "review",
        "configurable": true,
        "conflicts": [],
        "default_enabled": true,
        "dependencies": [],
        "deprecated": false,
        "description": "Identifies `cs backup`, which copies every session transcript under ~/.claude/projects into ~/.claude-sessions/archive, replacing an archived copy whenever the live file is newer or a different size. Originals are not modified, but the archive keeps full transcripts, which can contain pasted secrets, beyond the point where Claude Code's own cleanup would delete them. It can also be run quietly with `-q`/`--quiet` (for example from cron).",
        "example_command": "cs backup",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
        "introduced_version": "2.2.0",
        "label": "Claude Sessions backup",
        "permission_id": "command.cs.permission.backup",
        "replacement_permission_id": null,
        "risk_tier": "medium",
        "safer_guidance": [
          "Check the size and contents of ~/.claude-sessions/archive after the first run, and exclude it from cloud sync if transcripts may hold secrets.",
          "Run `cs ls` to confirm which sessions exist before archiving them."
        ],
        "typed_capabilities": []
      },
      {
        "action_classes": [
          "cs session summary command"
        ],
        "baseline_floor": "review",
        "configurable": true,
        "conflicts": [],
        "default_enabled": true,
        "dependencies": [],
        "deprecated": false,
        "description": "Identifies `cs summary`, which builds a prompt from the session's typed messages (up to about 40 messages, each clipped to 400 characters, spread across the session) and sends it to the model through `claude -p --model haiku`. The text therefore leaves the machine to the model provider, and the recap is cached in ~/.claude-sessions/summaries.json. It runs with no tools and without saving a session, but the messages can include anything typed into the session, such as paths, names or credentials.",
        "example_command": "cs summary 1a2b3c4d",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
        "introduced_version": "2.2.0",
        "label": "Claude Sessions summary",
        "permission_id": "command.cs.permission.summary",
        "replacement_permission_id": null,
        "risk_tier": "high",
        "safer_guidance": [
          "Run `cs show <id>` first to read the messages that would be summarized; do not summarize a session that contains secrets or confidential material.",
          "Check which account the `claude` CLI is logged in to before sending session text for a recap."
        ],
        "typed_capabilities": []
      }
    ],
