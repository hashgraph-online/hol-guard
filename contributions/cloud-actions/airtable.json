{
  "schema": "guard.cloud-action-pack.v1",
  "provider": {
    "id": "airtable",
    "name": "Airtable",
    "publisher": {
      "name": "HOL",
      "verified": true
    }
  },
  "hosts": [
    "api.airtable.com"
  ],
  "auth": {
    "mode": "oauth2",
    "scopes": [
      "data.records:read",
      "data.records:write",
      "schema.bases:read"
    ]
  },
  "actions": [
    {
      "actionId": "airtable.records.list",
      "title": "List records in a table",
      "executor": {
        "kind": "declarative-http",
        "request": {
          "method": "GET",
          "host": "api.airtable.com",
          "path": "/v0/{base_id}/{table_id}",
          "query": [
            {
              "name": "pageSize",
              "value": {
                "arg": {
                  "name": "page_size",
                  "default": 100
                }
              }
            },
            {
              "name": "view",
              "value": {
                "arg": {
                  "name": "view"
                }
              }
            },
            {
              "name": "filterByFormula",
              "value": {
                "arg": {
                  "name": "formula"
                }
              }
            },
            {
              "name": "offset",
              "value": {
                "arg": {
                  "name": "offset"
                }
              }
            }
          ],
          "headers": [
            {
              "name": "accept",
              "value": "application/json"
            }
          ],
          "maxPages": 1
        }
      },
      "arguments": {
        "base_id": {
          "type": "string",
          "required": true,
          "maxLength": 17,
          "pattern": "^app[A-Za-z0-9]{14}$"
        },
        "table_id": {
          "type": "string",
          "required": true,
          "maxLength": 17,
          "pattern": "^tbl[A-Za-z0-9]{14}$"
        },
        "page_size": {
          "type": "integer",
          "required": false,
          "minimum": 1,
          "maximum": 100
        },
        "view": {
          "type": "string",
          "required": false,
          "maxLength": 64,
          "pattern": "^(?:viw[A-Za-z0-9]{14}|[A-Za-z0-9 _.()-]{1,64})$"
        },
        "formula": {
          "type": "string",
          "required": false,
          "maxLength": 2000,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "offset": {
          "type": "string",
          "required": false,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9/_-]{1,200}$"
        }
      },
      "facts": {
        "class": "read",
        "object": {
          "const": "record"
        },
        "scope": {
          "const": "query_selected"
        },
        "recordCount": {
          "argument": {
            "name": "page_size",
            "max": 100,
            "default": 100
          }
        }
      },
      "response": {
        "maxBytes": 1048576,
        "fields": [
          {
            "name": "records",
            "value": {
              "list": {
                "from": "records",
                "maxItems": 100,
                "fields": [
                  {
                    "name": "id",
                    "value": {
                      "from": "id"
                    }
                  },
                  {
                    "name": "created",
                    "value": {
                      "from": "createdTime"
                    }
                  },
                  {
                    "name": "name",
                    "value": {
                      "from": "fields.Name"
                    },
                    "untrusted": true
                  },
                  {
                    "name": "status",
                    "value": {
                      "from": "fields.Status"
                    },
                    "untrusted": true
                  },
                  {
                    "name": "notes",
                    "value": {
                      "from": "fields.Notes"
                    },
                    "untrusted": true
                  }
                ]
              }
            }
          },
          {
            "name": "offset",
            "value": {
              "from": "offset"
            }
          }
        ]
      },
      "safety": {
        "effect": "read",
        "requiredCapabilities": [
          "bounded-output",
          "egress-pinned"
        ],
        "idempotency": "safe-read",
        "scopes": [
          "data.records:read"
        ],
        "maxItems": 100,
        "minIntervalMs": 250,
        "timeoutMs": 10000
      },
      "fixtures": [
        {
          "name": "lists open tasks in a view",
          "kind": "safe",
          "arguments": {
            "base_id": "appA1b2C3d4E5f6G7",
            "table_id": "tblH8i9J0k1L2m3N4",
            "page_size": 50,
            "formula": "{Status}='Open'"
          },
          "expect": {
            "facts": {
              "class": "read"
            },
            "response": "{\"records\":[{\"id\":\"recO5p6Q7r8S9t0U1\",\"createdTime\":\"2026-11-01T09:00:00.000Z\",\"fields\":{\"Name\":\"Ship it\",\"Status\":\"Open\",\"Secret\":\"x\"}}]}",
            "projection": {
              "records": [
                {
                  "id": "recO5p6Q7r8S9t0U1",
                  "created": "2026-11-01T09:00:00.000Z",
                  "name": "Ship it",
                  "status": "Open"
                }
              ]
            },
            "request": {
              "body": null,
              "headers": [
                [
                  "accept",
                  "application/json"
                ]
              ],
              "maxPages": 1,
              "method": "GET",
              "url": "https://api.airtable.com/v0/appA1b2C3d4E5f6G7/tblH8i9J0k1L2m3N4?pageSize=50&filterByFormula=%7BStatus%7D%3D%27Open%27"
            },
            "decisions": {
              "balanced": "allow",
              "relaxed": "allow",
              "strict": "allow"
            }
          }
        },
        {
          "name": "refuses a page over 100",
          "kind": "risky",
          "arguments": {
            "base_id": "appA1b2C3d4E5f6G7",
            "table_id": "tblH8i9J0k1L2m3N4",
            "page_size": 500
          },
          "expect": {
            "error": "invalid_argument"
          }
        }
      ]
    },
