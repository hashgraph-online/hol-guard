{
  "schema": "guard.command-extension-source.v1",
  "extension": {
    "extension_id": "command.xrpl-muse-skill",
    "version": "1.0.0",
    "name": "XRPL Muse Skill protection",
    "description": "Guards the xrpl-muse-skill ceremony: xrpl-trade builds unsigned transaction proposals and never signs; xrpl-sign --approve is the sole hash-bound, policy-gated signer; fresh installs stay read-only until the typed xrpl-trade live ceremony. Proposal, signing, and gate-transition commands review; read-only queries stay inert.",
    "action_classes": [
      "xrpl transaction proposal",
      "xrpl transaction signing",
      "signing-gate transition",
      "xrpl read-only query"
    ],
    "risk_classes": [
      "financial_transaction"
    ],
    "safer_alternatives": [
      "Keep the skill in read-only mode and review each proposal before approving its hash.",
      "Verify the full 64-hex proposal hash out-of-band before running xrpl-sign --approve."
    ],
    "reference_urls": [
      "https://github.com/terramike/xrpl-muse-skill"
    ],
    "required": false,
    "source": "built-in",
    "aliases": [],
    "dependencies": [],
    "conflicts": [],
    "ecosystem_ids": [],
    "executables": [
      "xrpl-trade",
      "xrpl-sign"
    ],
    "project_markers": [],
    "permissions": [
      {
        "permission_id": "command.xrpl-muse-skill.permission.propose-trade",
        "implementation_version": "1.0.0",
        "label": "Propose XRPL DEX trades",
        "description": "xrpl-trade builds unsigned DEX offer proposals (buy, sell, cancel). It never signs or submits; every proposal needs human approval of its exact 64-hex hash via xrpl-sign.",
        "risk_tier": "high",
        "baseline_floor": "review",
        "default_enabled": true,
        "configurable": true,
        "typed_capabilities": [],
        "action_classes": [
          "xrpl transaction proposal"
        ],
        "dependencies": [],
        "conflicts": [],
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "deprecated": false,
        "safer_guidance": [
          "Review the proposal hash before approving.",
          "Stay in read-only mode until ready to transact."
        ],
        "example_command": "xrpl-trade buy --pair XRP/RLUSD --amount 10 --price 2.5"
      },
      {
        "permission_id": "command.xrpl-muse-skill.permission.propose-payment",
        "implementation_version": "1.0.0",
        "label": "Propose XRPL payments and trustlines",
        "description": "xrpl-trade builds unsigned Payment and TrustSet proposals (send, trustline). It never signs or submits; every proposal needs human approval of its exact 64-hex hash via xrpl-sign.",
        "risk_tier": "high",
        "baseline_floor": "review",
        "default_enabled": true,
        "configurable": true,
        "typed_capabilities": [],
        "action_classes": [
          "xrpl transaction proposal"
        ],
        "dependencies": [],
        "conflicts": [],
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "deprecated": false,
        "safer_guidance": [
          "Review the proposal hash before approving.",
          "Confirm the destination address out-of-band."
        ],
        "example_command": "xrpl-trade send --to r9e34ga9YxYHYoCe7UtWWpuLjp4iKs3gkB --amount 5"
      },
      {
        "permission_id": "command.xrpl-muse-skill.permission.propose-nft",
        "implementation_version": "1.0.0",
        "label": "Propose XRPL NFT actions",
        "description": "xrpl-trade builds unsigned NFT proposals (mint, list, buy, bid, send). It never signs or submits; every proposal needs human approval of its exact 64-hex hash via xrpl-sign.",
        "risk_tier": "high",
        "baseline_floor": "review",
        "default_enabled": true,
        "configurable": true,
        "typed_capabilities": [],
        "action_classes": [
          "xrpl transaction proposal"
        ],
        "dependencies": [],
        "conflicts": [],
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "deprecated": false,
        "safer_guidance": [
          "Review the proposal hash before approving."
        ],
        "example_command": "xrpl-trade nft-list --token-id 0008132E2A679C62B6FA2429A58B5D56F1"
      },
      {
        "permission_id": "command.xrpl-muse-skill.permission.propose-faucet",
        "implementation_version": "1.0.0",
        "label": "Claim testnet faucet funds",
        "description": "xrpl-trade faucet funds a fresh testnet/devnet wallet from the public faucet. Real transaction, valueless test funds only; rejected against mainnet by the skill.",
        "risk_tier": "medium",
        "baseline_floor": "review",
        "default_enabled": true,
        "configurable": true,
        "typed_capabilities": [],
        "action_classes": [
          "xrpl transaction proposal"
        ],
        "dependencies": [],
        "conflicts": [],
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "deprecated": false,
        "safer_guidance": [
          "Use testnet or devnet only; the skill refuses mainnet."
        ],
        "example_command": "xrpl-trade faucet --network testnet"
      },
      {
        "permission_id": "command.xrpl-muse-skill.permission.sign",
        "implementation_version": "1.0.0",
        "label": "Approve and sign XRPL transactions",
        "description": "xrpl-sign --approve is the sole signing path. Approval is bound to the full 64-hex proposal hash and gated by the local policy (spending caps, destination allowlist). This is the last human gate before funds move.",
        "risk_tier": "critical",
        "baseline_floor": "review",
        "default_enabled": true,
        "configurable": true,
        "typed_capabilities": [],
        "action_classes": [
          "xrpl transaction signing"
        ],
        "dependencies": [],
        "conflicts": [],
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "deprecated": false,
        "safer_guidance": [
          "Approve only the exact hash you reviewed.",
          "Never approve a hash you did not derive from an inspected proposal."
        ],
        "example_command": "xrpl-sign --approve --hash <64-hex> --profile main"
      },
      {
        "permission_id": "command.xrpl-muse-skill.permission.gate",
        "implementation_version": "1.0.0",
        "label": "Change the signing gate",
        "description": "xrpl-trade live leaves read-only mode through a typed ceremony; xrpl-trade autopilot manages local mainnet signing. Both weaken the default-deny posture and require explicit human intent.",
        "risk_tier": "high",
        "baseline_floor": "review",
        "default_enabled": true,
        "configurable": true,
        "typed_capabilities": [],
        "action_classes": [
          "signing-gate transition"
        ],
        "dependencies": [],
        "conflicts": [],
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "deprecated": false,
        "safer_guidance": [
          "Prefer staying in read-only mode.",
          "Re-enter read-only mode with xrpl-trade read-only when done."
        ],
        "example_command": "xrpl-trade live"
      },
      {
        "permission_id": "command.xrpl-muse-skill.permission.read",
        "implementation_version": "1.0.0",
        "label": "Read-only XRPL queries",
        "description": "Balance, quote, order-book, token-safety, and ledger-forensic reads. No transaction is built, signed, or submitted.",
        "risk_tier": "low",
        "baseline_floor": "allow",
        "default_enabled": true,
        "configurable": true,
        "typed_capabilities": [],
        "action_classes": [
          "xrpl read-only query"
        ],
        "dependencies": [],
        "conflicts": [],
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "deprecated": false,
        "safer_guidance": [
          "Read-only XRPL inspection does not move funds."
        ],
        "example_command": "xrpl-trade balance"
      }
    ],
