{
  "schema": "guard.command-extension-fixtures.v1",
  "build": {
    "base": "packaged",
    "schema": "guard.command-extension-build.v1",
    "sources": [
      {
        "schema": "guard.command-extension-source.v1",
        "extension": {
          "extension_id": "command.astrix",
          "version": "1.0.0",
          "name": "Astrix command protection",
          "description": "Classifies supported non-patching inspection, test-verification, repair, and initialization command forms. Coverage is limited to listed executables and subcommand patterns.",
          "action_classes": [
            "Astrix read-only inspection command",
            "Astrix test verification command",
            "Astrix workspace mutation command",
            "Astrix MCP server launch"
          ],
          "risk_classes": [
            "read_local",
            "execution",
            "destructive_shell"
          ],
          "safer_alternatives": [
            "Use astrix verify without --fix to run tests without applying a repair patch; inspect workspace changes before accepting repairs or initialization."
          ],
          "reference_urls": [
            "https://github.com/vivek5200/astrix",
            "https://github.com/vivek5200/axlang"
          ],
          "required": false,
          "source": "built-in",
          "aliases": [],
          "dependencies": [],
          "conflicts": [],
          "ecosystem_ids": [
            "astrix",
            "axlang"
          ],
          "executables": [
            "astrix",
            "axc"
          ],
          "project_markers": [
            "Astrixfile.ax"
          ],
          "homepage": "https://github.com/vivek5200/astrix",
          "license": "Apache-2.0",
          "icon": {
            "kind": "none"
          },
          "publisher": {
            "id": "community.vivek5200",
            "display_name": "Vivek",
            "url": "https://github.com/vivek5200"
          },
          "permissions": [
            {
              "permission_id": "command.astrix.permission.read-only",
              "implementation_version": "1.0.0",
              "label": "Astrix read-only commands",
              "description": "Recognizes listed inspection commands. `astrix verify` is separately classified as test execution because it may run project code and update the local cache.",
              "risk_tier": "low",
              "baseline_floor": "allow",
              "default_enabled": true,
              "configurable": true,
              "typed_capabilities": [],
              "action_classes": [
                "Astrix read-only inspection command"
              ],
              "dependencies": [],
              "conflicts": [],
              "implied_permissions": [],
              "introduced_version": "1.0.0",
              "deprecated": false,
              "safer_guidance": [
                "Use these exact inspection commands to query policy and dependency impact without requesting workspace repair."
              ],
              "example_command": "astrix graph --diff",
              "family": null,
              "fixed_reason": null,
              "replacement_permission_id": null
            },
            {
              "permission_id": "command.astrix.permission.workspace-write",
              "implementation_version": "1.0.0",
              "label": "Astrix workspace writes",
              "description": "Requires review for Astrix self-healing patches and project initialization, which can modify workspace files.",
              "risk_tier": "high",
              "baseline_floor": "review",
              "default_enabled": true,
              "configurable": true,
              "typed_capabilities": [],
              "action_classes": [
                "Astrix workspace mutation command"
              ],
              "dependencies": [],
              "conflicts": [],
              "implied_permissions": [],
              "introduced_version": "1.0.0",
              "deprecated": false,
              "safer_guidance": [
                "Review the exact command and workspace effects before enabling autonomous execution."
              ],
              "example_command": "astrix verify --fix",
              "family": null,
              "fixed_reason": null,
              "replacement_permission_id": null
            },
            {
              "permission_id": "command.astrix.permission.verify",
              "implementation_version": "1.0.0",
              "label": "Astrix test verification",
              "description": "Runs configured or inferred project tests without requesting automatic patch application. Test commands can execute project code and verification may update Astrix cache data.",
              "risk_tier": "medium",
              "baseline_floor": "review",
              "default_enabled": true,
              "configurable": true,
              "typed_capabilities": [],
              "action_classes": [
                "Astrix test verification command"
              ],
              "dependencies": [],
              "conflicts": [],
              "implied_permissions": [],
              "introduced_version": "1.0.0",
              "deprecated": false,
              "safer_guidance": [
                "Review the inferred test command and its effects; use a constrained sandbox for untrusted test code."
              ],
              "example_command": "astrix verify",
              "family": null,
              "fixed_reason": null,
              "replacement_permission_id": null
            },
            {
              "permission_id": "command.astrix.permission.mcp-server",
              "implementation_version": "1.0.0",
              "label": "Astrix MCP server launch",
              "description": "Reviews starting the local Astrix MCP stdio server, which exposes tools that inspect the workspace and execute impacted tests.",
              "risk_tier": "medium",
              "baseline_floor": "review",
              "default_enabled": true,
              "configurable": true,
              "typed_capabilities": [],
              "action_classes": [
                "Astrix MCP server launch"
              ],
              "dependencies": [],
              "conflicts": [],
              "implied_permissions": [],
              "introduced_version": "1.0.0",
              "deprecated": false,
              "safer_guidance": [
                "Start the MCP server only for an authorized client and review each tool call; astrix_run_impacted_tests executes project tests."
              ],
              "example_command": "astrix mcp serve",
              "family": null,
              "fixed_reason": null,
              "replacement_permission_id": null
            }
          ],
          "rules": [
            {
              "rule_id": "command.astrix.read-only",
