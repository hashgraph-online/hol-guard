            },
            "untrusted": true
          }
        ]
      },
      "safety": {
        "effect": "write",
        "requiredCapabilities": [
          "bounded-output",
          "egress-pinned"
        ],
        "idempotency": "none",
        "scopes": [
          "boards:read",
          "boards:write",
          "users:read"
        ],
        "maxItems": 1,
        "minIntervalMs": 1000,
        "timeoutMs": 15000
