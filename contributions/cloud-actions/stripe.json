        {
          "name": "refunds a whole payment",
          "kind": "safe",
          "arguments": {
            "payment_intent": "pi_3PqA1b2C3d4E5f6G"
          },
          "expect": {
            "facts": {
              "class": "pay",
              "object": {
                "state": "known",
                "value": "payment"
              },
              "scope": {
                "state": "known",
                "value": "single"
              },
              "reversibility": {
                "state": "known",
                "value": "permanent"
              },
              "record_count": {
                "state": "known",
                "value": 1
              }
            },
            "decisions": {
              "balanced": "review",
              "relaxed": "review",
              "strict": "block"
            }
          }
        },
        {
          "name": "refuses a charge id in place of a payment intent",
