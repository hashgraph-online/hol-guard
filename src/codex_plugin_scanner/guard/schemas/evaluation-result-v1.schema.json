{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hol.org/schemas/guard/evaluation-result.v1.json",
  "title": "HOL Guard evaluation result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "resultId",
    "profileId",
    "buildIdentity",
    "artifactIdentity",
    "evidenceIdentity",
    "status",
    "startedAt",
    "finishedAt",
    "cases"
  ],
  "properties": {
    "schemaVersion": {"const": "guard.evaluation-result.v1"},
    "resultId": {"$ref": "#/$defs/id"},
    "profileId": {"$ref": "#/$defs/id"},
    "buildIdentity": {"$ref": "#/$defs/buildIdentity"},
    "artifactIdentity": {"$ref": "#/$defs/artifactIdentity"},
    "evidenceIdentity": {"$ref": "#/$defs/evidenceIdentity"},
    "status": {"$ref": "#/$defs/status"},
    "startedAt": {"type": "string", "minLength": 1, "maxLength": 128},
    "finishedAt": {"type": "string", "minLength": 1, "maxLength": 128},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": {"$ref": "#/$defs/case"}
    },
    "summary": {"$ref": "#/$defs/summary"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "localPath": {
      "type": "string",
      "pattern": "^(?:/(?:tmp|private/tmp|var/tmp|private/var/tmp|var/folders|private/var/folders)(?:/[^\\u0000]*)?|[A-Za-z]:[\\\\/](?:Windows[\\\\/]Temp|Users[\\\\/][^\\\\/]+[\\\\/]AppData[\\\\/]Local[\\\\/]Temp)(?:[\\\\/][^\\u0000]*)?)$"
    },
    "localEndpoint": {
      "type": "string",
      "pattern": "^https?://(?:(?:127(?:\\.[0-9]{1,3}){3})|(?:\\[::1\\]))(?::[0-9]{1,5})?(?:/[^\\s#]*)?$",
      "minLength": 10,
      "maxLength": 2048
    },
    "buildIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "version", "commit", "artifactDigest"],
      "properties": {
        "product": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"$ref": "#/$defs/version"},
        "commit": {"$ref": "#/$defs/commit"},
        "artifactDigest": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "kind", "version", "digest"],
      "properties": {
        "artifactId": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["core", "adapter", "desktop", "profile", "fixture", "other"]},
        "version": {"$ref": "#/$defs/version"},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidenceType": {
      "enum": [
        "source_inspection",
        "unit_test",
        "property_test",
        "synthetic_adapter_test",
        "live_installed_host_test",
        "independent_review",
        "not_run"
      ]
    },
    "evidenceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "proofRunId", "evidenceType", "artifactDigest"],
      "properties": {
        "evidenceId": {"$ref": "#/$defs/id"},
        "proofRunId": {"$ref": "#/$defs/id"},
        "evidenceType": {"$ref": "#/$defs/evidenceType"},
        "artifactDigest": {"$ref": "#/$defs/sha256"}
      }
    },
    "status": {
      "enum": ["passed", "failed", "unsupported", "blocked_environment", "not_run"]
    },
    "action": {
      "enum": [
        "allow",
        "inspect",
        "observe",
        "block",
        "approval",
        "suggest",
        "rewrite",
        "redact-before-forward",
        "inventory",
        "unsupported",
        "not_run"
      ]
    },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["none", "local_file", "local_database", "loopback_receiver"]},
        "path": {
          "anyOf": [{"$ref": "#/$defs/localPath"}, {"type": "null"}]
        },
        "allowedPath": {
          "anyOf": [{"$ref": "#/$defs/localPath"}, {"type": "null"}]
        },
        "endpoint": {
          "anyOf": [{"$ref": "#/$defs/localEndpoint"}, {"type": "null"}]
        },
        "allowedEndpoint": {
          "anyOf": [{"$ref": "#/$defs/localEndpoint"}, {"type": "null"}]
        },
        "receiverReady": {"type": "boolean"},
        "deniedReached": {"type": "boolean"},
        "allowedReached": {"type": "boolean"},
        "digest": {
          "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "note": {"type": ["string", "null"], "maxLength": 512}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "status", "expectedAction", "observedAction", "proofType", "witness"],
      "properties": {
        "caseId": {"$ref": "#/$defs/id"},
        "status": {"$ref": "#/$defs/status"},
        "expectedAction": {"$ref": "#/$defs/action"},
        "observedAction": {
          "anyOf": [
            {"$ref": "#/$defs/action"},
            {"type": "null"}
          ]
        },
        "proofType": {"$ref": "#/$defs/evidenceType"},
        "witness": {"$ref": "#/$defs/witness"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "passed"}}},
          "then": {
            "properties": {
              "proofType": {"not": {"const": "not_run"}},
              "observedAction": {"not": {"type": "null"}}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "not_run"}}},
          "then": {
            "properties": {
              "proofType": {"const": "not_run"},
              "observedAction": {"type": "null"}
            }
          }
        }
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed", "unsupported", "blockedEnvironment", "notRun"],
      "properties": {
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "unsupported": {"type": "integer", "minimum": 0},
        "blockedEnvironment": {"type": "integer", "minimum": 0},
        "notRun": {"type": "integer", "minimum": 0}
      }
    }
  }
}
