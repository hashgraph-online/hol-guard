{
  "schema": "guard.command-extension-fixtures.v1",
  "build": {
    "schema": "guard.command-extension-build.v1",
    "sources": [
      {
        "schema": "guard.command-extension-source.v1",
        "extension": {
          "extension_id": "command.crisp-tui",
          "version": "1.0.0",
          "name": "crisp-tui command protection",
          "description": "Reviews crisp-tui shell commands that change a Crisp support inbox. `crisp-tui ctl draft` writes a reply or internal note into the composer of the running TUI and never sends it. `crisp-tui cli` forwards every remaining argument to crispctl, whose reply, assign, segment, resolve, and reopen commands write immediately. Read-only control commands (ctl state, goto, screen, details, conversations, messages, drafts, read, and refresh) are not matched. ctl state is an inbox snapshot, not a resolve. The Unix-socket control protocol is not a shell command and is outside this extension. Pinned to crisp-tui 0.2.0 (ca38f362ea558cb09a82fbf3ef1aba3e6fb8692c).",
          "icon": {
            "kind": "none"
          },
          "publisher": {
            "id": "community.solcreek",
            "display_name": "SolCreek",
            "url": "https://github.com/solcreek/crisp-tui"
          },
          "homepage": "https://github.com/solcreek/crisp-tui",
          "license": "MIT",
          "action_classes": [
            "crisp-tui composer draft",
            "crisp-tui crispctl passthrough"
          ],
          "risk_classes": [
            "execution",
            "network_egress"
          ],
          "safer_alternatives": [
            "Prepare text with `crisp-tui ctl draft` and let a person send it from the TUI."
          ],
          "reference_urls": [
            "https://github.com/solcreek/crisp-tui",
            "https://www.npmjs.com/package/crisp-tui",
            "https://github.com/solcreek/crisp-cli"
          ],
          "required": false,
          "source": "built-in",
          "aliases": [],
          "dependencies": [],
          "conflicts": [],
          "delegated_protection": null,
          "ecosystem_ids": [],
          "executables": [
            "crisp-tui",
            "crisp-tui.cmd",
            "crisp-tui.exe"
          ],
          "project_markers": [],
          "permissions": [
            {
              "permission_id": "command.crisp-tui.permission.draft",
              "implementation_version": "1.0.0",
              "label": "crisp-tui composer draft",
              "description": "Identifies `crisp-tui ctl draft`, which puts reply or note text into the live composer. The command returns sent:false and does not call Crisp.",
              "risk_tier": "medium",
              "baseline_floor": "review",
              "default_enabled": true,
              "configurable": true,
              "fixed_reason": null,
              "typed_capabilities": [],
              "action_classes": [
                "crisp-tui composer draft"
              ],
              "dependencies": [],
              "conflicts": [],
              "implied_permissions": [],
              "introduced_version": "1.0.0",
              "deprecated": false,
              "replacement_permission_id": null,
              "safer_guidance": [
                "The draft stays in the composer until a person reviews it and presses Enter. crisp-tui does not send an agent draft."
              ],
              "example_command": "crisp-tui ctl draft session_1 \"Let me check that for you.\"",
              "family": null
            },
            {
              "permission_id": "command.crisp-tui.permission.cli",
              "implementation_version": "1.0.0",
              "label": "crisp-tui crispctl passthrough",
              "description": "Identifies `crisp-tui cli`, which forwards the remaining arguments unchanged to crispctl. That bridge can send a customer-visible reply or change conversation state. This rule does not distinguish crispctl's read-only subcommands, so those are reviewed too.",
              "risk_tier": "high",
              "baseline_floor": "review",
              "default_enabled": true,
              "configurable": true,
              "fixed_reason": null,
              "typed_capabilities": [],
              "action_classes": [
                "crisp-tui crispctl passthrough"
              ],
              "dependencies": [],
              "conflicts": [],
              "implied_permissions": [],
              "introduced_version": "1.0.0",
              "deprecated": false,
              "replacement_permission_id": null,
              "safer_guidance": [
                "Prefer `crisp-tui ctl draft`, which only fills the composer. `crisp-tui cli` forwards arguments to crispctl and can write to Crisp immediately."
              ],
              "example_command": "crisp-tui cli reply session_1 --text 'Hello!' --profile sandbox --json",
              "family": null
            }
          ],
          "rules": [
