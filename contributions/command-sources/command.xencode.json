        "permission_id": "command.xencode.permission.plugin",
        "title": "Xencode plugin remove",
        "description": "Identifies Xencode plugin removal operations that delete a local installed plugin.",
        "severity": "high",
        "risk_classes": ["destructive_shell"],
        "action_classes": ["Xencode plugin mutation"],
        "safer_alternatives": ["Review the exact plugin name before removing it."],
        "default_mode": "review",
        "matcher": {"op":"executable.v1","config":{"allow_leading_options":false,"executables":["xencode","xencode.exe"],"fail_secure_unknown_options":true,"forbidden_flags":[],"interspersed_flags":[],"interspersed_options_with_values":[],"inverse_flag_pairs":[],"leading_options_with_values":[],"options_with_values":[],"required_flags":[],"required_flags_in_all_arguments":false,"required_option_values":[],"subcommands":["plugin","remove"]}},
