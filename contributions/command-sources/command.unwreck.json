{
  "schema": "guard.command-extension-source.v1",
  "extension": {
    "action_classes": [
      "Unwreck state and snapshot mutation command",
      "Unwreck agent hook configuration command",
      "Unwreck child process execution command"
    ],
    "aliases": [],
    "conflicts": [],
    "delegated_protection": null,
    "dependencies": [],
    "description": "Reviews Unwreck CLI 0.1.0 invocations that restore or delete project and snapshot state, persist snapshots, change agent hook configuration, or launch child processes. Read-only inspection commands and the installed hook callback are outside this extension's matchers.",
    "ecosystem_ids": [
      "unwreck"
    ],
    "executables": [
      "unwreck",
      "unwreck.exe"
    ],
    "extension_id": "command.unwreck",
    "homepage": "https://github.com/ayushdoesdev/unwreck",
    "icon": {
      "background": "#0F172A",
      "kind": "react-icon",
      "name": "HiMiniCommandLine"
    },
    "license": "MIT OR Apache-2.0",
    "name": "Unwreck command protection",
    "permissions": [
      {
        "action_classes": [
          "Unwreck state and snapshot mutation command"
        ],
        "baseline_floor": "review",
        "configurable": true,
        "conflicts": [],
        "default_enabled": true,
        "dependencies": [],
        "deprecated": false,
        "description": "Reviews Unwreck restore, undo, redo, garbage collection, snapshot, watch, and interactive TUI commands because they can rewrite project files or persist and remove local snapshot history. Restore and undo dry-runs and help requests are safe variants.",
        "example_command": "unwreck restore 42",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "label": "Unwreck state and snapshot changes",
        "permission_id": "command.unwreck.permission.state-change",
        "replacement_permission_id": null,
        "risk_tier": "high",
        "safer_guidance": [
          "Use `restore --dry-run` or `undo --dry-run` to inspect the proposed changes before applying them.",
          "Review the target snapshot and retained history before running `gc`, `restore`, `undo`, or `redo`.",
          "Remember that snapshots can include selected ignored files such as `.env`; keep the local snapshot store protected."
        ],
        "typed_capabilities": []
      },
      {
        "action_classes": [
          "Unwreck agent hook configuration command"
        ],
        "baseline_floor": "review",
        "configurable": true,
        "conflicts": [],
        "default_enabled": true,
        "dependencies": [],
        "deprecated": false,
        "description": "Reviews installation or removal of Unwreck hooks in Claude Code, Codex, and Gemini CLI configuration. The --dry-run form only previews the configuration diff.",
        "example_command": "unwreck hooks --write --agent claude --scope project",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "label": "Unwreck agent hook configuration",
        "permission_id": "command.unwreck.permission.hook-config",
        "replacement_permission_id": null,
        "risk_tier": "high",
        "safer_guidance": [
          "Preview hook installation or removal with `--dry-run` first.",
          "Inspect the agent configuration diff and preserve existing user-defined hooks."
        ],
        "typed_capabilities": []
      },
      {
        "action_classes": [
          "Unwreck child process execution command"
        ],
        "baseline_floor": "review",
        "configurable": true,
        "conflicts": [],
        "default_enabled": true,
        "dependencies": [],
        "deprecated": false,
        "description": "Reviews `unwreck run`, which starts the supplied child process while Unwreck monitors the working tree and snapshots changes.",
        "example_command": "unwreck run --quiet-ms 1500 -- pytest -q",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "label": "Unwreck child process execution",
        "permission_id": "command.unwreck.permission.run",
        "replacement_permission_id": null,
        "risk_tier": "high",
        "safer_guidance": [
          "Inspect the exact child command and its arguments before running it through Unwreck.",
          "Use the agent's normal command review for the underlying process as well; this rule does not replace protections for the child command."
        ],
        "typed_capabilities": []
      }
    ],
    "project_markers": [],
    "publisher": {
      "display_name": "Ayush Anand Srivastava",
