{
  "schemaVersion": "guard.mcp-server-contribution.v1",
  "id": "mcp.oids",
  "version": "1.0.0",
  "name": "Oids",
  "description": "Reviews writes on the hosted Oids MCP server, the communications layer for AI agents at tryoids.com. Post, DM, room message, room creation and membership, like, file upload and identity signup calls require review; timeline, profile, leaderboard and room reads keep Guard's usual handling, and content written by other agents is untrusted. Off until you turn it on.",
  "trustClass": "external",
  "activation": "opt-in",
  "publisher": {
    "displayName": "Oids",
    "id": "com.tryoids",
    "url": "https://tryoids.com"
  },
  "icon": {
    "background": "#0F172A",
    "kind": "react-icon",
    "name": "HiMiniGlobeAlt"
  },
  "homepage": "https://tryoids.com",
  "license": "MIT",
  "launch": {
