{
  "schema": "guard.command-extension-build.v1",
  "base": "packaged",
  "sources": [
    {
      "schema": "guard.command-extension-source.v1",
      "extension": {
        "extension_id": "command.example-cli",
        "version": "1.0.0",
        "name": "Example CLI protection",
        "description": "Synthetic data-only extension for native compiler qualification.",
        "action_classes": [
          "example destructive operation"
        ],
        "risk_classes": [
          "destructive_shell"
        ],
        "safer_alternatives": [
          "Inspect the plan with --dry-run."
        ],
        "reference_urls": [
          "https://example.com/cli"
        ],
        "required": false,
        "source": "built-in",
        "aliases": [],
        "dependencies": [],
        "conflicts": [],
        "ecosystem_ids": [],
        "executables": [
          "example-cli"
        ],
        "project_markers": [],
        "permissions": [
          {
            "permission_id": "command.example-cli.permission.destroy",
            "implementation_version": "1.0.0",
            "label": "Destroy example resource",
            "description": "Reviews a synthetic destructive action.",
            "risk_tier": "high",
            "baseline_floor": "review",
            "default_enabled": true,
            "configurable": true,
            "typed_capabilities": [],
            "action_classes": [
              "example destructive operation"
            ],
            "dependencies": [],
            "conflicts": [],
            "implied_permissions": [],
            "introduced_version": "1.0.0",
            "deprecated": false,
            "safer_guidance": [
              "Inspect the plan with --dry-run."
            ],
            "example_command": "example-cli destroy"
          }
        ],
        "rules": [
          {
            "rule_id": "command.example-cli.destroy",
            "rule_version": "1.0.0",
            "permission_id": "command.example-cli.permission.destroy",
            "title": "Destroy example resource",
            "description": "Matches only the synthetic executable and argument.",
            "severity": "high",
            "risk_classes": [
              "destructive_shell"
            ],
            "action_classes": [
              "example destructive operation"
            ],
            "safer_alternatives": [
              "Inspect the plan with --dry-run."
            ],
            "default_mode": "review",
            "matcher": {
              "op": "arguments.v1",
              "config": {
                "executables": [
                  "example-cli"
                ],
                "required_arguments": [
                  "destroy"
                ]
              }
            },
            "safe_variants": [
              {
                "variant_id": "dry-run",
                "title": "Inspect the plan",
                "matcher": {
                  "op": "arguments.v1",
                  "config": {
                    "executables": [
                      "example-cli"
                    ],
                    "required_arguments": [
                      "--dry-run"
                    ]
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ],
  "mcp_sources": [
    {
      "schemaVersion": "guard.mcp-server-contribution.v1",
      "id": "mcp.example-tasks",
      "version": "1.0.0",
      "name": "Example Tasks MCP",
      "description": "Synthetic remote MCP server for cloud binding examples. The provider and its data are fictional.",
      "trustClass": "external",
      "activation": "opt-in",
      "publisher": {
        "id": "example.com",
        "displayName": "Example Tasks",
        "url": "https://example.com"
      },
      "icon": {
        "kind": "react-icon",
        "name": "HiMiniCloud",
        "background": "#111827"
      },
      "homepage": "https://example.com/tasks",
      "launch": {
        "kind": "remote-http",
        "url": "https://mcp.example.com/mcp",
        "serverNames": [
          "example-tasks"
        ]
      },
      "riskClasses": [
        "external-task-deletion"
      ],
      "tools": [
        {
          "name": "delete_task",
          "state": "review"
        },
        {
          "name": "other",
          "state": "inherit"
        }
      ],
      "referenceUrls": [
        "https://example.com/tasks/mcp"
      ],
      "saferAlternatives": [
        "Archive the task instead of deleting it."
      ]
    }
  ],
  "cloud_bindings": [
    {
      "schemaVersion": "guard.cloud-action-binding-contribution.v1",
      "extensionId": "command.example-cli",
      "bindings": [
        {
          "actionId": "example.resource.destroy",
          "permissionId": "command.example-cli.permission.destroy",
          "effect": "destructive",
          "requiredCapabilities": [],
          "cloudSupport": "portable-policy"
        }
      ]
    },
    {
      "schemaVersion": "guard.cloud-action-binding-contribution.v1",
      "extensionId": "mcp.example-tasks",
      "bindings": [
        {
          "actionId": "example-tasks.task.delete",
          "tool": "delete_task",
          "effect": "destructive",
          "resource": {
            "kind": "task",
            "argument": "task_id"
          },
          "requiredCapabilities": [
            "egress-pinned",
            "bounded-output",
            "resource-allowlist"
          ],
          "cloudSupport": "cloud-executable"
        }
      ]
    }
  ]
}
