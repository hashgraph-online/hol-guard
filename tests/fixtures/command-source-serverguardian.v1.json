            {
              "permission_id": "command.serverguardian.permission.maintenance",
              "implementation_version": "1.0.0",
              "label": "Server Guardian maintenance",
              "description": "Reviews direct daemon starts and manual nightly maintenance, which can update packages and containers.",
              "risk_tier": "high",
              "baseline_floor": "review",
              "default_enabled": true,
              "configurable": true,
              "typed_capabilities": [],
              "action_classes": [
                "Server Guardian maintenance command"
              ],
              "dependencies": [],
              "conflicts": [],
              "implied_permissions": [],
              "introduced_version": "1.0.0",
              "deprecated": false,
              "safer_guidance": [
                "Check daemon status and inspect the scheduled maintenance settings before starting maintenance."
              ],
              "example_command": "server-guardian daemon"
            },
            {
              "permission_id": "command.serverguardian.permission.configure",
              "implementation_version": "1.0.0",
              "label": "Server Guardian configuration",
              "description": "Reviews the interactive setup that saves Server Guardian configuration.",
