{
  "schema": "guard.command-extension-source.v1",
  "extension": {
    "extension_id": "command.xencode",
    "version": "1.0.0",
    "name": "Xencode command protection",
    "description": "Reviews Xencode state-changing CLI operations that can mutate Git worktrees or the local Xencode plugin environment. This community coverage does not certify Xencode or every future CLI feature.",
    "action_classes": ["Xencode worktree mutation", "Xencode plugin mutation"],
    "risk_classes": ["destructive_shell"],
    "safer_alternatives": [
      "Inspect the target worktree and current repository state before changing or removing it.",
      "Review the plugin path or name before installing or removing an Xencode plugin."
    ],
    "reference_urls": [
      "https://github.com/sreevarshan-xenoz/xencode",
      "https://github.com/sreevarshan-xenoz/xencode/blob/main/CLI_GUIDE.md"
    ],
    "required": false,
    "source": "built-in",
    "aliases": [],
    "dependencies": [],
    "conflicts": [],
    "ecosystem_ids": ["xencode"],
    "executables": ["xencode", "xencode.exe"],
    "project_markers": [],
    "permissions": [
      {
        "permission_id": "command.xencode.permission.worktree",
        "implementation_version": "1.0.0",
        "label": "Xencode worktree mutation",
        "description": "Identifies Xencode worktree add and remove operations that change local Git worktree state.",
        "risk_tier": "high",
        "baseline_floor": "review",
        "default_enabled": true,
        "configurable": true,
        "typed_capabilities": [],
        "action_classes": ["Xencode worktree mutation"],
        "dependencies": [],
        "conflicts": [],
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "deprecated": false,
        "safer_guidance": ["Inspect the target worktree and current repository state before changing or removing it."],
        "example_command": "xencode worktree remove"
      },
      {
        "permission_id": "command.xencode.permission.plugin",
        "implementation_version": "1.0.0",
        "label": "Xencode plugin mutation",
        "description": "Identifies Xencode plugin install and remove operations that change the local plugin environment.",
        "risk_tier": "high",
        "baseline_floor": "review",
        "default_enabled": true,
        "configurable": true,
        "typed_capabilities": [],
        "action_classes": ["Xencode plugin mutation"],
        "dependencies": [],
        "conflicts": [],
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "deprecated": false,
        "safer_guidance": ["Review the plugin path or name before installing or removing an Xencode plugin."],
        "example_command": "xencode plugin install"
      }
    ],
    "rules": [
