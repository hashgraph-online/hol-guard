{
  "schema": "guard.command-extension-source.v1",
  "extension": {
    "extension_id": "command.givi",
    "version": "1.0.0",
    "name": "GiviLoop CLI controls",
    "description": "Opt-in review of six direct givi CLI operations affecting automatic review and finding decisions. Does not cover MCP calls, npm/Node wrappers, other submissions or all GiviLoop writes.",
    "icon": {
      "kind": "none"
    },
    "publisher": {
      "id": "community.givi",
      "display_name": "Community"
    },
    "homepage": "https://github.com/vgflutter/GiviLoop",
    "license": "Apache-2.0",
    "action_classes": [
      "givi automatic-review configuration",
      "givi automatic-review execution",
      "givi finding decision write"
    ],
    "risk_classes": [
      "execution"
    ],
    "safer_alternatives": [
      "Inspect givi auto-review status and the selected repository before changing automation or acknowledging a run.",
      "Inspect the selected changed files and configured reviewer; keep the stable task ID and do not bypass a skipped or suspended attempt.",
      "Verify the claim independently and keep the original --run-id; updates must identify the finding with --id in that run."
    ],
    "reference_urls": [
      "https://github.com/vgflutter/GiviLoop/blob/322deef43597e32c60f09aa24df25e7c6cd947a1/src/cli.ts",
      "https://github.com/vgflutter/GiviLoop/blob/322deef43597e32c60f09aa24df25e7c6cd947a1/src/workflow-commands.ts",
      "https://github.com/vgflutter/GiviLoop/blob/322deef43597e32c60f09aa24df25e7c6cd947a1/src/auto-review.ts",
      "https://github.com/vgflutter/GiviLoop/blob/322deef43597e32c60f09aa24df25e7c6cd947a1/src/review-evidence.ts",
      "https://github.com/vgflutter/GiviLoop/blob/322deef43597e32c60f09aa24df25e7c6cd947a1/src/review-report.ts",
      "https://github.com/vgflutter/GiviLoop/blob/322deef43597e32c60f09aa24df25e7c6cd947a1/package.json"
    ],
    "required": false,
    "source": "built-in",
    "aliases": [],
    "dependencies": [],
    "conflicts": [],
    "ecosystem_ids": [],
    "executables": [
      "givi"
    ],
    "project_markers": [],
    "permissions": [
      {
        "permission_id": "command.givi.permission.auto-review-config",
        "implementation_version": "1.0.0",
        "label": "Configure GiviLoop automatic review",
        "description": "Reviews changes to automatic-review policy, managed agent instructions/client configuration, or acknowledgement of a previous attempt.",
        "risk_tier": "medium",
        "baseline_floor": "review",
        "default_enabled": true,
        "configurable": true,
        "typed_capabilities": [],
        "action_classes": [
          "givi automatic-review configuration"
        ],
        "dependencies": [],
        "conflicts": [],
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "deprecated": false,
        "safer_guidance": [
          "Inspect givi auto-review status and the selected repository before changing automation or acknowledging a run."
        ],
        "example_command": "givi auto-review enable"
      },
      {
        "permission_id": "command.givi.permission.auto-review-run",
        "implementation_version": "1.0.0",
        "label": "Run GiviLoop automatic review",
        "description": "Reviews an automatic-review attempt, which may save a new run and send selected code to the configured web or local reviewer.",
        "risk_tier": "medium",
        "baseline_floor": "review",
        "default_enabled": true,
        "configurable": true,
        "typed_capabilities": [],
        "action_classes": [
          "givi automatic-review execution"
        ],
        "dependencies": [],
        "conflicts": [],
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "deprecated": false,
        "safer_guidance": [
          "Inspect the selected changed files and configured reviewer; keep the stable task ID and do not bypass a skipped or suspended attempt."
        ],
        "example_command": "givi auto-review run --task-id task-1 --checks passed"
      },
      {
        "permission_id": "command.givi.permission.findings-write",
        "implementation_version": "1.0.0",
        "label": "Write GiviLoop finding decisions",
        "description": "Reviews adding or updating recorded assessments in an explicitly selected review run. Does not verify or certify their evidence.",
        "risk_tier": "medium",
        "baseline_floor": "review",
        "default_enabled": true,
        "configurable": true,
        "typed_capabilities": [],
        "action_classes": [
          "givi finding decision write"
        ],
        "dependencies": [],
        "conflicts": [],
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "deprecated": false,
        "safer_guidance": [
          "Verify the claim independently and keep the original --run-id; updates must identify the finding with --id in that run."
        ],
        "example_command": "givi findings update --run-id RUN --id F-ID --status unverified"
      }
    ],
    "rules": [
      {
        "rule_id": "command.givi.auto-review-enable",
        "rule_version": "1.0.0",
        "permission_id": "command.givi.permission.auto-review-config",
        "title": "Enable automatic review",
        "description": "Can write .giviloop/auto-review.json, AGENTS.md and supporting configuration; --client codex also installs managed client settings and tool approvals.",
        "severity": "medium",
        "risk_classes": [
          "execution"
        ],
        "action_classes": [
          "givi automatic-review configuration"
        ],
        "safer_alternatives": [
          "Inspect givi auto-review status and the selected repository before changing automation or acknowledging a run."
        ],
        "default_mode": "review",
        "matcher": {
          "op": "leading-subcommand.v1",
          "config": {
            "executables": [
              "givi"
            ],
            "subcommands": [
              "auto-review",
              "enable"
            ],
            "options_with_values": [
              "--repo",
              "--task-id",
              "--checks",
              "--file",
              "--run-id",
              "--client",
              "--repositoryPath",
              "-f"
            ],
            "forbidden_flags": [
              "--repo",
              "--task-id",
              "--checks",
              "--file",
              "--run-id",
              "--client",
              "--version",
              "--help",
              "-h",
              "--json",
              "--repositoryPath",
              "-f"
            ],
            "interleaved_options_with_values": [
              "--repo",
              "--task-id",
              "--checks",
              "--file",
              "--run-id",
              "--client",
              "--repositoryPath",
              "-f"
            ]
          }
        },
        "safe_variants": [
          {
            "variant_id": "help",
            "title": "GiviLoop command help",
            "matcher": {
              "op": "executable.v1",
              "config": {
                "executables": [
                  "givi"
                ],
                "subcommands": [
                  "auto-review",
                  "enable"
                ],
                "allow_leading_options": false,
                "interspersed_options_with_values": [
                  "--repo",
                  "--task-id",
                  "--checks",
                  "--file",
                  "--run-id",
                  "--client",
                  "--repositoryPath",
                  "-f"
                ],
                "interspersed_flags": [
                  "--help",
