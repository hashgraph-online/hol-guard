{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "adapter_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "adapter_kind": {
      "enum": [
        "harness",
        "product",
        "service",
        "oracle",
        "observer"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      },
      "maxItems": 256,
      "uniqueItems": true
    },
    "unsupported_surfaces": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      },
      "maxItems": 256,
      "uniqueItems": true
    },
    "protocol_versions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      },
      "maxItems": 256,
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      },
      "maxItems": 256,
      "uniqueItems": true
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      },
      "maxItems": 256,
      "uniqueItems": true
    },
    "qualification_supported": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "adapter_id",
    "adapter_kind",
    "version",
    "surfaces",
    "unsupported_surfaces",
    "protocol_versions",
    "evidence",
    "platforms",
    "qualification_supported"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hol-guard.example/benchmark/capabilities.v1.json"
}
