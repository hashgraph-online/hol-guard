        "family": null,
        "default_mode": "review",
        "matcher": {
          "op": "any.v1",
          "config": {},
          "matchers": [
            {
              "op": "executable.v1",
              "config": {
                "allow_leading_options": false,
                "executables": [
                  "crisp-tui",
                  "crisp-tui.cmd",
                  "crisp-tui.exe"
                ],
                "fail_secure_unknown_options": true,
                "forbidden_flags": [],
                "interspersed_flags": [
                  "--demo",
                  "--help",
                  "--note",
                  "--read-only",
                  "--replace",
                  "-h"
                ],
                "interspersed_options_with_values": [
                  "--config",
                  "--limit",
                  "--offset",
                  "--poll",
                  "--profile",
                  "--revision",
                  "--website"
