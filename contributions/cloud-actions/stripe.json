        "effect": "write",
        "requiredCapabilities": [
          "bounded-output",
          "egress-pinned"
        ],
        "idempotency": "none",
        "scopes": [
          "read_write"
        ],
        "maxItems": 1,
        "minIntervalMs": 1000,
        "timeoutMs": 10000
      },
      "fixtures": [
        {
          "name": "refunds part of a payment",
          "kind": "safe",
          "arguments": {
            "payment_intent": "pi_3PqA1b2C3d4E5f6G",
            "amount": 2500,
            "reason": "requested_by_customer"
          },
          "expect": {
            "facts": {
              "class": "pay",
              "object": {
                "state": "known",
                "value": "payment"
              },
              "scope": {
                "state": "known",
                "value": "single"
              },
              "reversibility": {
                "state": "known",
