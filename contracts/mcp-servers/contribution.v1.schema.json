{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hol.org/schemas/guard/mcp-server-contribution.v1.json",
  "title": "HOL Guard MCP server contribution v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "description",
    "trustClass",
    "activation",
    "publisher",
    "icon",
    "launch",
    "riskClasses",
    "tools",
    "saferAlternatives"
  ],
  "properties": {
    "schemaVersion": { "const": "guard.mcp-server-contribution.v1" },
    "id": {
      "type": "string",
      "pattern": "^mcp\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 256
    },
    "version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$",
      "maxLength": 32
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "description": { "type": "string", "minLength": 1, "maxLength": 512 },
    "trustClass": { "const": "external" },
    "activation": { "const": "opt-in" },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 128 },
        "url": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "icon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["react-icon", "none"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "background": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      }
    },
    "homepage": { "type": "string", "minLength": 1, "maxLength": 512 },
    "license": { "type": "string", "minLength": 1, "maxLength": 64 },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "command", "package"],
      "properties": {
        "kind": { "const": "package-launcher" },
        "command": { "enum": ["npx", "uvx", "bunx", "pnpm", "npm", "yarn", "pipx"] },
        "package": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "riskClasses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "state"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 128 },
          "state": { "enum": ["inherit", "allow", "block"] }
        }
      }
    },
    "referenceUrls": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "saferAlternatives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    }
  }
}
