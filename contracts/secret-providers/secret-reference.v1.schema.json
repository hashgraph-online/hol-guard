{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hol.org/schemas/secret-reference.v1.json",
  "title": "Guard secret reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "provider", "scope", "name"],
  "properties": {
    "schema": { "const": "guard.secret-reference.v1" },
    "provider": {
      "type": "string",
      "pattern": "^(native|provider\\.[a-z][a-z0-9._-]{0,62})$",
      "maxLength": 72
    },
    "scope": { "$ref": "#/$defs/segment" },
    "name": { "$ref": "#/$defs/segment" },
    "field": { "$ref": "#/$defs/segment" },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
      "maxLength": 63
    }
  },
  "$defs": {
    "segment": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$",
      "maxLength": 63
    }
  }
}
