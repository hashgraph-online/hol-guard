  "cases": [
    {
      "id": "search-requires-review",
      "command": "bun run .agents/skills/rozee-search/cli/src/cli.ts search --query \"data analyst\" --location Lahore",
      "enabled_extensions": [
        "command.rozee"
      ],
      "disabled_permissions": [],
      "expected_action": "review",
      "rule_id": "command.rozee.public-listing-request",
      "expected_effective_segments": [
        0
      ]
    },
    {
      "id": "detail-fetch-requires-review",
      "command": "bun run .agents/skills/rozee-search/cli/src/cli.ts detail sample-role-lahore-jobs-123456",
      "enabled_extensions": [
        "command.rozee"
      ],
      "disabled_permissions": [],
      "expected_action": "review",
      "rule_id": "command.rozee.public-listing-request",
      "expected_effective_segments": [
        0
      ]
    },
    {
      "id": "help-is-local",
      "command": "bun run .agents/skills/rozee-search/cli/src/cli.ts search --help",
      "enabled_extensions": [
        "command.rozee"
      ],
      "disabled_permissions": [],
      "expected_action": "review",
      "rule_id": "command.rozee.public-listing-request",
      "expected_effective_segments": []
    },
    {
      "id": "short-help-is-local",
      "command": "bun run .agents/skills/rozee-search/cli/src/cli.ts detail -h",
      "enabled_extensions": [
        "command.rozee"
      ],
      "disabled_permissions": [],
      "expected_action": "review",
      "rule_id": "command.rozee.public-listing-request",
      "expected_effective_segments": []
    },
    {
      "id": "unrelated-command-is-unchanged",
      "command": "python --version",
      "enabled_extensions": [
        "command.rozee"
      ],
      "disabled_permissions": [],
      "expected_action": "allow",
      "rule_id": "command.rozee.public-listing-request",
      "expected_effective_segments": []
    },
    {
      "id": "compound-command-reviews-only-network-segment",
      "command": "bun run .agents/skills/rozee-search/cli/src/cli.ts search --help; bun run .agents/skills/rozee-search/cli/src/cli.ts detail sample-role-lahore-jobs-123456",
      "enabled_extensions": [
        "command.rozee"
      ],
      "disabled_permissions": [],
      "expected_action": "review",
      "rule_id": "command.rozee.public-listing-request",
      "expected_effective_segments": [
        1
      ]
    },
