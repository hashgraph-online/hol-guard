          }
        },
        "safe_variants": [
          {
            "variant_id": "opencomms-check",
            "title": "Check update availability without replacement",
            "matcher": {
              "op": "reviewed-literal.v1",
              "config": {
                "executable": "opencomms",
                "arguments": [
                  "update",
                  "--check"
                ]
              }
            }
          },
          {
            "variant_id": "opencomms-check-json",
            "title": "Check update availability without replacement",
            "matcher": {
