    { "name": "validate_address", "state": "allow" },
    { "name": "xaddress", "state": "allow" },
    { "name": "currency_code", "state": "allow" },
    { "name": "decode_result", "state": "allow" },
    { "name": "ripple_time", "state": "allow" },
    { "name": "decode_xpop", "state": "allow" },
    { "name": "inspect_emitted_tx", "state": "allow" },
    { "name": "decode_lease_uri", "state": "allow" },
    { "name": "decode_amount", "state": "allow" },
    { "name": "decode_sign_request", "state": "allow" },
    { "name": "scam_check", "state": "allow" },
    { "name": "inspect_hook_wasm", "state": "allow" },
    { "name": "analyze_hook", "state": "allow" },
    { "name": "list_rules", "state": "allow" },
    { "name": "hook_dry_run", "state": "allow" },
    { "name": "annotate_hook_trace", "state": "allow" },
    { "name": "fuzz_hook", "state": "allow" },
    { "name": "estimate_hook_fee", "state": "allow" },
    { "name": "hook_report", "state": "allow" },
    { "name": "classify_hook", "state": "allow" },
    { "name": "hook_diff", "state": "allow" },
    { "name": "hook_api_lookup", "state": "allow" },
    { "name": "decode_b2m", "state": "allow" },
    { "name": "vm_fidelity_report", "state": "allow" },
    { "name": "build_sethook_unsigned", "state": "review" },
