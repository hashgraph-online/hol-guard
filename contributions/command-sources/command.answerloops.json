        "permission_id": "command.answerloops.permission.setup",
        "replacement_permission_id": null,
        "risk_tier": "medium",
        "safer_guidance": [
          "Confirm the target directory and that starting Docker containers on this machine is intended before running setup.",
          "Run `answerloops --help` to review what setup will do first."
        ],
        "typed_capabilities": []
      },
