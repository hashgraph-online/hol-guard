              "config": {
                "executable": "opencomms.cmd",
                "arguments": [
                  "update",
                  "--check",
                  "--json"
                ]
              }
            }
          },
          {
            "variant_id": "opencomms.cmd-json-check",
            "title": "Check update availability without replacement",
            "matcher": {
