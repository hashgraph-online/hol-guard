{
  "schemaVersion": "guard.mcp-server-contribution.v1",
  "id": "mcp.xahau-mcp",
  "version": "1.0.0",
  "name": "Xahau MCP",
  "description": "Reviews Xahau MCP tools that read public Xahau JSON-RPC endpoints or emit unsigned transactions and Hook source a user could sign or deploy. Offline codec, Hook WASM analysis, and local VM tools are allowed. The server never signs, submits, or holds keys. Off until you turn it on.",
  "trustClass": "external",
  "activation": "opt-in",
  "publisher": {
    "id": "io.github.hugegreencandle",
    "displayName": "Hugegreencandle (Kairo Vault Technologies G.K.)",
    "url": "https://github.com/Hugegreencandle"
  },
  "icon": { "kind": "react-icon", "name": "HiMiniCube", "background": "#0F172A" },
  "homepage": "https://github.com/Hugegreencandle/xahau-mcp#readme",
  "license": "MIT",
  "launch": {
    "kind": "package-launcher",
    "command": "npx",
    "package": "xahau-mcp"
  },
  "riskClasses": [
    "external-network-read",
    "unsigned-transaction-construction",
    "generated-source-code"
  ],
  "tools": [
