{
  "schemaVersion": "guard.browser-driver.v1",
  "id": "browser.playwright-mcp",
  "name": "Playwright MCP",
  "publisher": {
    "name": "HOL Guard",
    "url": "https://github.com/hashgraph-online/hol-guard",
    "verified": true
  },
  "referenceUrls": [
    "https://github.com/microsoft/playwright-mcp"
  ],
  "match": {
    "mcpServerNames": [
      "playwright"
    ],
    "packages": [
      "@playwright/mcp"
    ],
    "toolNamespaces": [
      "mcp__playwright__"
    ],
    "harnessTools": []
  },
  "profileMode": {
    "default": "unknown",
    "flags": {
      "isolated": [
        "--isolated",
        "--isolated-context"
      ],
      "dedicated": [
        "--user-data-dir",
        "--persistent",
        "--profile-dir",
        "--storage-state"
      ],
      "shared": [
        "--shared",
        "--no-isolated"
      ],
      "remoteDebugging": [
        "--remote-debugging-port",
        "--remote-debugging-pipe",
        "--ws-endpoint"
      ]
    }
  },
  "tools": [
