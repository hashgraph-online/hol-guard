{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hol.org/schemas/guard/extension-pack.v1.json",
  "title": "HOL Guard extension pack",
  "description": "A proposed grouping over existing catalog extensions and permissions. A pack carries no policy, activation, trust class or grant.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packId",
    "status",
    "title",
    "summary",
    "extensions",
    "operationFamilies",
    "notCovered",
    "setupRecipes",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {"const": "guard.extension-pack.v1"},
    "packId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$", "maxLength": 96},
    "status": {"const": "proposed"},
    "title": {"$ref": "#/$defs/text"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 400},
    "extensions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["extensionId", "version"],
        "properties": {
          "extensionId": {"$ref": "#/$defs/identifier"},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32}
        }
      }
    },
    "operationFamilies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["familyId", "title", "permissionIds", "roleSuggestions"],
        "properties": {
          "familyId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 64},
          "title": {"$ref": "#/$defs/text"},
          "permissionIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/identifier"}
          },
          "roleSuggestions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["personal", "managed-team"],
            "properties": {
              "personal": {"$ref": "#/$defs/suggestion"},
              "managed-team": {"$ref": "#/$defs/suggestion"}
            }
          }
        }
      }
    },
    "notCovered": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "reason"],
        "properties": {
          "title": {"$ref": "#/$defs/text"},
          "reason": {"type": "string", "minLength": 1, "maxLength": 400}
        }
      }
    },
    "setupRecipes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recipeId", "title", "extensionIds", "documentationPath"],
        "properties": {
          "recipeId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 64},
          "title": {"$ref": "#/$defs/text"},
          "extensionIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/identifier"}
          },
          "documentationPath": {"type": "string", "pattern": "^docs/guard/[A-Za-z0-9._/-]+\\.md$", "maxLength": 200}
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 400}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$", "maxLength": 160},
    "text": {"type": "string", "minLength": 1, "maxLength": 140},
    "suggestion": {"enum": ["review", "require-reapproval", "block"]}
  }
}
