    "delegated_protection": null,
    "dependencies": [],
    "description": "Reviews netdoctor, a network health-check CLI that writes nothing locally. Every run sends DNS queries, an ICMP ping, a TCP connect, HTTP GET requests, and usually a traceroute to hosts and paths taken from its arguments, so the arguments can carry data out. Live --watch and --mtr monitors repeat those probes until interrupted and are reviewed separately.",
    "ecosystem_ids": [
      "netdoctor"
    ],
    "executables": [
      "netdoctor"
    ],
    "extension_id": "command.netdoctor",
    "homepage": "https://github.com/Sahilll15/netdoctor",
    "icon": {
      "background": "#0F766E",
      "kind": "react-icon",
      "name": "HiMiniGlobeAlt"
    },
    "license": "MIT",
    "name": "netdoctor network diagnostics",
    "permissions": [
      {
        "action_classes": [
          "netdoctor network diagnosis"
        ],
        "baseline_floor": "review",
        "configurable": true,
        "conflicts": [],
        "default_enabled": true,
        "dependencies": [],
        "deprecated": false,
        "description": "netdoctor runs against the named targets. It resolves each host name, pings it once, opens a TCP connection, sends HTTP GET requests for the target path (5 by default), and runs a traceroute. Host names and URL paths come from the arguments and leave the machine in DNS queries and request lines. Nothing is written to disk.",
        "example_command": "netdoctor github.com --json",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "label": "netdoctor network check",
        "permission_id": "command.netdoctor.permission.diagnose",
        "replacement_permission_id": null,
        "risk_tier": "medium",
        "safer_guidance": [
          "Check that every target host, URL, and --path value is one you mean to contact and carries no secrets, since netdoctor sends them out in DNS queries and HTTP requests."
        ],
        "typed_capabilities": []
      },
      {
        "action_classes": [
          "netdoctor continuous monitor"
        ],
        "baseline_floor": "review",
        "configurable": true,
        "conflicts": [],
        "default_enabled": true,
        "dependencies": [],
        "deprecated": false,
        "description": "netdoctor --watch and --mtr re-run DNS, TCP, HTTP, or traceroute probes against the targets on an interval and keep running until interrupted unless --max-runs is set.",
        "example_command": "netdoctor github.com --watch",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "label": "netdoctor live monitor",
        "permission_id": "command.netdoctor.permission.continuous-monitor",
        "replacement_permission_id": null,
        "risk_tier": "medium",
        "safer_guidance": [
          "Run a one-shot check (netdoctor <host>) or pass --json, which runs the ladder once even with --watch or --mtr.",
          "If a live monitor is needed, add --max-runs N so it stops on its own instead of probing until interrupted."
        ],
        "typed_capabilities": []
      }
    ],
