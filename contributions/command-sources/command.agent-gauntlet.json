      {
        "action_classes": [
          "Agent Gauntlet forced journey init"
        ],
        "baseline_floor": "review",
        "configurable": true,
        "conflicts": [],
        "default_enabled": true,
        "dependencies": [],
        "deprecated": false,
        "description": "Identifies `agent-gauntlet init --force`, which overwrites an existing starter journey file at the target path. exec and xargs launches are blocked by Guard's wrapper floor.",
        "example_command": "agent-gauntlet init --preset woocommerce --base-url https://shop.example --out journey.yml --force",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "label": "Agent Gauntlet forced journey init",
        "permission_id": "command.agent-gauntlet.permission.init-force",
        "replacement_permission_id": null,
        "risk_tier": "medium",
        "safer_guidance": [
          "Run `agent-gauntlet init` without `--force` first; it does not overwrite an existing file.",
          "Write the starter journey to a new path with `--out`, or review the existing file before overwriting it."
        ],
        "typed_capabilities": []
      },
      {
        "action_classes": [
          "Agent Gauntlet permission-asserted run"
        ],
        "baseline_floor": "review",
        "configurable": true,
        "conflicts": [],
        "default_enabled": true,
        "dependencies": [],
        "deprecated": false,
        "description": "Identifies `agent-gauntlet run <journey> --i-have-permission`, which asserts permission to test a non-local site and drives a local Chromium browser through the journey's checkout steps against it, writing result.json, report.html and screenshots to a local output folder. The tool documents that it stops before payment and never places an order; Guard does not verify site ownership or permission. exec and xargs launches are blocked by Guard's wrapper floor.",
        "example_command": "agent-gauntlet run journey.yml --i-have-permission --out gauntlet-out",
        "family": null,
        "fixed_reason": null,
        "implementation_version": "1.0.0",
        "implied_permissions": [],
        "introduced_version": "1.0.0",
        "label": "Agent Gauntlet permission-asserted run",
        "permission_id": "command.agent-gauntlet.permission.permission-run",
        "replacement_permission_id": null,
        "risk_tier": "medium",
        "safer_guidance": [
          "Run `agent-gauntlet demo` first; it only audits built-in fake shops on localhost.",
          "Confirm you own the site or hold written permission before passing `--i-have-permission`, and review the journey file's steps and base URL."
        ],
        "typed_capabilities": []
      }
