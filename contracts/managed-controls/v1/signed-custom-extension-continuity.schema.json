{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guard.signed-custom-extension-continuity.v2",
  "title": "Signed custom Extension continuity projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "observedAt", "expiresAt", "items"],
  "properties": {
    "schemaVersion": { "const": "guard.custom-extension-continuity.v2" },
    "revision": { "type": "integer", "minimum": 1 },
    "observedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identityHash", "deviceIdentityHashes", "state"],
        "properties": {
          "identityHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "deviceIdentityHashes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          },
          "state": { "enum": ["allowed", "blocked", "removed"] }
        }
      }
    }
  }
}
