{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "campaign_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "role": {
            "enum": [
              "campaign",
              "episode",
              "events",
              "snapshot",
              "scorecard",
              "source",
              "receipt"
            ]
          }
        },
        "required": [
          "path",
          "digest",
          "bytes",
          "role"
        ],
        "additionalProperties": false
      },
      "maxItems": 100000
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "verifier_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "custodian_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "maxItems": 100000,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "campaign_id",
    "campaign_digest",
    "files",
    "source_digest",
    "verifier_digest",
    "custodian_digest",
    "attempt_ids"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hol-guard.example/benchmark/manifest.v1.json"
}
